[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.8088798935596759, "needs_review": false}, {"bbox": [[161.0, 223.0], [230.0, 223.0], [230.0, 247.0], [161.0, 247.0]], "text": "A.6.6", "confidence": 0.8256893157958984, "needs_review": false}, {"bbox": [[236.0, 223.0], [363.0, 223.0], [363.0, 246.0], [236.0, 246.0]], "text": "句子的类型", "confidence": 0.7617686291535696, "needs_review": false}, {"bbox": [[159.0, 283.0], [360.0, 281.0], [361.0, 308.0], [159.0, 310.0]], "text": "A.6.6.1特殊句型", "confidence": 0.8381373633941015, "needs_review": false}, {"bbox": [[162.0, 346.0], [483.0, 346.0], [483.0, 369.0], [162.0, 369.0]], "text": "【六40】“把”字句4：表致使", "confidence": 0.8456411734223366, "needs_review": false}, {"bbox": [[206.0, 385.0], [756.0, 385.0], [756.0, 408.0], [206.0, 408.0]], "text": "（1）主语（非生物体）+把+宾语+动词+其他成分", "confidence": 0.8887713861465454, "needs_review": false}, {"bbox": [[254.0, 424.0], [458.0, 424.0], [458.0, 447.0], [254.0, 447.0]], "text": "这双鞋把脚磨破了。", "confidence": 0.8824872016906739, "needs_review": false}, {"bbox": [[257.0, 462.0], [507.0, 462.0], [507.0, 485.0], [257.0, 485.0]], "text": "外面的声音把我吵醒了。", "confidence": 0.8097194681564966, "needs_review": false}, {"bbox": [[207.0, 501.0], [708.0, 501.0], [708.0, 524.0], [207.0, 524.0]], "text": "（2）主语+把+宾语（施事）+动词+其他成分", "confidence": 0.8906732434811799, "needs_review": false}, {"bbox": [[258.0, 540.0], [507.0, 540.0], [507.0, 563.0], [258.0, 563.0]], "text": "他把大伙儿笑得肚子疼。", "confidence": 0.8591225941975912, "needs_review": false}, {"bbox": [[258.0, 579.0], [507.0, 579.0], [507.0, 601.0], [258.0, 601.0]], "text": "他把爸爸气得一夜没睡。", "confidence": 0.9112197905778885, "needs_review": false}, {"bbox": [[254.0, 615.0], [580.0, 614.0], [580.0, 640.0], [254.0, 641.0]], "text": "孩子把妈妈感动得流下了眼泪。", "confidence": 0.87403351465861, "needs_review": false}, {"bbox": [[162.0, 676.0], [877.0, 676.0], [877.0, 699.0], [162.0, 699.0]], "text": "【六41】被动句4：主语+被／叫／让+宾语+给+动词+其他成分", "confidence": 0.9028344638645649, "needs_review": false}, {"bbox": [[257.0, 714.0], [528.0, 714.0], [528.0, 737.0], [257.0, 737.0]], "text": "杯子被她不小心给摔碎了。", "confidence": 0.8809072283598093, "needs_review": false}, {"bbox": [[259.0, 753.0], [529.0, 753.0], [529.0, 776.0], [259.0, 776.0]], "text": "自行车叫小偷儿给偷走了。", "confidence": 0.8845697091175959, "needs_review": false}, {"bbox": [[256.0, 792.0], [529.0, 792.0], [529.0, 815.0], [256.0, 815.0]], "text": "这件事差点儿让我给忘了。", "confidence": 0.8739723654893728, "needs_review": false}, {"bbox": [[159.0, 847.0], [315.0, 850.0], [314.0, 880.0], [158.0, 878.0]], "text": "A.6.6.2复句", "confidence": 0.8081637918949127, "needs_review": false}, {"bbox": [[160.0, 913.0], [379.0, 913.0], [379.0, 939.0], [160.0, 939.0]], "text": "A.6.6.2.1并列复句", "confidence": 0.8883659967354366, "needs_review": false}, {"bbox": [[160.0, 974.0], [469.0, 974.0], [469.0, 1000.0], [160.0, 1000.0]], "text": "【六42】时而，时而··", "confidence": 0.8268978962531457, "needs_review": false}, {"bbox": [[254.0, 1012.0], [726.0, 1014.0], [726.0, 1041.0], [254.0, 1039.0]], "text": "这儿的天气变来变去，时而晴天，时而下雨。", "confidence": 0.9235304225058782, "needs_review": false}, {"bbox": [[256.0, 1052.0], [796.0, 1052.0], [796.0, 1078.0], [256.0, 1078.0]], "text": "生活就是这样，时而让人失望，时而让人充满信心。", "confidence": 0.9127732540170351, "needs_review": false}, {"bbox": [[256.0, 1091.0], [701.0, 1093.0], [701.0, 1116.0], [256.0, 1114.0]], "text": "她的情绪很不稳定，时而积极，时而消极。", "confidence": 0.8956412523984909, "needs_review": false}, {"bbox": [[161.0, 1149.0], [450.0, 1149.0], [450.0, 1175.0], [161.0, 1175.0]], "text": "【六43】一时···一时··", "confidence": 0.6221203625202179, "needs_review": false}, {"bbox": [[255.0, 1187.0], [601.0, 1187.0], [601.0, 1213.0], [255.0, 1213.0]], "text": "年纪太大了，身体一时好一时坏。", "confidence": 0.9046487621963024, "needs_review": false}, {"bbox": [[254.0, 1225.0], [627.0, 1227.0], [627.0, 1253.0], [254.0, 1252.0]], "text": "这家公司的产量一时上升一时下降。", "confidence": 0.8731614877195919, "needs_review": false}, {"bbox": [[257.0, 1266.0], [651.0, 1266.0], [651.0, 1289.0], [257.0, 1289.0]], "text": "他的情绪有波动，一时高兴一时悲伤。", "confidence": 0.8985729648007287, "needs_review": false}, {"bbox": [[159.0, 1327.0], [380.0, 1325.0], [380.0, 1351.0], [159.0, 1354.0]], "text": "A.6.6.2.2承接复句", "confidence": 0.8877545850617545, "needs_review": false}, {"bbox": [[161.0, 1389.0], [372.0, 1389.0], [372.0, 1412.0], [161.0, 1412.0]], "text": "【六44·.··便··", "confidence": 0.5861653089523315, "needs_review": false}, {"bbox": [[256.0, 1428.0], [602.0, 1428.0], [602.0, 1451.0], [256.0, 1451.0]], "text": "我一走出校门，抬头便看见了她。", "confidence": 0.8766875974833965, "needs_review": false}, {"bbox": [[257.0, 1467.0], [629.0, 1467.0], [629.0, 1489.0], [257.0, 1489.0]], "text": "她放下电话，衣服没换便往医院赶。", "confidence": 0.8395702242851257, "needs_review": false}, {"bbox": [[256.0, 1503.0], [651.0, 1504.0], [651.0, 1528.0], [256.0, 1527.0]], "text": "一回到家，他便看到了桌子上的饭菜。", "confidence": 0.870950268374549, "needs_review": false}, {"bbox": [[160.0, 1565.0], [380.0, 1563.0], [380.0, 1590.0], [160.0, 1592.0]], "text": "A.6.6.2.3递进复句", "confidence": 0.8347593205315726, "needs_review": false}, {"bbox": [[160.0, 1626.0], [609.0, 1627.0], [609.0, 1651.0], [160.0, 1650.0]], "text": "【六45】不但不／不但没有·，反而·…·", "confidence": 0.7810116268339611, "needs_review": false}, {"bbox": [[257.0, 1668.0], [624.0, 1668.0], [624.0, 1688.0], [257.0, 1688.0]], "text": "他不但不帮我，反而还给我添麻烦。", "confidence": 0.9144370801308576, "needs_review": false}, {"bbox": [[257.0, 1706.0], [748.0, 1706.0], [748.0, 1729.0], [257.0, 1729.0]], "text": "夏天过去了，天气不但没有凉快，反而更热了。", "confidence": 0.8834669698368419, "needs_review": false}, {"bbox": [[258.0, 1743.0], [698.0, 1743.0], [698.0, 1766.0], [258.0, 1766.0]], "text": "他不但没有鼓励我，反而还批评了我一顿。", "confidence": 0.9388232588768005, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1179.0, 1809.0]], "text": "233", "confidence": 0.7453252822160721, "needs_review": false}]