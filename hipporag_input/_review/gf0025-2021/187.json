[{"bbox": [[1069.0, 167.0], [1237.0, 167.0], [1237.0, 187.0], [1069.0, 187.0]], "text": "GF0025—2021", "confidence": 0.8634734476606051, "needs_review": false}, {"bbox": [[256.0, 224.0], [434.0, 224.0], [434.0, 247.0], [256.0, 247.0]], "text": "这个教室好大啊！", "confidence": 0.872947977648841, "needs_review": false}, {"bbox": [[257.0, 265.0], [483.0, 265.0], [483.0, 288.0], [257.0, 288.0]], "text": "他很高，他弟弟更高。", "confidence": 0.8484667377038435, "needs_review": false}, {"bbox": [[254.0, 306.0], [435.0, 304.0], [435.0, 327.0], [254.0, 330.0]], "text": "这包子十分好吃。", "confidence": 0.8160612516933017, "needs_review": false}, {"bbox": [[256.0, 346.0], [507.0, 346.0], [507.0, 369.0], [256.0, 369.0]], "text": "王老师的儿子特别可爱。", "confidence": 0.8685025672117869, "needs_review": false}, {"bbox": [[255.0, 387.0], [411.0, 387.0], [411.0, 411.0], [255.0, 411.0]], "text": "那儿挺安静的。", "confidence": 0.8377545028924942, "needs_review": false}, {"bbox": [[257.0, 428.0], [531.0, 428.0], [531.0, 451.0], [257.0, 451.0]], "text": "今天天气有（一）点儿热。", "confidence": 0.8685983144319974, "needs_review": false}, {"bbox": [[162.0, 487.0], [593.0, 488.0], [593.0, 512.0], [162.0, 511.0]], "text": "【二14】范围、协同副词：全、一共、只", "confidence": 0.9449087500572204, "needs_review": false}, {"bbox": [[258.0, 530.0], [412.0, 530.0], [412.0, 553.0], [258.0, 553.0]], "text": "同学们全来了。", "confidence": 0.8679434657096863, "needs_review": false}, {"bbox": [[257.0, 571.0], [481.0, 571.0], [481.0, 593.0], [257.0, 593.0]], "text": "我们班一共有二十人。", "confidence": 0.7536004456606779, "needs_review": false}, {"bbox": [[256.0, 611.0], [460.0, 611.0], [460.0, 634.0], [256.0, 634.0]], "text": "卡里只有二百块钱。", "confidence": 0.8438149333000183, "needs_review": false}, {"bbox": [[160.0, 670.0], [754.0, 671.0], [754.0, 697.0], [160.0, 696.0]], "text": "【二15】时间副词：刚、刚刚、还²、忽然、一直、已经", "confidence": 0.9004295843618887, "needs_review": false}, {"bbox": [[257.0, 713.0], [458.0, 713.0], [458.0, 736.0], [257.0, 736.0]], "text": "我刚从学校回到家。", "confidence": 0.8945694386959075, "needs_review": false}, {"bbox": [[257.0, 754.0], [508.0, 754.0], [508.0, 777.0], [257.0, 777.0]], "text": "白老师刚刚从国外回来。", "confidence": 0.9039808710416158, "needs_review": false}, {"bbox": [[256.0, 794.0], [434.0, 796.0], [434.0, 820.0], [256.0, 818.0]], "text": "外边还在下雨呢。", "confidence": 0.8656299312909445, "needs_review": false}, {"bbox": [[254.0, 833.0], [483.0, 836.0], [483.0, 861.0], [254.0, 859.0]], "text": "街上的灯忽然都亮了。", "confidence": 0.8645551150495355, "needs_review": false}, {"bbox": [[256.0, 876.0], [410.0, 876.0], [410.0, 900.0], [256.0, 900.0]], "text": "她一直在说话。", "confidence": 0.850673258304596, "needs_review": false}, {"bbox": [[257.0, 918.0], [434.0, 918.0], [434.0, 941.0], [257.0, 941.0]], "text": "校长已经下班了。", "confidence": 0.8520603444841173, "needs_review": false}, {"bbox": [[160.0, 974.0], [736.0, 978.0], [736.0, 1005.0], [160.0, 1001.0]], "text": "【二16】频率、重复副词：重新、经常、老、老是、又", "confidence": 0.9287243645924789, "needs_review": false}, {"bbox": [[255.0, 1020.0], [532.0, 1020.0], [532.0, 1043.0], [255.0, 1043.0]], "text": "这篇作文我要重新写一遍。", "confidence": 0.8725759066068209, "needs_review": false}, {"bbox": [[255.0, 1060.0], [543.0, 1056.0], [544.0, 1082.0], [255.0, 1087.0]], "text": "我经常看见他在图书馆学习", "confidence": 0.8254433916165278, "needs_review": false}, {"bbox": [[255.0, 1101.0], [579.0, 1101.0], [579.0, 1124.0], [255.0, 1124.0]], "text": "这个汉字有点儿难，我老写错。", "confidence": 0.8776639620463054, "needs_review": false}, {"bbox": [[254.0, 1138.0], [483.0, 1141.0], [483.0, 1168.0], [254.0, 1165.0]], "text": "这个月北京老是下雨。", "confidence": 0.8523132692683827, "needs_review": false}, {"bbox": [[254.0, 1181.0], [483.0, 1181.0], [483.0, 1207.0], [254.0, 1207.0]], "text": "我们队又进了一个球。", "confidence": 0.8175495266914368, "needs_review": false}, {"bbox": [[161.0, 1242.0], [415.0, 1242.0], [415.0, 1268.0], [161.0, 1268.0]], "text": "【二17】关联副词：就1", "confidence": 0.8602499549205487, "needs_review": false}, {"bbox": [[257.0, 1282.0], [578.0, 1283.0], [578.0, 1309.0], [257.0, 1308.0]], "text": "如果明天天气好，我就去爬山。", "confidence": 0.889277442296346, "needs_review": false}, {"bbox": [[257.0, 1323.0], [675.0, 1324.0], [675.0, 1350.0], [257.0, 1349.0]], "text": "你有时间的话，我们就一起出去走走吧。", "confidence": 0.8976753981489884, "needs_review": false}, {"bbox": [[161.0, 1384.0], [425.0, 1385.0], [425.0, 1409.0], [161.0, 1408.0]], "text": "【二18】方式副词：故意", "confidence": 0.8571361670127282, "needs_review": false}, {"bbox": [[258.0, 1427.0], [795.0, 1427.0], [795.0, 1450.0], [258.0, 1450.0]], "text": "说话的时候，他故意提高声音，这样大家都能听见。", "confidence": 0.9287059058745702, "needs_review": false}, {"bbox": [[256.0, 1468.0], [506.0, 1468.0], [506.0, 1490.0], [256.0, 1490.0]], "text": "我不是故意弄坏电脑的。", "confidence": 0.8548720528682073, "needs_review": false}, {"bbox": [[163.0, 1528.0], [738.0, 1528.0], [738.0, 1551.0], [163.0, 1551.0]], "text": "【二19】情态副词：必须、差不多、好像、一定、也许", "confidence": 0.864876233614408, "needs_review": false}, {"bbox": [[257.0, 1570.0], [628.0, 1570.0], [628.0, 1593.0], [257.0, 1593.0]], "text": "要取得好成绩，大家必须努力学习。", "confidence": 0.8980324759202845, "needs_review": false}, {"bbox": [[258.0, 1612.0], [505.0, 1612.0], [505.0, 1631.0], [258.0, 1631.0]], "text": "机票差不多要两干块钱。", "confidence": 0.8672186930974325, "needs_review": false}, {"bbox": [[257.0, 1651.0], [434.0, 1651.0], [434.0, 1674.0], [257.0, 1674.0]], "text": "今天好像要下雨。", "confidence": 0.8465226292610168, "needs_review": false}, {"bbox": [[259.0, 1694.0], [626.0, 1694.0], [626.0, 1714.0], [259.0, 1714.0]], "text": "你到北京后，一定要去看看王老师帅。", "confidence": 0.8527561724185944, "needs_review": false}, {"bbox": [[258.0, 1735.0], [577.0, 1735.0], [577.0, 1754.0], [258.0, 1754.0]], "text": "我今年也许会去中国学习中文。", "confidence": 0.8674485246340434, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1215.0, 1786.0], [1215.0, 1809.0], [1179.0, 1809.0]], "text": "181", "confidence": 0.7288260757923126, "needs_review": false}]