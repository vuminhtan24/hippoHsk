[{"bbox": [[130.0, 165.0], [300.0, 165.0], [300.0, 188.0], [130.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.8052527721111591, "needs_review": false}, {"bbox": [[127.0, 221.0], [481.0, 219.0], [481.0, 246.0], [128.0, 248.0]], "text": "【六46】不是………，还还是…·", "confidence": 0.7141240817659041, "needs_review": false}, {"bbox": [[224.0, 264.0], [667.0, 264.0], [667.0, 287.0], [224.0, 287.0]], "text": "不是读完了就可以了，还应该写一篇作文。", "confidence": 0.9281558215618133, "needs_review": false}, {"bbox": [[224.0, 306.0], [761.0, 306.0], [761.0, 325.0], [224.0, 325.0]], "text": "这事不是你想做就能做的，还是要听听老板的意见。", "confidence": 0.9141517256697019, "needs_review": false}, {"bbox": [[127.0, 360.0], [553.0, 359.0], [553.0, 388.0], [127.0, 389.0]], "text": "【六47·】连···也都··，···更·", "confidence": 0.5985356725397564, "needs_review": false}, {"bbox": [[223.0, 404.0], [571.0, 404.0], [571.0, 427.0], [223.0, 427.0]], "text": "连大人也做不到，孩子更做不到。", "confidence": 0.922790177166462, "needs_review": false}, {"bbox": [[223.0, 445.0], [690.0, 445.0], [690.0, 467.0], [223.0, 467.0]], "text": "连老人也喜欢看，孩子们更是喜欢得不得了。", "confidence": 0.8672265665871757, "needs_review": false}, {"bbox": [[128.0, 506.0], [346.0, 506.0], [346.0, 532.0], [128.0, 532.0]], "text": "A.6.6.2.4选择复句", "confidence": 0.9211392232349941, "needs_review": false}, {"bbox": [[126.0, 568.0], [437.0, 566.0], [437.0, 595.0], [127.0, 597.0]], "text": "【六48·】要么……，要么…·", "confidence": 0.7113906312733889, "needs_review": false}, {"bbox": [[223.0, 609.0], [787.0, 610.0], [787.0, 634.0], [223.0, 633.0]], "text": "你要么跟他一组，要么自已一个人一组，尽快决定吧。", "confidence": 0.8939688658714294, "needs_review": false}, {"bbox": [[225.0, 651.0], [690.0, 651.0], [690.0, 674.0], [225.0, 674.0]], "text": "面对困难，我们要么被它吓倒，要么战胜它。", "confidence": 0.9034306123143151, "needs_review": false}, {"bbox": [[224.0, 692.0], [739.0, 692.0], [739.0, 714.0], [224.0, 714.0]], "text": "教室里的同学们要么在写作业，要么在小声讨论。", "confidence": 0.9343639456707499, "needs_review": false}, {"bbox": [[128.0, 753.0], [347.0, 753.0], [347.0, 779.0], [128.0, 779.0]], "text": "A.6.6.2.5转折复句", "confidence": 0.9203673047678811, "needs_review": false}, {"bbox": [[126.0, 816.0], [515.0, 816.0], [515.0, 841.0], [126.0, 841.0]], "text": "【六49】虽，但／可却／也···", "confidence": 0.7296122417730444, "needs_review": false}, {"bbox": [[225.0, 857.0], [499.0, 857.0], [499.0, 880.0], [225.0, 880.0]], "text": "他年纪虽小，但经验不少。", "confidence": 0.8906599650016198, "needs_review": false}, {"bbox": [[223.0, 898.0], [658.0, 898.0], [658.0, 921.0], [223.0, 921.0]], "text": "我虽没得到奖励，可仍然对自已充满信心", "confidence": 0.8140004465454503, "needs_review": false}, {"bbox": [[224.0, 938.0], [546.0, 938.0], [546.0, 961.0], [224.0, 961.0]], "text": "他虽失败了，却仍然微笑面对。", "confidence": 0.784386682510376, "needs_review": false}, {"bbox": [[224.0, 978.0], [496.0, 978.0], [496.0, 1001.0], [224.0, 1001.0]], "text": "她虽病了，也坚持来上课。", "confidence": 0.8993001213440528, "needs_review": false}, {"bbox": [[128.0, 1040.0], [346.0, 1040.0], [346.0, 1066.0], [128.0, 1066.0]], "text": "A.6.6.2.6假设复句", "confidence": 0.8885866786752429, "needs_review": false}, {"bbox": [[127.0, 1101.0], [477.0, 1101.0], [477.0, 1130.0], [127.0, 1130.0]], "text": "【六50】………·，要不然不然……", "confidence": 0.6813381529516644, "needs_review": false}, {"bbox": [[223.0, 1144.0], [691.0, 1144.0], [691.0, 1170.0], [223.0, 1170.0]], "text": "大家要认真对待考试，要不然会影响毕业的。", "confidence": 0.8906316132772536, "needs_review": false}, {"bbox": [[224.0, 1184.0], [595.0, 1184.0], [595.0, 1210.0], [224.0, 1210.0]], "text": "你不用太担心，不然我和你一起去。", "confidence": 0.8920703039449804, "needs_review": false}, {"bbox": [[222.0, 1224.0], [592.0, 1224.0], [592.0, 1249.0], [222.0, 1249.0]], "text": "外面下雨了，不然我们明天再去吧。", "confidence": 0.875259115415461, "needs_review": false}, {"bbox": [[128.0, 1287.0], [347.0, 1287.0], [347.0, 1313.0], [128.0, 1313.0]], "text": "A.6.6.2.7条件复句", "confidence": 0.9088322605405535, "needs_review": false}, {"bbox": [[129.0, 1352.0], [407.0, 1352.0], [407.0, 1374.0], [129.0, 1374.0]], "text": "【六51】凡是··.··，都···.·", "confidence": 0.5962840184569359, "needs_review": false}, {"bbox": [[226.0, 1392.0], [619.0, 1392.0], [619.0, 1415.0], [226.0, 1415.0]], "text": "凡是听到高兴的事，他都和朋友分享。", "confidence": 0.892807126045227, "needs_review": false}, {"bbox": [[226.0, 1434.0], [593.0, 1434.0], [593.0, 1454.0], [226.0, 1454.0]], "text": "凡是跟他合作，都能顺利完成任务。", "confidence": 0.9187261076534495, "needs_review": false}, {"bbox": [[225.0, 1473.0], [522.0, 1473.0], [522.0, 1495.0], [225.0, 1495.0]], "text": "凡是对的，我们都应该坚持。", "confidence": 0.8885541984013149, "needs_review": false}, {"bbox": [[128.0, 1534.0], [346.0, 1534.0], [346.0, 1560.0], [128.0, 1560.0]], "text": "A.6.6.2.8让步复句", "confidence": 0.9201744539397103, "needs_review": false}, {"bbox": [[128.0, 1597.0], [455.0, 1597.0], [455.0, 1622.0], [128.0, 1622.0]], "text": "【六52】就算／就是·····也··", "confidence": 0.7151628967962766, "needs_review": false}, {"bbox": [[224.0, 1639.0], [666.0, 1639.0], [666.0, 1662.0], [224.0, 1662.0]], "text": "就算成绩最好的同学也无法回答这个问题。", "confidence": 0.931321531534195, "needs_review": false}, {"bbox": [[225.0, 1681.0], [642.0, 1681.0], [642.0, 1701.0], [225.0, 1701.0]], "text": "就是你想马上瘦下来也不能每天不吃饭。", "confidence": 0.8954383511292306, "needs_review": false}, {"bbox": [[224.0, 1720.0], [617.0, 1720.0], [617.0, 1743.0], [224.0, 1743.0]], "text": "就算他错了你也不能说他，他还小呢。", "confidence": 0.9213643140263028, "needs_review": false}, {"bbox": [[153.0, 1786.0], [191.0, 1786.0], [191.0, 1809.0], [153.0, 1809.0]], "text": "234", "confidence": 0.6592178642749786, "needs_review": false}]