[{"bbox": [[131.0, 167.0], [299.0, 167.0], [299.0, 187.0], [131.0, 187.0]], "text": "GF00252021", "confidence": 0.903138664635745, "needs_review": false}, {"bbox": [[335.0, 223.0], [1206.0, 223.0], [1206.0, 246.0], [335.0, 246.0]], "text": "单位楼下的路口，新开了两家卖早餐的店，早餐的主要顾客，是在附近写字楼上班", "confidence": 0.9144850776002214, "needs_review": false}, {"bbox": [[285.0, 267.0], [1206.0, 267.0], [1206.0, 290.0], [285.0, 290.0]], "text": "的人。虽然卖着同样的早餐，味道差不多，价格也一样，而且每天早上每家店前都排满", "confidence": 0.9111552146764902, "needs_review": false}, {"bbox": [[287.0, 310.0], [1207.0, 310.0], [1207.0, 332.0], [287.0, 332.0]], "text": "了顾客，但月底一计算，东边胖大姐的利润却是西边瘦大姐的两倍多。仔细观察一番才", "confidence": 0.9177429324541336, "needs_review": false}, {"bbox": [[285.0, 352.0], [1203.0, 352.0], [1203.0, 372.0], [285.0, 372.0]], "text": "发现，原来差别竟出在经营策略上一一瘦大姐坚持自己十几年卖早餐的传统方式，每收", "confidence": 0.8792317433234973, "needs_review": false}, {"bbox": [[283.0, 393.0], [1206.0, 394.0], [1206.0, 417.0], [283.0, 416.0]], "text": "一个顾客的钱，就卷一个饼，然后收下一个顾客的钱，再卷一个饼。而胖大姐则截然不", "confidence": 0.8944066961606344, "needs_review": false}, {"bbox": [[285.0, 437.0], [1205.0, 437.0], [1205.0, 459.0], [285.0, 459.0]], "text": "同，她事先把做好的饼摆整齐，自己只管收钱和找钱，前面并排放着五双筷子，让交完", "confidence": 0.9129051199326148, "needs_review": false}, {"bbox": [[286.0, 479.0], [672.0, 479.0], [672.0, 502.0], [286.0, 502.0]], "text": "钱的顾客自己动手卷菜。（因果句群）", "confidence": 0.8962830271985796, "needs_review": false}, {"bbox": [[500.0, 1086.0], [586.0, 991.0], [667.0, 1064.0], [580.0, 1158.0]], "text": "土", "confidence": 0.22880254685878754, "needs_review": true}, {"bbox": [[153.0, 1786.0], [191.0, 1786.0], [191.0, 1809.0], [153.0, 1809.0]], "text": "254", "confidence": 0.746154397726059, "needs_review": false}]