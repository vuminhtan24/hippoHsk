[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.7785550722709069, "needs_review": false}, {"bbox": [[160.0, 221.0], [573.0, 220.0], [574.0, 247.0], [160.0, 248.0]], "text": "【七一九107】…·，…··倒反倒·", "confidence": 0.6444373224910936, "needs_review": false}, {"bbox": [[318.0, 265.0], [689.0, 265.0], [689.0, 288.0], [318.0, 288.0]], "text": "我好心劝他，他倒怪我，真是好笑！", "confidence": 0.9034100595642539, "needs_review": false}, {"bbox": [[316.0, 304.0], [712.0, 305.0], [712.0, 330.0], [316.0, 329.0]], "text": "听护士这么一说，他反倒放松了下来。", "confidence": 0.8955113954014249, "needs_review": false}, {"bbox": [[161.0, 369.0], [379.0, 369.0], [379.0, 395.0], [161.0, 395.0]], "text": "A.7.5.2.6假设复句", "confidence": 0.8755319842270443, "needs_review": false}, {"bbox": [[161.0, 435.0], [461.0, 435.0], [461.0, 457.0], [161.0, 457.0]], "text": "【七一九108】尚若／若.·", "confidence": 0.7447078585624695, "needs_review": false}, {"bbox": [[319.0, 476.0], [833.0, 476.0], [833.0, 499.0], [319.0, 499.0]], "text": "倘若这几个问题你都能解决，你一定会获得成功。", "confidence": 0.9088076845459316, "needs_review": false}, {"bbox": [[317.0, 518.0], [666.0, 518.0], [666.0, 541.0], [317.0, 541.0]], "text": "若不小心，是不是又会发生纠纷？", "confidence": 0.9006085842847824, "needs_review": false}, {"bbox": [[162.0, 579.0], [793.0, 579.0], [793.0, 601.0], [162.0, 601.0]], "text": "【七一九109】尚若／假设／假使／若·.··，就／那（么）····", "confidence": 0.7699856258490506, "needs_review": false}, {"bbox": [[318.0, 620.0], [785.0, 620.0], [785.0, 643.0], [318.0, 643.0]], "text": "倘若一点儿音乐知识都没有，就会遇到困难。", "confidence": 0.8953399544670468, "needs_review": false}, {"bbox": [[316.0, 659.0], [973.0, 661.0], [973.0, 687.0], [316.0, 685.0]], "text": "假设这是我们未来的家园，那这个世界就不会再有饥饿的儿童。", "confidence": 0.9210709559506384, "needs_review": false}, {"bbox": [[318.0, 703.0], [857.0, 703.0], [857.0, 725.0], [318.0, 725.0]], "text": "假使一切能重新开始，那么我绝不会选择这一条路。", "confidence": 0.9437684242924055, "needs_review": false}, {"bbox": [[160.0, 762.0], [754.0, 761.0], [754.0, 787.0], [160.0, 788.0]], "text": "【七一九110】幸亏…··，要不然／不然／要不／否则…··", "confidence": 0.7585504343112309, "needs_review": false}, {"bbox": [[318.0, 805.0], [688.0, 805.0], [688.0, 828.0], [318.0, 828.0]], "text": "幸亏你提醒了我，要不然我就忘了。", "confidence": 0.8964900023796979, "needs_review": false}, {"bbox": [[317.0, 845.0], [783.0, 846.0], [783.0, 870.0], [317.0, 869.0]], "text": "幸亏有你帮忙，不然我真不知道怎么办才好。", "confidence": 0.8742725934301104, "needs_review": false}, {"bbox": [[161.0, 909.0], [379.0, 909.0], [379.0, 935.0], [161.0, 935.0]], "text": "A.7.5.2.7条件复句", "confidence": 0.884795354945319, "needs_review": false}, {"bbox": [[159.0, 974.0], [509.0, 971.0], [509.0, 997.0], [159.0, 999.0]], "text": "【七一九111】别管·，都..·", "confidence": 0.6631581590456121, "needs_review": false}, {"bbox": [[315.0, 1010.0], [723.0, 1016.0], [723.0, 1046.0], [314.0, 1040.0]], "text": "别管台下坐的是谁，你都要充满信心。", "confidence": 0.8782776362366147, "needs_review": false}, {"bbox": [[315.0, 1055.0], [735.0, 1056.0], [735.0, 1083.0], [315.0, 1082.0]], "text": "这样的话一出口，别管是谁，都得挨骂。", "confidence": 0.8826022775549638, "needs_review": false}, {"bbox": [[157.0, 1114.0], [484.0, 1110.0], [484.0, 1144.0], [158.0, 1148.0]], "text": "【七—九·2·】任，也·", "confidence": 0.5870809348729941, "needs_review": false}, {"bbox": [[316.0, 1158.0], [592.0, 1159.0], [592.0, 1185.0], [316.0, 1184.0]], "text": "任他们怎么推，也推不动。", "confidence": 0.8777910700211158, "needs_review": false}, {"bbox": [[319.0, 1202.0], [713.0, 1202.0], [713.0, 1225.0], [319.0, 1225.0]], "text": "任他是代么高职位的人，也管不了我。", "confidence": 0.8600118706623713, "needs_review": false}, {"bbox": [[161.0, 1264.0], [380.0, 1264.0], [380.0, 1290.0], [161.0, 1290.0]], "text": "A.7.5.2.8因果复句", "confidence": 0.8901152908802032, "needs_review": false}, {"bbox": [[161.0, 1330.0], [497.0, 1330.0], [497.0, 1353.0], [161.0, 1353.0]], "text": "【七一九113】（因）·..·，故·", "confidence": 0.7288566153300436, "needs_review": false}, {"bbox": [[318.0, 1371.0], [689.0, 1371.0], [689.0, 1394.0], [318.0, 1394.0]], "text": "因不是体面的事情，故不敢说出来。", "confidence": 0.9223607077318079, "needs_review": false}, {"bbox": [[320.0, 1414.0], [785.0, 1414.0], [785.0, 1434.0], [320.0, 1434.0]], "text": "他已经适应了国外的生活，故不打算再回国。", "confidence": 0.930430931704385, "needs_review": false}, {"bbox": [[162.0, 1474.0], [400.0, 1474.0], [400.0, 1496.0], [162.0, 1496.0]], "text": "【七一九114】鉴于.", "confidence": 0.8503694062431654, "needs_review": false}, {"bbox": [[318.0, 1515.0], [809.0, 1515.0], [809.0, 1538.0], [318.0, 1538.0]], "text": "鉴于他的表现良好，学校决定允许他回来上课。", "confidence": 0.9093815277923237, "needs_review": false}, {"bbox": [[319.0, 1556.0], [953.0, 1556.0], [953.0, 1579.0], [319.0, 1579.0]], "text": "鉴于他在处理这种问题上毫无经验，公司决定派我来帮助他。", "confidence": 0.9292641707829067, "needs_review": false}, {"bbox": [[158.0, 1615.0], [569.0, 1609.0], [570.0, 1642.0], [159.0, 1647.0]], "text": "【七—九·15】（由于）…，以致…", "confidence": 0.7337312979830636, "needs_review": false}, {"bbox": [[320.0, 1660.0], [688.0, 1660.0], [688.0, 1680.0], [320.0, 1680.0]], "text": "他睡过头了，以致错过了第一节课。", "confidence": 0.885802545968224, "needs_review": false}, {"bbox": [[319.0, 1700.0], [737.0, 1700.0], [737.0, 1723.0], [319.0, 1723.0]], "text": "他由于学习不认真，以致考了最后一名。", "confidence": 0.925889724179318, "needs_review": false}, {"bbox": [[1178.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1178.0, 1809.0]], "text": "249", "confidence": 0.6260930299758911, "needs_review": false}]