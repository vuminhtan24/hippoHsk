[{"bbox": [[130.0, 165.0], [300.0, 165.0], [300.0, 188.0], [130.0, 188.0]], "text": "GF0025—2021", "confidence": 0.8099782268206278, "needs_review": false}, {"bbox": [[127.0, 221.0], [472.0, 220.0], [472.0, 247.0], [127.0, 248.0]], "text": "【七一九116】·.，以至于……", "confidence": 0.7332566818770241, "needs_review": false}, {"bbox": [[285.0, 265.0], [726.0, 265.0], [726.0, 288.0], [285.0, 288.0]], "text": "事情发展得太快，以至于大家都难以反应。", "confidence": 0.9215506494045258, "needs_review": false}, {"bbox": [[283.0, 308.0], [799.0, 308.0], [799.0, 330.0], [283.0, 330.0]], "text": "这篇课文他读了很多遍，以至于全文都背得出来。", "confidence": 0.9193348366281261, "needs_review": false}, {"bbox": [[127.0, 369.0], [636.0, 369.0], [636.0, 395.0], [127.0, 395.0]], "text": "【七一九117】之所以…………·，是因为／是由于……·", "confidence": 0.7437226836170469, "needs_review": false}, {"bbox": [[284.0, 414.0], [729.0, 414.0], [729.0, 437.0], [284.0, 437.0]], "text": "这部电影之所以好看，是因为内容很有趣。", "confidence": 0.9022396177053451, "needs_review": false}, {"bbox": [[285.0, 456.0], [822.0, 456.0], [822.0, 479.0], [285.0, 479.0]], "text": "妈妈之所以生气了，是由于他不肯承认自已的错误。", "confidence": 0.9128604258100191, "needs_review": false}, {"bbox": [[128.0, 520.0], [346.0, 520.0], [346.0, 546.0], [128.0, 546.0]], "text": "A.7.5.2.9让步复句", "confidence": 0.9218647863183703, "needs_review": false}, {"bbox": [[127.0, 585.0], [471.0, 585.0], [471.0, 611.0], [127.0, 611.0]], "text": "【七一九118】固然··，也···…·", "confidence": 0.714017128944397, "needs_review": false}, {"bbox": [[285.0, 629.0], [778.0, 629.0], [778.0, 652.0], [285.0, 652.0]], "text": "那固然是我们的习惯，也还需要有另外的理由。", "confidence": 0.8904171640222723, "needs_review": false}, {"bbox": [[286.0, 672.0], [655.0, 672.0], [655.0, 695.0], [286.0, 695.0]], "text": "他的话固然给我安慰，也使我难过。", "confidence": 0.8692200569545522, "needs_review": false}, {"bbox": [[128.0, 732.0], [678.0, 732.0], [678.0, 758.0], [128.0, 758.0]], "text": "【七一九119】………··固然……·，但是／可是／不过……", "confidence": 0.6839210192362467, "needs_review": false}, {"bbox": [[287.0, 776.0], [800.0, 776.0], [800.0, 799.0], [287.0, 799.0]], "text": "一个人的成功，聪明固然重要，但是努力更重要。", "confidence": 0.9242119374482528, "needs_review": false}, {"bbox": [[285.0, 820.0], [868.0, 820.0], [868.0, 842.0], [285.0, 842.0]], "text": "网络固然给我们带来了便利，可是也给我们带来了麻烦。", "confidence": 0.9105480382075677, "needs_review": false}, {"bbox": [[284.0, 861.0], [770.0, 861.0], [770.0, 884.0], [284.0, 884.0]], "text": "这种方法固然有用，不过也不能解决根本问题", "confidence": 0.901509512038458, "needs_review": false}, {"bbox": [[126.0, 922.0], [475.0, 918.0], [475.0, 948.0], [127.0, 952.0]], "text": "【七—九120】即便，也·", "confidence": 0.749685845204762, "needs_review": false}, {"bbox": [[285.0, 965.0], [582.0, 966.0], [582.0, 989.0], [285.0, 988.0]], "text": "即便你成绩好，也不能骄傲。", "confidence": 0.8839510210922786, "needs_review": false}, {"bbox": [[285.0, 1007.0], [774.0, 1008.0], [774.0, 1032.0], [285.0, 1031.0]], "text": "他眼神中充满的即便不是感动，至少也是同情。", "confidence": 0.8823412304574793, "needs_review": false}, {"bbox": [[128.0, 1071.0], [617.0, 1071.0], [617.0, 1094.0], [128.0, 1094.0]], "text": "【七一九121】虽说···，但是／可是/不过…·", "confidence": 0.787706207036972, "needs_review": false}, {"bbox": [[285.0, 1112.0], [678.0, 1112.0], [678.0, 1135.0], [285.0, 1135.0]], "text": "虽说他年纪小，但是也不能过于任性。", "confidence": 0.880227761136161, "needs_review": false}, {"bbox": [[283.0, 1153.0], [608.0, 1154.0], [608.0, 1181.0], [283.0, 1180.0]], "text": "虽说中文很难，可是它很有趣。", "confidence": 0.8708014965057373, "needs_review": false}, {"bbox": [[284.0, 1197.0], [730.0, 1197.0], [730.0, 1223.0], [284.0, 1223.0]], "text": "虽说这是件小事，不过我们应该重视起来。", "confidence": 0.9147789716720581, "needs_review": false}, {"bbox": [[126.0, 1259.0], [473.0, 1259.0], [473.0, 1288.0], [126.0, 1288.0]], "text": "【七一九122】纵然，也……", "confidence": 0.8147089958190918, "needs_review": false}, {"bbox": [[286.0, 1304.0], [727.0, 1304.0], [727.0, 1327.0], [286.0, 1327.0]], "text": "我们的意见纵然不一致，也应当互相理解。", "confidence": 0.9037545651197434, "needs_review": false}, {"bbox": [[284.0, 1346.0], [895.0, 1346.0], [895.0, 1368.0], [284.0, 1368.0]], "text": "这事纵然不好，也是他们之间的事，就让他们自已处理吧。", "confidence": 0.919726413709146, "needs_review": false}, {"bbox": [[127.0, 1409.0], [359.0, 1409.0], [359.0, 1435.0], [127.0, 1435.0]], "text": "A.7.5.2.10目的复句", "confidence": 0.805711277325948, "needs_review": false}, {"bbox": [[126.0, 1475.0], [424.0, 1474.0], [424.0, 1500.0], [127.0, 1501.0]], "text": "【七一九123】·，以····", "confidence": 0.6318134982138872, "needs_review": false}, {"bbox": [[284.0, 1519.0], [920.0, 1519.0], [920.0, 1542.0], [284.0, 1542.0]], "text": "政府用他们的名字命名这条街，以纪念在战争中牺牲的战士。", "confidence": 0.932240292429924, "needs_review": false}, {"bbox": [[286.0, 1562.0], [824.0, 1562.0], [824.0, 1585.0], [286.0, 1585.0]], "text": "老师采用新的教学方法上课，以调动学生的积极性。", "confidence": 0.9239020198583603, "needs_review": false}, {"bbox": [[127.0, 1622.0], [517.0, 1620.0], [517.0, 1647.0], [128.0, 1649.0]], "text": "【七一九124】……，以免／免得…··", "confidence": 0.7082914590835572, "needs_review": false}, {"bbox": [[286.0, 1666.0], [656.0, 1666.0], [656.0, 1689.0], [286.0, 1689.0]], "text": "出门在外看好你的东西，以免丢失。", "confidence": 0.9102987121133244, "needs_review": false}, {"bbox": [[288.0, 1711.0], [628.0, 1711.0], [628.0, 1731.0], [288.0, 1731.0]], "text": "你把这个写下来，免得过后忘记。", "confidence": 0.885004747658968, "needs_review": false}, {"bbox": [[153.0, 1786.0], [190.0, 1786.0], [190.0, 1809.0], [153.0, 1809.0]], "text": "250", "confidence": 0.6599988490343094, "needs_review": false}]