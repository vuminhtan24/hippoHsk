[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.8053111433982849, "needs_review": false}, {"bbox": [[161.0, 222.0], [379.0, 222.0], [379.0, 248.0], [161.0, 248.0]], "text": "A.6.6.2.9紧缩复句", "confidence": 0.8277713869299207, "needs_review": false}, {"bbox": [[162.0, 286.0], [390.0, 286.0], [390.0, 309.0], [162.0, 309.0]], "text": "【六53】不····不···", "confidence": 0.6450516959031423, "needs_review": false}, {"bbox": [[258.0, 324.0], [578.0, 324.0], [578.0, 347.0], [258.0, 347.0]], "text": "你们两个人可真是不打不成交。", "confidence": 0.8878359834353129, "needs_review": false}, {"bbox": [[257.0, 365.0], [650.0, 365.0], [650.0, 385.0], [257.0, 385.0]], "text": "这里的房价不问不知道，一问吓一跳。", "confidence": 0.8289056850804223, "needs_review": false}, {"bbox": [[257.0, 403.0], [651.0, 403.0], [651.0, 426.0], [257.0, 426.0]], "text": "她今天一直在练习，不达标准不休息。", "confidence": 0.8693388534916772, "needs_review": false}, {"bbox": [[161.0, 463.0], [392.0, 463.0], [392.0, 489.0], [161.0, 489.0]], "text": "A.6.6.2.10多重复句", "confidence": 0.8705660462379455, "needs_review": false}, {"bbox": [[162.0, 527.0], [518.0, 527.0], [518.0, 550.0], [162.0, 550.0]], "text": "【六54】二重复句2：复句+复句", "confidence": 0.8819179044050329, "needs_review": false}, {"bbox": [[258.0, 568.0], [1231.0, 568.0], [1231.0, 587.0], [258.0, 587.0]], "text": "成功的基础是奋斗，奋斗的收获是成功，所以，只有不断努力的人才有机会走上成功的高峰。", "confidence": 0.9263064918063936, "needs_review": false}, {"bbox": [[254.0, 602.0], [1239.0, 602.0], [1239.0, 628.0], [254.0, 628.0]], "text": "这个国王既不关心他的军队，也不喜欢去看戏，也不喜欢乘着马车去游玩儿，一一除非是要", "confidence": 0.9010698751705449, "needs_review": false}, {"bbox": [[258.0, 646.0], [531.0, 646.0], [531.0, 666.0], [258.0, 666.0]], "text": "展示一下儿自己已的新衣服。", "confidence": 0.7967270080532346, "needs_review": false}, {"bbox": [[257.0, 684.0], [1236.0, 684.0], [1236.0, 707.0], [257.0, 707.0]], "text": "承认错误，才能正确看待出现在自已身上的问题；同时，只有虚心接受别人的批评，解决了", "confidence": 0.8979740448114348, "needs_review": false}, {"bbox": [[258.0, 721.0], [651.0, 722.0], [651.0, 745.0], [258.0, 744.0]], "text": "自己的问题，才能取得下一步的成功。", "confidence": 0.9017206596003638, "needs_review": false}, {"bbox": [[957.0, 737.0], [1061.0, 721.0], [1073.0, 790.0], [968.0, 807.0]], "text": "", "confidence": 1e-50, "needs_review": true}, {"bbox": [[160.0, 783.0], [364.0, 783.0], [364.0, 809.0], [160.0, 809.0]], "text": "A.6.7强调的方法", "confidence": 0.8150141672654585, "needs_review": false}, {"bbox": [[161.0, 844.0], [546.0, 844.0], [546.0, 870.0], [161.0, 870.0]], "text": "【六55】用“非··……··不可”表示强调", "confidence": 0.754931008273905, "needs_review": false}, {"bbox": [[256.0, 885.0], [602.0, 885.0], [602.0, 908.0], [256.0, 908.0]], "text": "不管天气怎么样，我们非去不可。", "confidence": 0.9122984260320663, "needs_review": false}, {"bbox": [[256.0, 925.0], [782.0, 925.0], [782.0, 948.0], [256.0, 948.0]], "text": "还有这么长准备时间呢，你非要现在写完不可吗？", "confidence": 0.9223005460656207, "needs_review": false}, {"bbox": [[255.0, 961.0], [631.0, 963.0], [631.0, 988.0], [255.0, 986.0]], "text": "他正生着气呢，你非现在说不可吗？", "confidence": 0.8304046427502352, "needs_review": false}, {"bbox": [[160.0, 1024.0], [342.0, 1024.0], [342.0, 1050.0], [160.0, 1050.0]], "text": "A.6.8口语格式", "confidence": 0.8744578421115875, "needs_review": false}, {"bbox": [[161.0, 1087.0], [424.0, 1087.0], [424.0, 1109.0], [161.0, 1109.0]], "text": "【六56】X到Y头上来了", "confidence": 0.8059784907561082, "needs_review": false}, {"bbox": [[257.0, 1124.0], [677.0, 1124.0], [677.0, 1150.0], [257.0, 1150.0]], "text": "他都欺负到你头上来了，你也不在乎吗？", "confidence": 0.9083447017167744, "needs_review": false}, {"bbox": [[257.0, 1165.0], [718.0, 1165.0], [718.0, 1188.0], [257.0, 1188.0]], "text": "人家都求到我们头上来了，还是帮帮他们吧，", "confidence": 0.902090364978427, "needs_review": false}, {"bbox": [[256.0, 1205.0], [581.0, 1205.0], [581.0, 1227.0], [256.0, 1227.0]], "text": "这种好事怎么轮到我头上来了？", "confidence": 0.8788209398587544, "needs_review": false}, {"bbox": [[159.0, 1260.0], [355.0, 1260.0], [355.0, 1286.0], [159.0, 1286.0]], "text": "【六57】×就×吧", "confidence": 0.8018689572811126, "needs_review": false}, {"bbox": [[256.0, 1300.0], [602.0, 1300.0], [602.0, 1326.0], [256.0, 1326.0]], "text": "等等就等等吧，没有别的办法了。", "confidence": 0.8423179872334003, "needs_review": false}, {"bbox": [[257.0, 1342.0], [603.0, 1342.0], [603.0, 1364.0], [257.0, 1364.0]], "text": "少点儿就少点儿吧，总比没有强。", "confidence": 0.9157110713422298, "needs_review": false}, {"bbox": [[258.0, 1380.0], [602.0, 1380.0], [602.0, 1403.0], [258.0, 1403.0]], "text": "晚点儿就晚点儿吧，来得及就行。", "confidence": 0.9085296541452408, "needs_review": false}, {"bbox": [[160.0, 1438.0], [328.0, 1438.0], [328.0, 1464.0], [160.0, 1464.0]], "text": "【六58】×是", "confidence": 0.7644602693617344, "needs_review": false}, {"bbox": [[257.0, 1479.0], [627.0, 1479.0], [627.0, 1501.0], [257.0, 1501.0]], "text": "去是去了，就是不知道结果怎么样。", "confidence": 0.9290707637281979, "needs_review": false}, {"bbox": [[256.0, 1517.0], [749.0, 1517.0], [749.0, 1540.0], [256.0, 1540.0]], "text": "好是好，但不知道老师会不会同意我们这样做。", "confidence": 0.9105517105622725, "needs_review": false}, {"bbox": [[254.0, 1556.0], [624.0, 1556.0], [624.0, 1579.0], [254.0, 1579.0]], "text": "这件衣服漂亮是漂亮，但也太贵了。", "confidence": 0.9071257324779735, "needs_review": false}, {"bbox": [[160.0, 1614.0], [498.0, 1612.0], [498.0, 1639.0], [160.0, 1640.0]], "text": "【六59不×不··，一·····", "confidence": 0.5737680564908421, "needs_review": false}, {"bbox": [[255.0, 1654.0], [725.0, 1654.0], [725.0, 1677.0], [255.0, 1677.0]], "text": "不看不知道，一看吓一跳，这里变化太大了！", "confidence": 0.9233715789658683, "needs_review": false}, {"bbox": [[255.0, 1694.0], [750.0, 1694.0], [750.0, 1717.0], [255.0, 1717.0]], "text": "这题目看起来简单，不做不知道，一做真不会！", "confidence": 0.9019375714388761, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1179.0, 1809.0]], "text": "235", "confidence": 0.7461345046758652, "needs_review": false}]