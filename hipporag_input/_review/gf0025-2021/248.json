 {"bbox": [[286.0, 1331.0], [655.0, 1331.0], [655.0, 1354.0], [286.0, 1354.0]], "text": "我们可以将北京描绘为一本梦之书。", "confidence": 0.9218553129364463, "needs_review": false}, {"bbox": [[286.0, 1371.0], [898.0, 1371.0], [898.0, 1394.0], [286.0, 1394.0]], "text": "由于做了好事，做出了贡献，因此他得到所爱之人的欣赏。", "confidence": 0.9093517594867282, "needs_review": false}, {"bbox": [[128.0, 1434.0], [346.0, 1434.0], [346.0, 1460.0], [128.0, 1460.0]], "text": "A.7.1.7.2语气助词", "confidence": 0.8905906677246094, "needs_review": false}, {"bbox": [[127.0, 1498.0], [331.0, 1498.0], [331.0, 1524.0], [127.0, 1524.0]], "text": "【七一九057】而已", "confidence": 0.8350906534628435, "needs_review": false}, {"bbox": [[284.0, 1541.0], [582.0, 1541.0], [582.0, 1564.0], [284.0, 1564.0]], "text": "这算什么，只是一堆纸而已。", "confidence": 0.8910901333604541, "needs_review": false}, {"bbox": [[285.0, 1583.0], [654.0, 1583.0], [654.0, 1606.0], [285.0, 1606.0]], "text": "我不过是出于好奇，随便问问而已。", "confidence": 0.9177996025365942, "needs_review": false}, {"bbox": [[126.0, 1641.0], [308.0, 1639.0], [309.0, 1666.0], [127.0, 1668.0]], "text": "【七一九058】矣", "confidence": 0.8103645741939545, "needs_review": false}, {"bbox": [[285.0, 1685.0], [488.0, 1685.0], [488.0, 1708.0], [285.0, 1708.0]], "text": "人生得一知已足矣。", "confidence": 0.7875713050365448, "needs_review": false}, {"bbox": [[285.0, 1725.0], [488.0, 1725.0], [488.0, 1750.0], [285.0, 1750.0]], "text": "他的想法可谓多矣。", "confidence": 0.8409439384937286, "needs_review": false}, {"bbox": [[153.0, 1786.0], [190.0, 1786.0], [190.0, 1809.0], [153.0, 1809.0]], "text": "242", "confidence": 0.6516619175672531, "needs_review": false}]