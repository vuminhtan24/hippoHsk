[{"bbox": [[130.0, 165.0], [300.0, 165.0], [300.0, 188.0], [130.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.8171546138249911, "needs_review": false}, {"bbox": [[128.0, 222.0], [418.0, 222.0], [418.0, 248.0], [128.0, 248.0]], "text": "A.7.1.5.3引出凭借、依据", "confidence": 0.9272247798302594, "needs_review": false}, {"bbox": [[127.0, 287.0], [308.0, 287.0], [308.0, 313.0], [127.0, 313.0]], "text": "【七一九051】趁", "confidence": 0.7633292853832245, "needs_review": false}, {"bbox": [[286.0, 329.0], [581.0, 329.0], [581.0, 352.0], [286.0, 352.0]], "text": "趁你还年轻，一定要多尝试。", "confidence": 0.915940237896783, "needs_review": false}, {"bbox": [[285.0, 371.0], [630.0, 371.0], [630.0, 391.0], [285.0, 391.0]], "text": "趁火车还没开，你现在还能下车。", "confidence": 0.9022974856197834, "needs_review": false}, {"bbox": [[128.0, 430.0], [332.0, 430.0], [332.0, 455.0], [128.0, 455.0]], "text": "【七一九052】基于", "confidence": 0.8284645134752447, "needs_review": false}, {"bbox": [[284.0, 473.0], [798.0, 473.0], [798.0, 496.0], [284.0, 496.0]], "text": "这两种不同的人生态度是基于对人生不同的理解。", "confidence": 0.9267008822897206, "needs_review": false}, {"bbox": [[284.0, 512.0], [656.0, 513.0], [656.0, 539.0], [284.0, 538.0]], "text": "你的结论都基于假设，所以不可信。", "confidence": 0.8906637219821706, "needs_review": false}, {"bbox": [[127.0, 574.0], [307.0, 571.0], [308.0, 598.0], [128.0, 600.0]], "text": "【七一九053】依", "confidence": 0.8253737568855286, "needs_review": false}, {"bbox": [[286.0, 617.0], [584.0, 617.0], [584.0, 640.0], [286.0, 640.0]], "text": "依你看，这件事该怎么解决？", "confidence": 0.8335226646491459, "needs_review": false}, {"bbox": [[284.0, 658.0], [559.0, 658.0], [559.0, 681.0], [284.0, 681.0]], "text": "这件事就依你的方案做吧。", "confidence": 0.9182427479670598, "needs_review": false}, {"bbox": [[126.0, 721.0], [280.0, 718.0], [280.0, 745.0], [127.0, 747.0]], "text": "A.7.1.6连词", "confidence": 0.8039858400821686, "needs_review": false}, {"bbox": [[128.0, 787.0], [476.0, 787.0], [476.0, 810.0], [128.0, 810.0]], "text": "【七一九054】连接词或词组：及", "