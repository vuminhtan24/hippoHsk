.0], [280.0, 482.0], [225.0, 482.0]], "text": "动词", "confidence": 0.6646097302436829, "needs_review": false}, {"bbox": [[128.0, 521.0], [367.0, 521.0], [367.0, 544.0], [128.0, 544.0]], "text": "【三03】能愿动词：敢", "confidence": 0.8484398076931635, "needs_review": false}, {"bbox": [[223.0, 564.0], [549.0, 564.0], [549.0, 586.0], [223.0, 586.0]], "text": "这儿有两米高，你敢跳下去吗？", "confidence": 0.8430691997210185, "needs_review": false}, {"bbox": [[223.0, 604.0], [425.0, 604.0], [425.0, 627.0], [223.0, 627.0]], "text": "我不敢在河里游泳。", "confidence": 0.8069602191448212, "needs_review": false}, {"bbox": [[128.0, 663.0], [393.0, 664.0], [393.0, 690.0], [127.0, 689.0]], "text": "【三04】能愿动词：需要", "confidence": 0.8596598964471084, "needs_review": false}, {"bbox": [[223.0, 706.0], [451.0, 706.0], [451.0, 731.0], [223.0, 731.0]], "text": "她生病了，需要休息。", "confidence": 0.8895414850928567, "needs_review": false}, {"bbox": [[224.0, 748.0], [571.0, 748.0], [571.0, 771.0], [224.0, 771.0]], "text": "我们不需要买吃的，家里有很多。", "confidence": 0.8611349277198315, "needs_review": false}, {"bbox": [[127.0, 807.0], [1165.0, 808.0], [1165.0, 834.0], [127.0, 833.0]], "text": "【三05】动宾式离合词：帮忙、点头、放假、干杯、见面、结婚、看病、睡觉、洗澡、理发、说话", "confidence": 0.9382924411031935, "needs_review": false}, {"bbox": [[224.0, 849.0], [403.0, 849.0], [403.0, 875.0], [224.0, 875.0]], "text": "他经常帮我的忙。", "confidence": 0.8874752190377977, "needs_review": false}, {"bbox": [[224.0, 892.0], [522.0, 892.0], [522.0, 915.0], [224.0, 915.0]], "text": "他点了一下儿头，表示同意。", "confidence": 0.8785076481955392, "needs_review": false}, {"bbox": [[223.0, 934.0], [450.0, 934.0], [450.0, 957.0], [223.0, 957.0]], "text": "我想放了假就去旅行。", "confidence": 0.8683491511778398, "needs_review": false}, {"bbox": [[223.0, 975.0], [450.0, 975.0], [450.0, 998.0], [223.0, 998.0]], "text": "来，我们一起干一杯。", "confidence": 0.7993027405305342, "needs_review": false}, {"bbox": [[221.0, 1011.0], [577.0, 1015.0], [576.0, 1044.0], [221.0, 1040.0]], "text": "来中国以后，我们只见过一次面。", "confidence": 0.865768026560545, "needs_review": false}, {"bbox": [[220.0, 1056.0], [515.0, 1051.0], [516.0, 1080.0], [220.0, 1086.0]], "text": "结了婚以后，她就不工作了", "confidence": 0.8741500102556669, "needs_review": false}, {"bbox": [[223.0, 1099.0], [474.0, 1099.0], [474.0, 1122.0], [223.0, 1122.0]], "text": "病人看完病就去取药了。", "confidence": 0.8998744040727615, "needs_review": false}, {"bbox": [[127.0, 1157.0], [659.0, 1158.0], [659.0, 1185.0], [127.0, 1184.0]], "text": "【三06】动补式离合词：打开、看见、离开、完成", "confidence": 0.9198069199919701, "needs_review": false}, {"bbox": [[224.0, 1201.0], [694.0, 1201.0], [694.0, 1227.0], [224.0, 1227.0]], "text": "你的文件我打不开，你能再给我发一下儿吗？", "confidence": 0.9230078799383981, "needs_review": false}, {"bbox": [[223.0, 1241.0], [575.0, 1240.0], [576.0, 1266.0], [223.0, 1267.0]], "text": "黑板上的字很小，我们都看不见。", "confidence": 0.8775065504014492, "needs_review": false}, {"bbox": [[224.0, 1284.0], [617.0, 1284.0], [617.0, 1307.0], [224.0, 1307.0]], "text": "放心吧，孩子这么大，离得开妈妈了。", "confidence": 0.8856495651933882, "needs_review": false}, {"bbox": [[221.0, 1322.0], [453.0, 1324.0], [453.0, 1351.0], [221.0, 1348.0]], "text": "我们完不成这个任务。", "confidence": 0.8440775871276855, "needs_review": false}, {"bbox": [[126.0, 1387.0], [280.0, 1385.0], [281.0, 1413.0], [127.0, 1415.0]], "text": "A.3.2.2代词", "confidence": 0.8965516090393066, "needs_review": false}, {"bbox": [[128.0, 1453.0], [463.0, 1453.0], [463.0, 1476.0], [128.0, 1476.0]], "text": "（三07】疑问代词的非疑问用法", "confidence": 0.8439139574766159, "needs_review": false}, {"bbox": [[174.0, 1495.0], [320.0, 1495.0], [320.0, 1519.0], [174.0, 1519.0]], "text": "（1）任指用法", "confidence": 0.8527882099151611, "needs_review": false}, {"bbox": [[224.0, 1537.0], [394.0, 1537.0], [394.0, 1560.0], [224.0, 1560.0]], "text": "①疑问代词+都", "confidence": 0.7247852459549904, "needs_review": false}, {"bbox": [[224.0, 1578.0], [355.0, 1578.0], [355.0, 1602.0], [224.0, 1602.0]], "text": "谁都喜欢她。", "confidence": 0.8501104286738804, "needs_review": false}, {"bbox": [[223.0, 1619.0], [378.0, 1619.0], [378.0, 1643.0], [223.0, 1643.0]], "text": "我吃什么都行。", "confidence": 0.7700279727578163, "needs_review": false}, {"bbox": [[225.0, 1661.0], [450.0, 1661.0], [450.0, 1684.0], [225.0, 1684.0]], "text": "你什么时候来都可以。", "confidence": 0.8760358799587596, "needs_review": false}, {"bbox": [[222.0, 1701.0], [402.0, 1701.0], [402.0, 1727.0], [222.0, 1727.0]], "text": "我哪儿都没去过。", "confidence": 0.879050095876058, "needs_review": false}, {"bbox": [[225.0, 1743.0], [449.0, 1743.0], [449.0, 1766.0], [225.0, 1766.0]], "text": "你想怎么去都没问题。", "confidence": 0.8450189828872681, "needs_review": false}, {"bbox": [[154.0, 1786.0], [190.0, 1786.0], [190.0, 1809.0], [154.0, 1809.0]], "text": "192", "confidence": 0.7290069907903671, "needs_review": false}]