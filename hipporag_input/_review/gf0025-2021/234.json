[{"bbox": [[130.0, 165.0], [300.0, 165.0], [300.0, 188.0], [130.0, 188.0]], "text": "GF0025—2021", "confidence": 0.8128606627384821, "needs_review": false}, {"bbox": [[127.0, 221.0], [281.0, 221.0], [281.0, 248.0], [127.0, 248.0]], "text": "A.6.2.2量词", "confidence": 0.8838084518909455, "needs_review": false}, {"bbox": [[128.0, 286.0], [633.0, 287.0], [633.0, 311.0], [128.0, 310.0]], "text": "【六04】名量词：餐、串、滴、副、股、集、枝", "confidence": 0.8979564879251563, "needs_review": false}, {"bbox": [[221.0, 324.0], [302.0, 324.0], [302.0, 352.0], [221.0, 352.0]], "text": "一餐饭", "confidence": 0.6928402632474899, "needs_review": false}, {"bbox": [[315.0, 325.0], [440.0, 325.0], [440.0, 349.0], [315.0, 349.0]], "text": "一串葡萄", "confidence": 0.7301154732704163, "needs_review": false}, {"bbox": [[475.0, 325.0], [564.0, 325.0], [564.0, 352.0], [475.0, 352.0]], "text": "一滴水", "confidence": 0.6135288029909134, "needs_review": false}, {"bbox": [[592.0, 325.0], [708.0, 325.0], [708.0, 352.0], [592.0, 352.0]], "text": "一副球拍", "confidence": 0.7963263869285584, "needs_review": false}, {"bbox": [[746.0, 324.0], [853.0, 327.0], [853.0, 353.0], [746.0, 351.0]], "text": "一股力量", "confidence": 0.7488831758499146, "needs_review": false}, {"bbox": [[891.0, 325.0], [1021.0, 328.0], [1020.0, 351.0], [891.0, 349.0]], "text": "一集电视剧", "confidence": 0.7939398884773254, "needs_review": false}, {"bbox": [[1047.0, 325.0], [1144.0, 325.0], [1144.0, 352.0], [1047.0, 352.0]], "text": "一枝花", "confidence": 0.5569102913141251, "needs_review": false}, {"bbox": [[128.0, 386.0], [441.0, 387.0], [441.0, 411.0], [128.0, 410.0]], "text": "【六05】动量词：番、声、趟", "confidence": 0.9038963397343953, "needs_review": false}, {"bbox": [[222.0, 426.0], [325.0, 426.0], [325.0, 452.0], [222.0, 452.0]], "text": "讨论一番", "confidence": 0.7562312245368957, "needs_review": false}, {"bbox": [[364.0, 426.0], [443.0, 426.0], [443.0, 453.0], [364.0, 453.0]], "text": "说一声", "confidence": 0.7006068080663681, "needs_review": false}, {"bbox": [[487.0, 426.0], [564.0, 426.0], [564.0, 453.0], [487.0, 453.0]], "text": "跑两趟", "confidence": 0.6826657950878143, "needs_review": false}, {"bbox": [[127.0, 489.0], [280.0, 489.0], [280.0, 516.0], [127.0, 516.0]], "text": "A.6.2.3副词", "confidence": 0.8813167572021484, "needs_review": false}, {"bbox": [[129.0, 555.0], [440.0, 555.0], [440.0, 578.0], [129.0, 578.0]], "text": "【六06】程度副词：特、异常", "confidence": 0.8608823339144389, "needs_review": false}, {"bbox": [[224.0, 593.0], [571.0, 593.0], [571.0, 619.0], [224.0, 619.0]], "text": "他特高兴，因为他的设计获奖了。", "confidence": 0.9140169732272625, "needs_review": false}, {"bbox": [[224.0, 633.0], [427.0, 633.0], [427.0, 659.0], [224.0, 659.0]], "text": "今天天气异常寒冷。", "confidence": 0.8189546763896942, "needs_review": false}, {"bbox": [[127.0, 693.0], [634.0, 694.0], [634.0, 719.0], [127.0, 718.0]], "text": "【六07】范围、协同副词：尽、净、一齐、一同", "confidence": 0.8984075706938038, "needs_review": false}, {"bbox": [[225.0, 736.0], [619.0, 736.0], [619.0, 759.0], [225.0, 759.0]], "text": "刚上班，分配给我的尽是些基础工作。", "confidence": 0.9150779876444075, "needs_review": false}, {"bbox": [[224.0, 778.0], [519.0, 778.0], [519.0, 798.0], [224.0, 798.0]], "text": "这里净是垃圾，都没地方站。", "confidence": 0.8806497028895787, "needs_review": false}, {"bbox": [[223.0, 817.0], [571.0, 817.0], [571.0, 839.0], [223.0, 839.0]], "text": "大家一齐动手，清理路上的垃圾。", "confidence": 0.9050194397568703, "needs_review": false}, {"bbox": [[223.0, 857.0], [496.0, 857.0], [496.0, 880.0], [223.0, 880.0]], "text": "这是我们一同努力的结果。", "confidence": 0.8660663733115563, "needs_review": false}, {"bbox": [[129.0, 916.0], [538.0, 918.0], [538.0, 941.0], [128.0, 939.0]], "text": "【六08】时间副词：时时、一时、早晚", "confidence": 0.9311612750354566, "needs_review": false}, {"bbox": [[226.0, 960.0], [522.0, 960.0], [522.0, 979.0], [226.0, 979.0]], "text": "老师时时关注着我们的学习。", "confidence": 0.8411031109946114, "needs_review": false}, {"bbox": [[224.0, 998.0], [693.0, 998.0], [693.0, 1021.0], [224.0, 1021.0]], "text": "我好像在哪儿见过他，可一时又想不起来了。", "confidence": 0.9386148793356759, "needs_review": false}, {"bbox": [[223.0, 1037.0], [503.0, 1038.0], [503.0, 1064.0], [223.0, 1063.0]], "text": "他早晚会知道事情的真相。", "confidence": 0.8778110559170063, "needs_review": false}, {"bbox": [[130.0, 1097.0], [368.0, 1099.0], [368.0, 1122.0], [129.0, 1121.0]], "text": "【六09】关联副词：便", "confidence": 0.8859668771425883, "needs_review": false}, {"bbox": [[222.0, 1133.0], [435.0, 1139.0], [434.0, 1169.0], [221.0, 1163.0]], "text": "他一下课便回家了。", "confidence": 0.8952964782714844, "needs_review": false}, {"bbox": [[223.0, 1179.0], [446.0, 1177.0], [446.0, 1203.0], [223.0, 1205.0]], "text": "他一毕业便决定回国。", "confidence": 0.8507430661808361, "needs_review": false}, {"bbox": [[128.0, 1237.0], [683.0, 1238.0], [683.0, 1264.0], [128.0, 1263.0]], "text": "【六10】方式副词：不禁、赶忙、亲眼、特地、特意", "confidence": 0.9277004337310791, "needs_review": false}, {"bbox": [[223.0, 1280.0], [618.0, 1280.0], [618.0, 1303.0], [223.0, 1303.0]], "text": "我不禁回忆起第一次跟她见面的场景。", "confidence": 0.9061471886105008, "needs_review": false}, {"bbox": [[224.0, 1321.0], [617.0, 1321.0], [617.0, 1344.0], [224.0, 1344.0]], "text": "要迟到了，他赶忙出门，早饭都没吃。", "confidence": 0.8685414161947038, "needs_review": false}, {"bbox": [[223.0, 1361.0], [571.0, 1361.0], [571.0, 1384.0], [223.0, 1384.0]], "text": "这件事是我亲眼所见，不会有假。", "confidence": 0.9093450792133808, "needs_review": false}, {"bbox": [[224.0, 1402.0], [619.0, 1402.0], [619.0, 1425.0], [224.0, 1425.0]], "text": "我都准备好了，你不用特地跑来帮我。", "confidence": 0.8121290405591329, "needs_review": false}, {"bbox": [[223.0, 1442.0], [667.0, 1442.0], [667.0, 1465.0], [223.0, 1465.0]], "text": "大卫今天第一天上班，特意穿了双新皮鞋。", "confidence": 0.8977154642343521, "needs_review": false}, {"bbox": [[127.0, 1499.0], [392.0, 1499.0], [392.0, 1525.0], [127.0, 1525.0]], "text": "【六11】情态副词：仿佛", "confidence": 0.9139734139809241, "needs_review": false}, {"bbox": [[224.0, 1543.0], [546.0, 1543.0], [546.0, 1566.0], [224.0, 1566.0]], "text": "奶奶仿佛孩子似的开心地笑了。", "confidence": 0.8537745674451193, "needs_review": false}, {"bbox": [[224.0, 1582.0], [570.0, 1584.0], [569.0, 1607.0], [224.0, 1605.0]], "text": "他工作起来仿佛不知道什么是累。", "confidence": 0.9078820645809174, "needs_review": false}, {"bbox": [[127.0, 1641.0], [576.0, 1642.0], [576.0, 1668.0], [127.0, 1667.0]], "text": "【六12】语气副词：才3、刚好、偏、恰好", "confidence": 0.9118371038209825, "needs_review": false}, {"bbox": [[223.0, 1684.0], [618.0, 1684.0], [618.0, 1707.0], [223.0, 1707.0]], "text": "我才不要父母的钱呢，我要自己赚钱。", "confidence": 0.8633287515905168, "needs_review": false}, {"bbox": [[153.0, 1786.0], [190.0, 1786.0], [190.0, 1809.0], [153.0, 1809.0]], "text": "228", "confidence": 0.6559971570968628, "needs_review": false}]