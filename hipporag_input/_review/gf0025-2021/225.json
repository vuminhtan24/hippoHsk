[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.7963699331650367, "needs_review": false}, {"bbox": [[160.0, 222.0], [356.0, 222.0], [356.0, 248.0], [160.0, 248.0]], "text": "【五19】没A没B", "confidence": 0.887107253074646, "needs_review": false}, {"bbox": [[255.0, 263.0], [580.0, 266.0], [579.0, 292.0], [255.0, 289.0]], "text": "一上午没吃没喝，我要饿死了。", "confidence": 0.8797344048817952, "needs_review": false}, {"bbox": [[254.0, 308.0], [723.0, 308.0], [723.0, 330.0], [254.0, 330.0]], "text": "这孩子说话没大没小的，一点儿礼貌都没有。", "confidence": 0.9012419240815299, "needs_review": false}, {"bbox": [[161.0, 371.0], [355.0, 371.0], [355.0, 394.0], [161.0, 394.0]], "text": "【五20】说A就A", "confidence": 0.8576068997383117, "needs_review": false}, {"bbox": [[257.0, 414.0], [676.0, 414.0], [676.0, 437.0], [257.0, 437.0]], "text": "为什么人生需要有一次说走就走的旅行？", "confidence": 0.9357604729501825, "needs_review": false}, {"bbox": [[257.0, 456.0], [603.0, 456.0], [603.0, 479.0], [257.0, 479.0]], "text": "说干就干，只有干才能找到办法。", "confidence": 0.8758316375315189, "needs_review": false}, {"bbox": [[160.0, 517.0], [356.0, 517.0], [356.0, 543.0], [160.0, 543.0]], "text": "【五21】有A有B", "confidence": 0.8690564692020416, "needs_review": false}, {"bbox": [[258.0, 561.0], [676.0, 561.0], [676.0, 583.0], [258.0, 583.0]], "text": "下课了，同学们有说有笑地走出了教室。", "confidence": 0.9059940451069882, "needs_review": false}, {"bbox": [[257.0, 604.0], [817.0, 604.0], [817.0, 624.0], [257.0, 624.0]], "text": "这里的农村有山有水，空气好，农民们过上了好日子。", "confidence": 0.8899198770523071, "needs_review": false}, {"bbox": [[256.0, 645.0], [747.0, 646.0], [747.0, 669.0], [256.0, 668.0]], "text": "节日的公园里有男有女，有老有少，十分热闹。", "confidence": 0.9116603244434703, "needs_review": false}, {"bbox": [[160.0, 708.0], [334.0, 708.0], [334.0, 737.0], [160.0, 737.0]], "text": "A.5.2.1.2其他", "confidence": 0.8747641642888387, "needs_review": false}, {"bbox": [[160.0, 775.0], [329.0, 775.0], [329.0, 801.0], [160.0, 801.0]], "text": "【五22】不得了", "confidence": 0.8636686404546102, "needs_review": false}, {"bbox": [[258.0, 821.0], [577.0, 821.0], [577.0, 840.0], [258.0, 840.0]], "text": "你又考了第一名，真是不得了！", "confidence": 0.8758907675743103, "needs_review": false}, {"bbox": [[257.0, 861.0], [530.0, 861.0], [530.0, 884.0], [257.0, 884.0]], "text": "不得了了，房间里进水了。", "confidence": 0.8507305383682251, "needs_review": false}, {"bbox": [[256.0, 904.0], [601.0, 904.0], [601.0, 927.0], [256.0, 927.0]], "text": "完了完了，不得了了，电脑坏了。", "confidence": 0.9078913480043411, "needs_review": false}, {"bbox": [[161.0, 967.0], [328.0, 967.0], [328.0, 989.0], [161.0, 989.0]], "text": "【五23】不敢当", "confidence": 0.8792290488878886, "needs_review": false}, {"bbox": [[256.0, 1009.0], [535.0, 1009.0], [535.0, 1032.0], [256.0, 1032.0]], "text": "这样的奖励我真是不敢当。", "confidence": 0.8953816248820379, "needs_review": false}, {"bbox": [[254.0, 1049.0], [651.0, 1051.0], [651.0, 1077.0], [254.0, 1075.0]], "text": "不敢当，我只是做了我应该做的事情。", "confidence": 0.9163371158970727, "needs_review": false}, {"bbox": [[256.0, 1092.0], [626.0, 1095.0], [626.0, 1117.0], [256.0, 1115.0]], "text": "您千万别这样说，我实在是不敢当。", "confidence": 0.8828324780744665, "needs_review": false}, {"bbox": [[159.0, 1153.0], [303.0, 1153.0], [303.0, 1180.0], [159.0, 1180.0]], "text": "【五24】得了", "confidence": 0.7830024734139442, "needs_review": false}, {"bbox": [[255.0, 1196.0], [579.0, 1197.0], [579.0, 1224.0], [255.0, 1223.0]], "text": "麻烦别人还不如你自己去得了。", "confidence": 0.8873594840367635, "needs_review": false}, {"bbox": [[257.0, 1241.0], [581.0, 1241.0], [581.0, 1264.0], [257.0, 1264.0]], "text": "得了吧，他不可能帮助别人的。", "confidence": 0.8713205615679424, "needs_review": false}, {"bbox": [[257.0, 1281.0], [556.0, 1283.0], [555.0, 1308.0], [257.0, 1306.0]], "text": "你可得了吧，谁能这么想呢？", "confidence": 0.8640153237751552, "needs_review": false}, {"bbox": [[160.0, 1345.0], [330.0, 1345.0], [330.0, 1370.0], [160.0, 1370.0]], "text": "【五25】用不着", "confidence": 0.8719592226876153, "needs_review": false}, {"bbox": [[256.0, 1387.0], [602.0, 1387.0], [602.0, 1410.0], [256.0, 1410.0]], "text": "你有话可以直接说，用不着害怕。", "confidence": 0.8429291620850563, "needs_review": false}, {"bbox": [[257.0, 1431.0], [578.0, 1431.0], [578.0, 1454.0], [257.0, 1454.0]], "text": "用不着听他的，他什么都不懂。", "confidence": 0.8721228877703349, "needs_review": false}, {"bbox": [[256.0, 1474.0], [626.0, 1474.0], [626.0, 1496.0], [256.0, 1496.0]], "text": "孩子们都工作了，您用不着担心了。", "confidence": 0.8949069065206191, "needs_review": false}, {"bbox": [[160.0, 1539.0], [248.0, 1539.0], [248.0, 1563.0], [160.0, 1563.0]], "text": "A.5.3", "confidence": 0.7529993851979574, "needs_review": false}, {"bbox": [[237.0, 1538.0], [341.0, 1538.0], [341.0, 1562.0], [237.0, 1562.0]], "text": "固定格式", "confidence": 0.7993871450424195, "needs_review": false}, {"bbox": [[160.0, 1603.0], [377.0, 1603.0], [377.0, 1628.0], [160.0, 1628.0]], "text": "【五26】从··…··来看", "confidence": 0.7075950311762946, "needs_review": false}, {"bbox": [[258.0, 1647.0], [674.0, 1647.0], [674.0, 1670.0], [258.0, 1670.0]], "text": "从这个角度来看，很多问题都可以解决。", "confidence": 0.857439492878161, "needs_review": false}, {"bbox": [[259.0, 1691.0], [772.0, 1691.0], [772.0, 1711.0], [259.0, 1711.0]], "text": "从他的考试成绩来看，他平时根本没有认真学习。", "confidence": 0.9082460066546565, "needs_review": false}, {"bbox": [[259.0, 1734.0], [721.0, 1734.0], [721.0, 1753.0], [259.0, 1753.0]], "text": "从以往的经验来看，这件事基本上没有问题。", "confidence": 0.8960699353899274, "needs_review": false}, {"bbox": [[1178.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1178.0, 1809.0]], "text": "219", "confidence": 0.6228460818529129, "needs_review": false}]