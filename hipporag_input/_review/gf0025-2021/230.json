.756144767999649, "needs_review": false}, {"bbox": [[225.0, 1396.0], [713.0, 1396.0], [713.0, 1416.0], [225.0, 1416.0]], "text": "我们要早一点儿出门，以便乘坐第一班公交车。", "confidence": 0.8874504105611281, "needs_review": false}, {"bbox": [[224.0, 1435.0], [571.0, 1435.0], [571.0, 1458.0], [224.0, 1458.0]], "text": "她每天步行上班，以便锻炼身体。", "confidence": 0.9241715148091316, "needs_review": false}, {"bbox": [[223.0, 1475.0], [571.0, 1475.0], [571.0, 1497.0], [223.0, 1497.0]], "text": "把手机号留下吧，以便跟你联系。", "confidence": 0.8863639645278454, "needs_review": false}, {"bbox": [[128.0, 1536.0], [347.0, 1536.0], [347.0, 1562.0], [128.0, 1562.0]], "text": "A.5.5.2.8紧缩复句", "confidence": 0.9230067474501473, "needs_review": false}, {"bbox": [[127.0, 1598.0], [431.0, 1597.0], [431.0, 1622.0], [127.0, 1623.0]], "text": "【五54】没有·····就没有····", "confidence": 0.6560061484575271, "needs_review": false}, {"bbox": [[224.0, 1639.0], [546.0, 1639.0], [546.0, 1662.0], [224.0, 1662.0]], "text": "没有你的帮助就没有我的成功。", "confidence": 0.8997386852900188, "needs_review": false}, {"bbox": [[224.0, 1679.0], [498.0, 1679.0], [498.0, 1702.0], [224.0, 1702.0]], "text": "没有水就没有生命的存在。", "confidence": 0.9096247599675105, "needs_review": false}, {"bbox": [[224.0, 1718.0], [593.0, 1718.0], [593.0, 1741.0], [224.0, 1741.0]], "text": "没有平时的努力就没有今天的成绩。", "confidence": 0.9159446779419395, "needs_review": false}, {"bbox": [[153.0, 1786.0], [191.0, 1786.0], [191.0, 1809.0], [153.0, 1809.0]], "text": "224", "confidence": 0.6594241559505463, "needs_review": false}]