[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.796912417962001, "needs_review": false}, {"bbox": [[161.0, 223.0], [364.0, 223.0], [364.0, 246.0], [161.0, 246.0]], "text": "【七一九041】索性", "confidence": 0.8480427807027643, "needs_review": false}, {"bbox": [[318.0, 263.0], [976.0, 263.0], [976.0, 286.0], [318.0, 286.0]], "text": "衣服已经被雨淋湿了，我索性就合上了伞，直接在雨中散步了。", "confidence": 0.8999725929621992, "needs_review": false}, {"bbox": [[317.0, 301.0], [904.0, 301.0], [904.0, 323.0], [317.0, 323.0]], "text": "现在已经很晚了，我索性直接在外面吃完饭再回家好了。", "confidence": 0.8990858953732711, "needs_review": false}, {"bbox": [[160.0, 359.0], [363.0, 359.0], [363.0, 385.0], [160.0, 385.0]], "text": "【七一九042】万万", "confidence": 0.8044774017550729, "needs_review": false}, {"bbox": [[318.0, 400.0], [567.0, 400.0], [567.0, 423.0], [318.0, 423.0]], "text": "万万不能开着煤气出门。", "confidence": 0.8653749326864878, "needs_review": false}, {"bbox": [[318.0, 439.0], [665.0, 439.0], [665.0, 461.0], [318.0, 461.0]], "text": "触犯法律的事情是万万干不得的。", "confidence": 0.8479188233613968, "needs_review": false}, {"bbox": [[161.0, 497.0], [364.0, 497.0], [364.0, 520.0], [161.0, 520.0]], "text": "【七一九043】未免", "confidence": 0.8445055159655485, "needs_review": false}, {"bbox": [[318.0, 537.0], [566.0, 537.0], [566.0, 560.0], [318.0, 560.0]], "text": "这道题未免也太难了吧。", "confidence": 0.8768662512302399, "needs_review": false}, {"bbox": [[319.0, 576.0], [640.0, 576.0], [640.0, 598.0], [319.0, 598.0]], "text": "你这样说她，未免也太过分了。", "confidence": 0.8965926567713419, "needs_review": false}, {"bbox": [[161.0, 634.0], [363.0, 634.0], [363.0, 657.0], [161.0, 657.0]], "text": "【七一九044】无非", "confidence": 0.85096660527316, "needs_review": false}, {"bbox": [[319.0, 673.0], [687.0, 673.0], [687.0, 696.0], [319.0, 696.0]], "text": "他这么做，无非是为了早点儿回家。", "confidence": 0.8775080828105702, "needs_review": false}, {"bbox": [[318.0, 712.0], [663.0, 712.0], [663.0, 735.0], [318.0, 735.0]], "text": "她想要的无非是一份稳定的工作。", "confidence": 0.8801860697567463, "needs_review": false}, {"bbox": [[160.0, 769.0], [364.0, 769.0], [364.0, 795.0], [160.0, 795.0]], "text": "【七一九045】幸好", "confidence": 0.8215529322624207, "needs_review": false}, {"bbox": [[317.0, 808.0], [813.0, 810.0], [813.0, 836.0], [317.0, 834.0]], "text": "他来的时候，幸好我在家，不然他又该生气了。", "confidence": 0.9040071910077875, "needs_review": false}, {"bbox": [[318.0, 849.0], [664.0, 849.0], [664.0, 872.0], [318.0, 872.0]], "text": "幸好你提醒了我，要不我就忘了。", "confidence": 0.8930975571274757, "needs_review": false}, {"bbox": [[161.0, 906.0], [364.0, 906.0], [364.0, 932.0], [161.0, 932.0]], "text": "【七一九046】幸亏", "confidence": 0.8091628822413358, "needs_review": false}, {"bbox": [[318.0, 947.0], [821.0, 947.0], [821.0, 969.0], [318.0, 969.0]], "text": "幸亏你回来得早，不然我就不知道怎么办才好了", "confidence": 0.9052873470566489, "needs_review": false}, {"bbox": [[318.0, 986.0], [722.0, 986.0], [722.0, 1009.0], [318.0, 1009.0]], "text": "我们幸亏走了这条路，才没碰到堵车。", "confidence": 0.8886990182929568, "needs_review": false}, {"bbox": [[160.0, 1043.0], [365.0, 1043.0], [365.0, 1069.0], [160.0, 1069.0]], "text": "【七一九047】终究", "confidence": 0.8509418964385986, "needs_review": false}, {"bbox": [[319.0, 1083.0], [690.0, 1083.0], [690.0, 1108.0], [319.0, 1108.0]], "text": "他终究是个孩子，你得耐心一点儿。", "confidence": 0.9381356695119072, "needs_review": false}, {"bbox": [[318.0, 1121.0], [786.0, 1121.0], [786.0, 1147.0], [318.0, 1147.0]], "text": "你们对工作这么不负责任，终究会出问题的。", "confidence": 0.9332735652015323, "needs_review": false}, {"bbox": [[161.0, 1185.0], [244.0, 1185.0], [244.0, 1209.0], [161.0, 1209.0]], "text": "A.7.1.5", "confidence": 0.8524245098233223, "needs_review": false}, {"bbox": [[257.0, 1183.0], [312.0, 1183.0], [312.0, 1209.0], [257.0, 1209.0]], "text": "介词", "confidence": 0.6616874734560648, "needs_review": false}, {"bbox": [[161.0, 1247.0], [275.0, 1247.0], [275.0, 1270.0], [161.0, 1270.0]], "text": "A.7.1.5.1", "confidence": 0.8601013720035553, "needs_review": false}, {"bbox": [[280.0, 1245.0], [451.0, 1245.0], [451.0, 1271.0], [280.0, 1271.0]], "text": "引出方向、路径", "confidence": 0.7823695465922356, "needs_review": false}, {"bbox": [[161.0, 1309.0], [363.0, 1309.0], [363.0, 1332.0], [161.0, 1332.0]], "text": "【七一九048】顺着", "confidence": 0.8645543510263617, "needs_review": false}, {"bbox": [[317.0, 1347.0], [614.0, 1348.0], [614.0, 1371.0], [317.0, 1370.0]], "text": "雨水顺着我的头发滴了下来。", "confidence": 0.8962083629199437, "needs_review": false}, {"bbox": [[319.0, 1388.0], [734.0, 1388.0], [734.0, 1408.0], [319.0, 1408.0]], "text": "我们就顺着这条路走，走到哪儿算哪儿。", "confidence": 0.902612240690934, "needs_review": false}, {"bbox": [[161.0, 1448.0], [378.0, 1448.0], [378.0, 1474.0], [161.0, 1474.0]], "text": "A.7.1.5.2引出对象", "confidence": 0.8817549135003772, "needs_review": false}, {"bbox": [[160.0, 1509.0], [364.0, 1509.0], [364.0, 1535.0], [160.0, 1535.0]], "text": "【七一九049】当着", "confidence": 0.8421303738247264, "needs_review": false}, {"bbox": [[319.0, 1550.0], [784.0, 1550.0], [784.0, 1573.0], [319.0, 1573.0]], "text": "当着我的面，你有什么想说的就都说出来吧。", "confidence": 0.9203571847506932, "needs_review": false}, {"bbox": [[318.0, 1589.0], [639.0, 1589.0], [639.0, 1612.0], [318.0, 1612.0]], "text": "我当着大家的面把礼物拆开了。", "confidence": 0.8616497119267782, "needs_review": false}, {"bbox": [[159.0, 1646.0], [356.0, 1643.0], [357.0, 1670.0], [160.0, 1673.0]], "text": "【七一九050】就5", "confidence": 0.8164766810157082, "needs_review": false}, {"bbox": [[319.0, 1687.0], [590.0, 1687.0], [590.0, 1710.0], [319.0, 1710.0]], "text": "他已就这个问题做了检讨。", "confidence": 0.9095541192935064, "needs_review": false}, {"bbox": [[318.0, 1726.0], [856.0, 1726.0], [856.0, 1748.0], [318.0, 1748.0]], "text": "我想就如何找到自已满意的工作这个问题来谈一谈。", "confidence": 0.8875884960095087, "needs_review": false}, {"bbox": [[1178.0, 1786.0], [1215.0, 1786.0], [1215.0, 1809.0], [1178.0, 1809.0]], "text": "241", "confidence": 0.6419995129108429, "needs_review": false}]