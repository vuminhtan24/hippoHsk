[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.8083363267091604, "needs_review": false}, {"bbox": [[162.0, 223.0], [364.0, 223.0], [364.0, 246.0], [162.0, 246.0]], "text": "【七一九021】再度", "confidence": 0.8212641315026716, "needs_review": false}, {"bbox": [[317.0, 264.0], [674.0, 264.0], [674.0, 287.0], [317.0, 287.0]], "text": "这个班再度被评为“优秀班集体”。", "confidence": 0.9061080603038564, "needs_review": false}, {"bbox": [[319.0, 305.0], [614.0, 305.0], [614.0, 324.0], [319.0, 324.0]], "text": "两位好友三十年后再度相遇。", "confidence": 0.8535791976111275, "needs_review": false}, {"bbox": [[161.0, 366.0], [377.0, 364.0], [377.0, 388.0], [161.0, 390.0]], "text": "A.7.1.4.5关联副词", "confidence": 0.8550708762237004, "needs_review": false}, {"bbox": [[160.0, 427.0], [341.0, 427.0], [341.0, 452.0], [160.0, 452.0]], "text": "【七一九022】亦", "confidence": 0.7961762845516205, "needs_review": false}, {"bbox": [[317.0, 466.0], [785.0, 467.0], [785.0, 490.0], [317.0, 489.0]], "text": "此人并不存在，将来亦不会出现，永远不会。", "confidence": 0.8709533299718585, "needs_review": false}, {"bbox": [[318.0, 506.0], [736.0, 506.0], [736.0, 529.0], [318.0, 529.0]], "text": "若能从失败中获得教训，失败亦是成功。", "confidence": 0.9147417513947738, "needs_review": false}, {"bbox": [[161.0, 567.0], [379.0, 567.0], [379.0, 592.0], [161.0, 592.0]], "text": "A.7.1.4.6否定副词", "confidence": 0.8944090008735657, "needs_review": false}, {"bbox": [[159.0, 628.0], [340.0, 626.0], [341.0, 653.0], [160.0, 655.0]], "text": "【七一九023】未", "confidence": 0.7938336253166198, "needs_review": false}, {"bbox": [[319.0, 670.0], [546.0, 670.0], [546.0, 693.0], [319.0, 693.0]], "text": "他至今还未和我联系。", "confidence": 0.9062915227629922, "needs_review": false}, {"bbox": [[317.0, 708.0], [783.0, 708.0], [783.0, 730.0], [317.0, 730.0]], "text": "虽然他四十未到，但已经是很成熟的经理了。", "confidence": 0.9210055725915092, "needs_review": false}, {"bbox": [[160.0, 765.0], [340.0, 765.0], [340.0, 791.0], [160.0, 791.0]], "text": "【七一九024】勿", "confidence": 0.7711130857467652, "needs_review": false}, {"bbox": [[318.0, 807.0], [615.0, 807.0], [615.0, 830.0], [318.0, 830.0]], "text": "希望各位勿忘十年后的约定。", "confidence": 0.8654857533318656, "needs_review": false}, {"bbox": [[318.0, 845.0], [615.0, 845.0], [615.0, 868.0], [318.0, 868.0]], "text": "我在国外一切都很好，勿念。", "confidence": 0.879043881382261, "needs_review": false}, {"bbox": [[161.0, 906.0], [379.0, 906.0], [379.0, 932.0], [161.0, 932.0]], "text": "A.7.1.4.7方式副词", "confidence": 0.8556273835045951, "needs_review": false}, {"bbox": [[160.0, 968.0], [389.0, 968.0], [389.0, 993.0], [160.0, 993.0]], "text": "【七一九025】不由得", "confidence": 0.8282122959693273, "needs_review": false}, {"bbox": [[317.0, 1007.0], [762.0, 1007.0], [762.0, 1033.0], [317.0, 1033.0]], "text": "看着父亲粗糙的手，我不由得流下了眼泪。", "confidence": 0.9162487775087357, "needs_review": false}, {"bbox": [[318.0, 1047.0], [735.0, 1047.0], [735.0, 1070.0], [318.0, 1070.0]], "text": "看着毕业照，我不由得开始回忆起往事。", "confidence": 0.8842129832819888, "needs_review": false}, {"bbox": [[160.0, 1104.0], [365.0, 1104.0], [365.0, 1130.0], [160.0, 1130.0]], "text": "【七一九026】顺便", "confidence": 0.8329237536950544, "needs_review": false}, {"bbox": [[316.0, 1143.0], [833.0, 1144.0], [833.0, 1170.0], [316.0, 1169.0]], "text": "去老师办公室的时候，他顺便把我的作业也交了。", "confidence": 0.9052211149879124, "needs_review": false}, {"bbox": [[317.0, 1183.0], [712.0, 1183.0], [712.0, 1209.0], [317.0, 1209.0]], "text": "我到了上海，顺便去看望了小学老师。", "confidence": 0.9017444418536292, "needs_review": false}, {"bbox": [[160.0, 1241.0], [365.0, 1241.0], [365.0, 1267.0], [160.0, 1267.0]], "text": "【七一九027】一连", "confidence": 0.8021659525957975, "needs_review": false}, {"bbox": [[317.0, 1282.0], [929.0, 1282.0], [929.0, 1305.0], [317.0, 1305.0]], "text": "这场大雨一连下了十多天，也就把工人们困在这里十多天。", "confidence": 0.9164736602041457, "needs_review": false}, {"bbox": [[319.0, 1321.0], [1049.0, 1321.0], [1049.0, 1344.0], [319.0, 1344.0]], "text": "他上了床，在一连三天三夜没睡好以后终于能舒舒服服地睡上一觉了。", "confidence": 0.9263271652162075, "needs_review": false}, {"bbox": [[161.0, 1381.0], [379.0, 1381.0], [379.0, 1407.0], [161.0, 1407.0]], "text": "A.7.1.4.8情态副词", "confidence": 0.8982069620064327, "needs_review": false}, {"bbox": [[161.0, 1445.0], [364.0, 1445.0], [364.0, 1468.0], [161.0, 1468.0]], "text": "【七一九028】按说", "confidence": 0.8676326437429949, "needs_review": false}, {"bbox": [[319.0, 1485.0], [929.0, 1485.0], [929.0, 1505.0], [319.0, 1505.0]], "text": "按说现在是蔬菜供应淡季，可是这里的蔬菜种类还是不少。", "confidence": 0.9311333828502231, "needs_review": false}, {"bbox": [[318.0, 1523.0], [832.0, 1523.0], [832.0, 1546.0], [318.0, 1546.0]], "text": "按说这个时候应该下雪了，可今年一场雪还没下。", "confidence": 0.9338712355364924, "needs_review": false}, {"bbox": [[161.0, 1583.0], [378.0, 1583.0], [378.0, 1610.0], [161.0, 1610.0]], "text": "A.7.1.4.9语气副词", "confidence": 0.8307211441653115, "needs_review": false}, {"bbox": [[160.0, 1645.0], [364.0, 1645.0], [364.0, 1671.0], [160.0, 1671.0]], "text": "【七一九029】必定", "confidence": 0.7980182712728326, "needs_review": false}, {"bbox": [[317.0, 1687.0], [952.0, 1687.0], [952.0, 1710.0], [317.0, 1710.0]], "text": "若是有个太太照顾着他，他的生活必定不会那么乱七八糟了。", "confidence": 0.9034302766833987, "needs_review": false}, {"bbox": [[319.0, 1726.0], [832.0, 1726.0], [832.0, 1748.0], [319.0, 1748.0]], "text": "尚若他们想要人为地挽救这一文明，必定会失败。", "confidence": 0.863933467346689, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1179.0, 1809.0]], "text": "239", "confidence": 0.7449937909841537, "needs_review": false}]