8, "needs_review": false}, {"bbox": [[159.0, 798.0], [341.0, 796.0], [342.0, 823.0], [160.0, 825.0]], "text": "A.2.3固定格式", "confidence": 0.859155786037445, "needs_review": false}, {"bbox": [[162.0, 864.0], [376.0, 864.0], [376.0, 887.0], [162.0, 887.0]], "text": "【二45】还是·····吧", "confidence": 0.7085388004779816, "needs_review": false}, {"bbox": [[255.0, 907.0], [576.0, 907.0], [576.0, 930.0], [255.0, 930.0]], "text": "打车太贵了，你还是坐地铁吧。", "confidence": 0.8419501145680746, "needs_review": false}, {"bbox": [[256.0, 949.0], [675.0, 950.0], [675.0, 973.0], [256.0, 972.0]], "text": "外边下雨了，我们还是在房间看电视吧。", "confidence": 0.9098171936838251, "needs_review": false}, {"bbox": [[160.0, 1011.0], [395.0, 1009.0], [395.0, 1035.0], [160.0, 1037.0]], "text": "[二 46】 又···.··又···.", "confidence": 0.5851373419165611, "needs_review": false}, {"bbox": [[254.0, 1053.0], [551.0, 1051.0], [552.0, 1077.0], [254.0, 1079.0]], "text": "这个饭馆的菜又好吃又便宜。", "confidence": 0.8730317311627525, "needs_review": false}, {"bbox": [[255.0, 1098.0], [482.0, 1098.0], [482.0, 1120.0], [255.0, 1120.0]], "text": "这球鞋又贵又不好看。", "confidence": 0.8095907677303661, "needs_review": false}, {"bbox": [[161.0, 1156.0], [567.0, 1156.0], [567.0, 1182.0], [161.0, 1182.0]], "text": "【二47】（在）…·以前／以后／前／后", "confidence": 0.8183074802160263, "needs_review": false}, {"bbox": [[257.0, 1202.0], [653.0, 1202.0], [653.0, 1225.0], [257.0, 1225.0]], "text": "在来中国以前我只学过一点儿中文。", "confidence": 0.8277168624541339, "needs_review": false}, {"bbox": [[256.0, 1242.0], [623.0, 1242.0], [623.0, 1268.0], [256.0, 1268.0]], "text": "吃完午饭以后，我常常会睡一会儿。", "confidence": 0.842769535148845, "needs_review": false}, {"bbox": [[257.0, 1285.0], [579.0, 1285.0], [579.0, 1311.0], [257.0, 1311.0]], "text": "你运动前应该活动一下儿身体。", "confidence": 0.9258436640103658, "needs_review": false}, {"bbox": [[257.0, 1330.0], [523.0, 1330.0], [523.0, 1353.0], [257.0, 1353.0]], "text": "我明天下课后就去你那儿", "confidence": 0.9020434568325678, "needs_review": false}, {"bbox": [[160.0, 1393.0], [341.0, 1393.0], [341.0, 1419.0], [160.0, 1419.0]], "text": "A.2.4句子成分", "confidence": 0.8534623861312867, "needs_review": false}, {"bbox": [[159.0, 1457.0], [315.0, 1457.0], [315.0, 1486.0], [159.0, 1486.0]], "text": "A.2.4.1谓语", "confidence": 0.7459703028202057, "needs_review": false}, {"bbox": [[162.0, 1525.0], [787.0, 1525.0], [787.0, 1548.0], [162.0, 1548.0]], "text": "【二48】名词、代词、数词或数量短语、名词性短语作谓语", "confidence": 0.9309956771986825, "needs_review": false}, {"bbox": [[255.0, 1564.0], [364.0, 1566.0], [363.0, 1593.0], [255.0, 1591.0]], "text": "今天晴天。", "confidence": 0.7569063603878021, "needs_review": false}, {"bbox": [[255.0, 1606.0], [388.0, 1609.0], [388.0, 1635.0], [255.0, 1633.0]], "text": "明天星期五。", "confidence": 0.8395875607218061, "needs_review": false}, {"bbox": [[256.0, 1652.0], [389.0, 1652.0], [389.0, 1676.0], [256.0, 1676.0]], "text": "这儿怎么样？", "confidence": 0.7775307297706604, "needs_review": false}, {"bbox": [[255.0, 1693.0], [453.0, 1695.0], [453.0, 1725.0], [255.0, 1723.0]], "text": "他四十，女儿十六，", "confidence": 0.8485226988792419, "needs_review": false}, {"bbox": [[255.0, 1737.0], [483.0, 1738.0], [483.0, 1761.0], [255.0, 1760.0]], "text": "这本中文书二十五块。", "confidence": 0.8828240849755027, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1179.0, 1809.0]], "text": "185", "confidence": 0.7312947362661362, "needs_review": false}]