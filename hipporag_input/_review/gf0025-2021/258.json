[{"bbox": [[131.0, 167.0], [299.0, 167.0], [299.0, 187.0], [131.0, 187.0]], "text": "GF00252021", "confidence": 0.9028564637357538, "needs_review": false}, {"bbox": [[287.0, 225.0], [652.0, 225.0], [652.0, 245.0], [287.0, 245.0]], "text": "你也罢，我也罢，都帮不了什么忙。", "confidence": 0.853959891725989, "needs_review": false}, {"bbox": [[285.0, 266.0], [727.0, 266.0], [727.0, 289.0], [285.0, 289.0]], "text": "喜欢也罢，愤怒也罢，终究都是一种情绪。", "confidence": 0.9175194174051284, "needs_review": false}, {"bbox": [[127.0, 324.0], [498.0, 324.0], [498.0, 350.0], [127.0, 350.0]], "text": "【七一九133】×了又Y，Y了又X", "confidence": 0.7295311507251527, "needs_review": false}, {"bbox": [[286.0, 367.0], [703.0, 367.0], [703.0, 390.0], [286.0, 390.0]], "text": "他装了又拆，拆了又装，修理了一整天。", "confidence": 0.8998588229480543, "needs_review": false}, {"bbox": [[286.0, 409.0], [849.0, 409.0], [849.0, 432.0], [286.0, 432.0]], "text": "小朋友写了又擦，擦了又写，正在认真地练习写汉字。", "confidence": 0.9203973293304444, "needs_review": false}, {"bbox": [[126.0, 467.0], [599.0, 466.0], [599.0, 493.0], [126.0, 494.0]], "text": "【七一九134】X也X不...，Y也Y不...", "confidence": 0.7054331041872501, "needs_review": false}, {"bbox": [[285.0, 511.0], [849.0, 511.0], [849.0, 534.0], [285.0, 534.0]], "text": "妈妈还处于担心的状态中，吃也吃不下，睡也睡不着。", "confidence": 0.9135853958129883, "needs_review": false}, {"bbox": [[285.0, 553.0], [874.0, 553.0], [874.0, 576.0], [285.0, 576.0]], "text": "父母与孩子的关系就是这样，赶也赶不走，留也留不住。", "confidence": 0.9158082352234767, "needs_review": false}, {"bbox": [[129.0, 613.0], [479.0, 613.0], [479.0, 636.0], [129.0, 636.0]], "text": "【七一九135】别提（有）多×了", "confidence": 0.838816200985628, "needs_review": false}, {"bbox": [[286.0, 655.0], [656.0, 655.0], [656.0, 678.0], [286.0, 678.0]], "text": "刚才买的那件衣服，别提多好看了。", "confidence": 0.9012337923049927, "needs_review": false}, {"bbox": [[287.0, 698.0], [678.0, 698.0], [678.0, 717.0], [287.0, 717.0]], "text": "听到爸爸的声音，她别提有多兴奋了。", "confidence": 0.8707414368788401, "needs_review": false}, {"bbox": [[128.0, 757.0], [382.0, 757.0], [382.0, 780.0], [128.0, 780.0]], "text": "【七一九136】不知×的", "confidence": 0.8719141070659344, "needs_review": false}, {"bbox": [[283.0, 797.0], [704.0, 798.0], [704.0, 824.0], [283.0, 823.0]], "text": "不知怎么的，我的眼泪止不住地往下流。", "confidence": 0.9024770793161894, "needs_review": false}, {"bbox": [[285.0, 839.0], [560.0, 839.0], [560.0, 862.0], [285.0, 862.0]], "text": "不知谁说的，他才是凶手。", "confidence": 0.870059453524076, "needs_review": false}, {"bbox": [[124.0, 897.0], [708.0, 891.0], [708.0, 927.0], [125.0, 933.0]], "text": "【七一九137】话（说）是这么说，不过／可／可是….．．", "confidence": 0.8603442506543522, "needs_review": false}, {"bbox": [[285.0, 942.0], [633.0, 941.0], [633.0, 965.0], [285.0, 966.0]], "text": "话是这么说，不过她还是不习惯。", "confidence": 0.9230753667652607, "needs_review": false}, {"bbox": [[285.0, 982.0], [897.0, 982.0], [897.0, 1008.0], [285.0, 1008.0]], "text": "说是这么说，可对方要是真这么干，那我们也做不了什么。", "confidence": 0.9043954831582529, "needs_review": false}, {"bbox": [[128.0, 1044.0], [506.0, 1045.0], [506.0, 1069.0], [128.0, 1068.0]], "text": "【七一九138】看／瞧你那（×）样", "confidence": 0.8761881556775835, "needs_review": false}, {"bbox": [[284.0, 1085.0], [825.0, 1085.0], [825.0, 1110.0], [284.0, 1110.0]], "text": "看你那伤心样，还以为你这回真的好不到哪里去了。", "confidence": 0.9525334934393564, "needs_review": false}, {"bbox": [[286.0, 1127.0], [511.0, 1127.0], [511.0, 1150.0], [286.0, 1150.0]], "text": "瞧你那样，还挺得意。", "confidence": 0.9007253701036627, "needs_review": false}, {"bbox": [[129.0, 1189.0], [455.0, 1189.0], [455.0, 1212.0], [129.0, 1212.0]], "text": "【七一九139】看在×的面子上", "confidence": 0.8798514306545258, "needs_review": false}, {"bbox": [[283.0, 1227.0], [610.0, 1229.0], [610.0, 1254.0], [283.0, 1253.0]], "text": "我是看在她的面子上才答应的。", "confidence": 0.8670386830965678, "needs_review": false}, {"bbox": [[286.0, 1271.0], [679.0, 1271.0], [679.0, 1294.0], [286.0, 1294.0]], "text": "三位客人看在老人的面子上又坐下了。", "confidence": 0.9316165016757118, "needs_review": false}, {"bbox": [[128.0, 1331.0], [656.0, 1332.0], [656.0, 1356.0], [128.0, 1354.0]], "text": "【七一九140】哪有X这么Y的/有×这样Y的吗", "confidence": 0.8370424409707388, "needs_review": false}, {"bbox": [[286.0, 1373.0], [704.0, 1373.0], [704.0, 1396.0], [286.0, 1396.0]], "text": "哪有你这么过分的？好处全让你给占了。", "confidence": 0.8830616536893343, "needs_review": false}, {"bbox": [[286.0, 1415.0], [703.0, 1415.0], [703.0, 1438.0], [286.0, 1438.0]], "text": "哪有你这么直接的？给他留点儿面子呀。", "confidence": 0.8915132723356548, "needs_review": false}, {"bbox": [[286.0, 1458.0], [751.0, 1458.0], [751.0, 1478.0], [286.0, 1478.0]], "text": "有他这样做人的吗？总是在背后说人家坏话。", "confidence": 0.8921458437329247, "needs_review": false}, {"bbox": [[128.0, 1517.0], [436.0, 1517.0], [436.0, 1540.0], [128.0, 1540.0]], "text": "【七一九141】什么×的Y的", "confidence": 0.8832826296488444, "needs_review": false}, {"bbox": [[286.0, 1559.0], [583.0, 1559.0], [583.0, 1582.0], [286.0, 1582.0]], "text": "什么你的我的，都是大家的。", "confidence": 0.9013449336801257, "needs_review": false}, {"bbox": [[286.0, 1600.0], [681.0, 1600.0], [681.0, 1622.0], [286.0, 1622.0]], "text": "什么好的坏的，我们买的都是一样的。", "confidence": 0.9052053491274515, "needs_review": false}, {"bbox": [[128.0, 1661.0], [494.0, 1661.0], [494.0, 1684.0], [128.0, 1684.0]], "text": "【七一九142】说到／想到哪儿去了", "confidence": 0.8654760056071811, "needs_review": false}, {"bbox": [[286.0, 1703.0], [799.0, 1703.0], [799.0, 1726.0], [286.0, 1726.0]], "text": "你看你，说到哪儿去了，我说的是买蛋糕的问题。", "confidence": 0.89645974273267, "needs_review": false}, {"bbox": [[288.0, 1745.0], [726.0, 1745.0], [726.0, 1765.0], [288.0, 1765.0]], "text": "你想到哪儿去了！我肯定不会跟别人说的。", "confidence": 0.8910869121551513, "needs_review": false}, {"bbox": [[153.0, 1786.0], [190.0, 1786.0], [190.0, 1809.0], [153.0, 1809.0]], "text": "252", "confidence": 0.6589280068874359, "needs_review": false}]