[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.7792374812639676, "needs_review": false}, {"bbox": [[161.0, 222.0], [342.0, 222.0], [342.0, 248.0], [161.0, 248.0]], "text": "A.4.8口语格式", "confidence": 0.8976387679576874, "needs_review": false}, {"bbox": [[162.0, 286.0], [380.0, 286.0], [380.0, 309.0], [162.0, 309.0]], "text": "【四67】不×白不×", "confidence": 0.7602769407359037, "needs_review": false}, {"bbox": [[257.0, 323.0], [602.0, 323.0], [602.0, 346.0], [257.0, 346.0]], "text": "今天班长请客，咱们不吃白不吃。", "confidence": 0.8628044798970222, "needs_review": false}, {"bbox": [[256.0, 363.0], [868.0, 363.0], [868.0, 386.0], [256.0, 386.0]], "text": "这个电影是免费的，我们为什么不去看电影？不看白不看。", "confidence": 0.9052647440521805, "needs_review": false}, {"bbox": [[161.0, 421.0], [456.0, 421.0], [456.0, 447.0], [161.0, 447.0]], "text": "【四68】动词+一X是一X", "confidence": 0.7817404993942806, "needs_review": false}, {"bbox": [[256.0, 461.0], [723.0, 461.0], [723.0, 484.0], [256.0, 484.0]], "text": "虽然日子过得很难，但也不能过一天是一天。", "confidence": 0.9185777079491388, "needs_review": false}, {"bbox": [[257.0, 500.0], [650.0, 500.0], [650.0, 523.0], [257.0, 523.0]], "text": "事情实在太多了，能做一件是一件吧。", "confidence": 0.8662749760680728, "needs_review": false}, {"bbox": [[257.0, 540.0], [625.0, 540.0], [625.0, 563.0], [257.0, 563.0]], "text": "做一道题是一道题，你一定能做完。", "confidence": 0.9357678434428047, "needs_review": false}, {"bbox": [[162.0, 598.0], [502.0, 598.0], [502.0, 621.0], [162.0, 621.0]], "text": "【四69】（没）有什么（好）X的", "confidence": 0.8212824919644524, "needs_review": false}, {"bbox": [[256.0, 638.0], [627.0, 638.0], [627.0, 661.0], [256.0, 661.0]], "text": "这才刚刚开始，没有什么好激动的。", "confidence": 0.874678885235506, "needs_review": false}, {"bbox": [[258.0, 677.0], [627.0, 677.0], [627.0, 700.0], [258.0, 700.0]], "text": "你还是别担心了，有什么好害怕的。", "confidence": 0.9232798183665556, "needs_review": false}, {"bbox": [[255.0, 715.0], [723.0, 715.0], [723.0, 738.0], [255.0, 738.0]], "text": "有什么好难过的，这是我们早就想到的结果。", "confidence": 0.8813131139391944, "needs_review": false}, {"bbox": [[160.0, 772.0], [420.0, 773.0], [420.0, 799.0], [160.0, 798.0]], "text": "【四70】×是，Y是Y", "confidence": 0.7560186684131622, "needs_review": false}, {"bbox": [[255.0, 813.0], [581.0, 813.0], [581.0, 839.0], [255.0, 839.0]], "text": "一是一，二是二，这要分清楚。", "confidence": 0.8726674834887187, "needs_review": false}, {"bbox": [[257.0, 852.0], [628.0, 852.0], [628.0, 875.0], [257.0, 875.0]], "text": "他是他，我是我，意见不同很正常。", "confidence": 0.8925918866606319, "needs_review": false}, {"bbox": [[257.0, 891.0], [675.0, 891.0], [675.0, 914.0], [257.0, 914.0]], "text": "昨天是昨天，今天是今天，你得交作业。", "confidence": 0.9044465673597235, "needs_review": false}, {"bbox": [[162.0, 951.0], [498.0, 951.0], [498.0, 973.0], [162.0, 973.0]], "text": "【四71】×也得×，不×也得×", "confidence": 0.8260558173060417, "needs_review": false}, {"bbox": [[254.0, 987.0], [705.0, 987.0], [705.0, 1013.0], [254.0, 1013.0]], "text": "这件事很重要，你做也得做，不做也得做。", "confidence": 0.8951546937227249, "needs_review": false}, {"bbox": [[255.0, 1022.0], [728.0, 1027.0], [728.0, 1057.0], [255.0, 1052.0]], "text": "你吃也得吃，不吃也得吃，不能浪费粮食。", "confidence": 0.9071617186069488, "needs_review": false}, {"bbox": [[255.0, 1065.0], [747.0, 1066.0], [747.0, 1093.0], [255.0, 1092.0]], "text": "都病成这样了，医院你去也得去，不去也得去。", "confidence": 0.9260017031973059, "needs_review": false}, {"bbox": [[162.0, 1126.0], [348.0, 1126.0], [348.0, 1149.0], [162.0, 1149.0]], "text": "【四72】×就是了", "confidence": 0.7936454296112061, "needs_review": false}, {"bbox": [[257.0, 1164.0], [604.0, 1164.0], [604.0, 1190.0], [257.0, 1190.0]], "text": "你别浪费时间了，直接说就是了。", "confidence": 0.8752328753471375, "needs_review": false}, {"bbox": [[258.0, 1205.0], [646.0, 1205.0], [646.0, 1227.0], [258.0, 1227.0]], "text": "你不要生气，以后别跟他说话就是了", "confidence": 0.8565824873307172, "needs_review": false}, {"bbox": [[160.0, 1261.0], [334.0, 1261.0], [334.0, 1287.0], [160.0, 1287.0]], "text": "【四73】还X呢", "confidence": 0.7395206292470297, "needs_review": false}, {"bbox": [[255.0, 1303.0], [554.0, 1303.0], [554.0, 1326.0], [255.0, 1326.0]], "text": "还名牌儿呢，我听都没听过。", "confidence": 0.8883962886674064, "needs_review": false}, {"bbox": [[254.0, 1340.0], [627.0, 1341.0], [627.0, 1366.0], [254.0, 1365.0]], "text": "还有名的专家呢，这水平还没我高。", "confidence": 0.8902784726198982, "needs_review": false}, {"bbox": [[256.0, 1380.0], [650.0, 1380.0], [650.0, 1403.0], [256.0, 1403.0]], "text": "还著名诗人呢，这诗写的我都看不懂。", "confidence": 0.903556893269221, "needs_review": false}, {"bbox": [[162.0, 1439.0], [380.0, 1439.0], [380.0, 1462.0], [162.0, 1462.0]], "text": "【四74】你×你的吧", "confidence": 0.8355517116459933, "needs_review": false}, {"bbox": [[258.0, 1479.0], [507.0, 1479.0], [507.0, 1501.0], [258.0, 1501.0]], "text": "你吃你的吧，别给我留。", "confidence": 0.9075223257144293, "needs_review": false}, {"bbox": [[257.0, 1517.0], [556.0, 1517.0], [556.0, 1540.0], [257.0, 1540.0]], "text": "没有什么事，你休息你的吧！", "confidence": 0.9178499323981149, "needs_review": false}, {"bbox": [[258.0, 1556.0], [625.0, 1556.0], [625.0, 1579.0], [258.0, 1579.0]], "text": "你忙你的吧，我跟孩子玩儿一会儿。", "confidence": 0.8858649941051707, "needs_review": false}, {"bbox": [[162.0, 1614.0], [447.0, 1614.0], [447.0, 1637.0], [162.0, 1637.0]], "text": "【四75】让／叫你×你就×", "confidence": 0.8047667401177543, "needs_review": false}, {"bbox": [[257.0, 1654.0], [529.0, 1654.0], [529.0, 1677.0], [257.0, 1677.0]], "text": "让你做你就做，别多问了。", "confidence": 0.9002731717549838, "needs_review": false}, {"bbox": [[257.0, 1692.0], [578.0, 1693.0], [578.0, 1717.0], [257.0, 1716.0]], "text": "叫你吃你就吃，其他的你别管。", "confidence": 0.9232901851336162, "needs_review": false}, {"bbox": [[258.0, 1733.0], [602.0, 1733.0], [602.0, 1755.0], [258.0, 1755.0]], "text": "让你安静你就安静，别那么多话。", "confidence": 0.9010639078915119, "needs_review": false}, {"bbox": [[1178.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1178.0, 1809.0]], "text": "215", "confidence": 0.619894728064537, "needs_review": false}]