[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.8008711154644306, "needs_review": false}, {"bbox": [[161.0, 221.0], [410.0, 221.0], [410.0, 247.0], [161.0, 247.0]], "text": "【七一九090】比较句6", "confidence": 0.9056305426817673, "needs_review": false}, {"bbox": [[264.0, 258.0], [477.0, 260.0], [477.0, 287.0], [264.0, 285.0]], "text": "（1）比起………·（来）", "confidence": 0.7464346839831426, "needs_review": false}, {"bbox": [[320.0, 301.0], [661.0, 301.0], [661.0, 321.0], [320.0, 321.0]], "text": "比起其他人，我的想法太简单了。", "confidence": 0.905699584633112, "needs_review": false}, {"bbox": [[318.0, 337.0], [614.0, 337.0], [614.0, 360.0], [318.0, 360.0]], "text": "比起唱歌来，他更喜欢跳舞。", "confidence": 0.9080765460218702, "needs_review": false}, {"bbox": [[266.0, 375.0], [526.0, 375.0], [526.0, 398.0], [266.0, 398.0]], "text": "（2）A+形容词+于+B", "confidence": 0.8346154781488272, "needs_review": false}, {"bbox": [[318.0, 413.0], [614.0, 413.0], [614.0, 436.0], [318.0, 436.0]], "text": "人的自我实现过程重于结果。", "confidence": 0.8746882591928754, "needs_review": false}, {"bbox": [[317.0, 451.0], [832.0, 451.0], [832.0, 473.0], [317.0, 473.0]], "text": "在施工现场，工人们的安全高于一切，大于一切。", "confidence": 0.9342314056728197, "needs_review": false}, {"bbox": [[266.0, 489.0], [582.0, 489.0], [582.0, 512.0], [266.0, 512.0]], "text": "（3）A+比+名词+还+名词", "confidence": 0.79989173412323, "needs_review": false}, {"bbox": [[317.0, 526.0], [543.0, 526.0], [543.0, 549.0], [317.0, 549.0]], "text": "他简直比强盗还强盗！", "confidence": 0.8343683806332675, "needs_review": false}, {"bbox": [[316.0, 564.0], [711.0, 564.0], [711.0, 586.0], [316.0, 586.0]], "text": "在上流社会里，他装得比绅士还绅士。", "confidence": 0.9228039383888245, "needs_review": false}, {"bbox": [[161.0, 625.0], [249.0, 625.0], [249.0, 649.0], [161.0, 649.0]], "text": "A.7.5.2", "confidence": 0.8511096462607384, "needs_review": false}, {"bbox": [[250.0, 623.0], [314.0, 623.0], [314.0, 651.0], [250.0, 651.0]], "text": "复句", "confidence": 0.6557653943697611, "needs_review": false}, {"bbox": [[161.0, 685.0], [379.0, 685.0], [379.0, 710.0], [161.0, 710.0]], "text": "A.7.5.2.1并列复句", "confidence": 0.9020639998572213, "needs_review": false}, {"bbox": [[160.0, 745.0], [521.0, 745.0], [521.0, 771.0], [160.0, 771.0]], "text": "【七一九091】一面··，一面.·", "confidence": 0.7359431187311808, "needs_review": false}, {"bbox": [[317.0, 784.0], [711.0, 785.0], [711.0, 809.0], [317.0, 808.0]], "text": "他一面听老师讲课，一面认真记笔记。", "confidence": 0.9041223426659902, "needs_review": false}, {"bbox": [[317.0, 823.0], [849.0, 824.0], [849.0, 846.0], [317.0, 845.0]], "text": "他一面做作业，一面看电视，做事一点儿都不用心", "confidence": 0.8840388344681781, "needs_review": false}, {"bbox": [[161.0, 882.0], [380.0, 882.0], [380.0, 908.0], [161.0, 908.0]], "text": "A.7.5.2.2承接复句", "confidence": 0.8895173583711896, "needs_review": false}, {"bbox": [[160.0, 943.0], [484.0, 943.0], [484.0, 968.0], [160.0, 968.0]], "text": "【七一九092】··.···，此后···..·", "confidence": 0.665557095160087, "needs_review": false}, {"bbox": [[316.0, 979.0], [759.0, 981.0], [759.0, 1008.0], [316.0, 1006.0]], "text": "我们三年前见过一面，此后再也没有见过。", "confidence": 0.9199355661869049, "needs_review": false}, {"bbox": [[317.0, 1019.0], [832.0, 1019.0], [832.0, 1045.0], [317.0, 1045.0]], "text": "她二十岁结了婚，此后丈夫生病，她照顾了四年。", "confidence": 0.9186650825583417, "needs_review": false}, {"bbox": [[160.0, 1076.0], [426.0, 1075.0], [426.0, 1100.0], [160.0, 1102.0]], "text": "【七一九093】起初·····，", "confidence": 0.7328205266419578, "needs_review": false}, {"bbox": [[317.0, 1113.0], [762.0, 1115.0], [762.0, 1141.0], [317.0, 1139.0]], "text": "他起初没明白，后来才理解了游戏的规则。", "confidence": 0.9059426784515381, "needs_review": false}, {"bbox": [[316.0, 1150.0], [907.0, 1150.0], [907.0, 1179.0], [316.0, 1179.0]], "text": "我们起初不想参加的，只是不好意思拒绝，才去了那里。", "confidence": 0.9607089161872864, "needs_review": false}, {"bbox": [[160.0, 1214.0], [383.0, 1210.0], [383.0, 1237.0], [161.0, 1241.0]], "text": "A.7.5.2.3递进复句", "confidence": 0.8488895637648446, "needs_review": false}, {"bbox": [[159.0, 1272.0], [1233.0, 1272.0], [1233.0, 1301.0], [159.0, 1301.0]], "text": "【七一九094】别说连··…··也都；连…·也都…，别说…；别说…，即使…·", "confidence": 0.6971603402724633, "needs_review": false}, {"bbox": [[317.0, 1312.0], [702.0, 1312.0], [702.0, 1338.0], [317.0, 1338.0]], "text": "也··．即使…··也，别说·.", "confidence": 0.6044860817492008, "needs_review": false}, {"bbox": [[317.0, 1352.0], [757.0, 1352.0], [757.0, 1371.0], [317.0, 1371.0]], "text": "别说是大学生了，连小学生都比他写得好。", "confidence": 0.8447590678930282, "needs_review": false}, {"bbox": [[316.0, 1388.0], [807.0, 1388.0], [807.0, 1411.0], [316.0, 1411.0]], "text": "我现在穷得连饭也吃不起了，别说买新衣服了。", "confidence": 0.9006444297053597, "needs_review": false}, {"bbox": [[317.0, 1427.0], [856.0, 1427.0], [856.0, 1450.0], [317.0, 1450.0]], "text": "别说爸爸，即使是老师，也说不出这种植物的名字。", "confidence": 0.9164378643035889, "needs_review": false}, {"bbox": [[318.0, 1465.0], [1001.0, 1465.0], [1001.0, 1487.0], [318.0, 1487.0]], "text": "即使是稍微有钱的家庭，也禁不住她这么花钱，别说普通家庭了。", "confidence": 0.9174423058827718, "needs_review": false}, {"bbox": [[159.0, 1519.0], [483.0, 1517.0], [483.0, 1547.0], [159.0, 1549.0]], "text": "【七—九095】··，何况·", "confidence": 0.7089745004971822, "needs_review": false}, {"bbox": [[318.0, 1561.0], [664.0, 1561.0], [664.0, 1584.0], [318.0, 1584.0]], "text": "我不道歉，何况根本不是我的错！", "confidence": 0.8823138177394867, "needs_review": false}, {"bbox": [[317.0, 1599.0], [833.0, 1599.0], [833.0, 1621.0], [317.0, 1621.0]], "text": "这道菜做起来很花时间的，何况今天顾客那么多。", "confidence": 0.9188009319098099, "needs_review": false}, {"bbox": [[161.0, 1654.0], [480.0, 1654.0], [480.0, 1680.0], [161.0, 1680.0]], "text": "【七一九096】······，进而····", "confidence": 0.6909224025227807, "needs_review": false}, {"bbox": [[318.0, 1692.0], [1074.0, 1693.0], [1074.0, 1719.0], [318.0, 1718.0]], "text": "只有在这样的国家里，教师才能充分发展，进而保护他自已和公共利益。", "confidence": 0.9175602053150986, "needs_review": false}, {"bbox": [[317.0, 1732.0], [881.0, 1732.0], [881.0, 1754.0], [317.0, 1754.0]], "text": "遇到困难不要回避，挺起身来向它挑战，进而战胜它。", "confidence": 0.9162093448638916, "needs_review": false}, {"bbox": [[1178.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1178.0, 1809.0]], "text": "247", "confidence": 0.6442833691835403, "needs_review": false}]