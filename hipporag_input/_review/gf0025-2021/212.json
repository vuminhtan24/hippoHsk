[{"bbox": [[130.0, 165.0], [300.0, 165.0], [300.0, 188.0], [130.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.7983347223355219, "needs_review": false}, {"bbox": [[129.0, 222.0], [682.0, 223.0], [682.0, 247.0], [129.0, 246.0]], "text": "【四07】时间副词：按时、即将、急忙、渐渐、尽快", "confidence": 0.8979429340362549, "needs_review": false}, {"bbox": [[224.0, 265.0], [378.0, 265.0], [378.0, 289.0], [224.0, 289.0]], "text": "你要按时吃药。", "confidence": 0.8735607042908669, "needs_review": false}, {"bbox": [[225.0, 307.0], [402.0, 307.0], [402.0, 329.0], [225.0, 329.0]], "text": "同学们即将毕业。", "confidence": 0.8071621391508315, "needs_review": false}, {"bbox": [[223.0, 346.0], [523.0, 347.0], [523.0, 371.0], [223.0, 370.0]], "text": "快上课了，他急忙跑进教室。", "confidence": 0.8751767362867083, "needs_review": false}, {"bbox": [[224.0, 389.0], [548.0, 389.0], [548.0, 412.0], [224.0, 412.0]], "text": "春天来了，天气渐渐暖和起来。", "confidence": 0.9306268056233724, "needs_review": false}, {"bbox": [[225.0, 431.0], [448.0, 431.0], [448.0, 453.0], [225.0, 453.0]], "text": "你尽快给他回个电话。", "confidence": 0.8673721226778898, "needs_review": false}, {"bbox": [[130.0, 491.0], [536.0, 491.0], [536.0, 514.0], [130.0, 514.0]], "text": "【四08】频率、重复副词：一再、再三", "confidence": 0.8863373649747748, "needs_review": false}, {"bbox": [[225.0, 535.0], [593.0, 535.0], [593.0, 555.0], [225.0, 555.0]], "text": "他一再表示自已不会出席这次会议。", "confidence": 0.8910120024400598, "needs_review": false}, {"bbox": [[223.0, 575.0], [520.0, 575.0], [520.0, 597.0], [223.0, 597.0]], "text": "我再三解释，他还是不相信。", "confidence": 0.921343960932323, "needs_review": false}, {"bbox": [[128.0, 634.0], [368.0, 634.0], [368.0, 660.0], [128.0, 660.0]], "text": "【四09】关联副词：却", "confidence": 0.9050289789835612, "needs_review": false}, {"bbox": [[223.0, 677.0], [427.0, 677.0], [427.0, 700.0], [223.0, 700.0]], "text": "我来了，他却没来。", "confidence": 0.8457329571247101, "needs_review": false}, {"bbox": [[225.0, 716.0], [714.0, 716.0], [714.0, 739.0], [225.0, 739.0]], "text": "同学们都出去活动了，他却坐在教室里面不动。", "confidence": 0.9247741617939689, "needs_review": false}, {"bbox": [[129.0, 779.0], [391.0, 779.0], [391.0, 802.0], [129.0, 802.0]], "text": "【四10】否定副词：未必", "confidence": 0.8970134716767532, "needs_review": false}, {"bbox": [[223.0, 821.0], [593.0, 821.0], [593.0, 843.0], [223.0, 843.0]], "text": "这个消息未必可靠，咱们再等等吧。", "confidence": 0.881877229494207, "needs_review": false}, {"bbox": [[223.0, 860.0], [450.0, 860.0], [450.0, 886.0], [223.0, 886.0]], "text": "别等了，他未必会来。", "confidence": 0.8548132993958213, "needs_review": false}, {"bbox": [[130.0, 923.0], [464.0, 923.0], [464.0, 946.0], [130.0, 946.0]], "text": "【四11】情态副词：几乎、似乎", "confidence": 0.8728905692696571, "needs_review": false}, {"bbox": [[225.0, 964.0], [474.0, 964.0], [474.0, 986.0], [225.0, 986.0]], "text": "他的话我几乎都没听懂。", "confidence": 0.8239414195219675, "needs_review": false}, {"bbox": [[224.0, 1004.0], [548.0, 1005.0], [548.0, 1029.0], [224.0, 1028.0]], "text": "她似乎对自己的表现很不满意。", "confidence": 0.867978568871816, "needs_review": false}, {"bbox": [[127.0, 1061.0], [673.0, 1062.0], [673.0, 1092.0], [127.0, 1091.0]], "text": "【四12】语气副词：的确、反而、还4、竟然、究竟", "confidence": 0.8729078245162963, "needs_review": false}, {"bbox": [[222.0, 1105.0], [402.0, 1105.0], [402.0, 1131.0], [222.0, 1131.0]], "text": "这的确是我的错。", "confidence": 0.8852977156639099, "needs_review": false}, {"bbox": [[223.0, 1147.0], [528.0, 1148.0], [528.0, 1174.0], [223.0, 1173.0]], "text": "风不但没停，反而越来越大。", "confidence": 0.87926327756473, "needs_review": false}, {"bbox": [[225.0, 1191.0], [595.0, 1191.0], [595.0, 1214.0], [225.0, 1214.0]], "text": "他还真有办法，问题马上就解决了。", "confidence": 0.9324145211892969, "needs_review": false}, {"bbox": [[223.0, 1232.0], [618.0, 1232.0], [618.0, 1255.0], [223.0, 1255.0]], "text": "这道题很简单，同学们竟然都做错了。", "confidence": 0.8835644159052107, "needs_review": false}, {"bbox": [[224.0, 1272.0], [500.0, 1273.0], [500.0, 1297.0], [224.0, 1296.0]], "text": "明天的晚会你究竟去不去？", "confidence": 0.8791445447848394, "needs_review": false}, {"bbox"