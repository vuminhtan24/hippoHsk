[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.8083363267091604, "needs_review": false}, {"bbox": [[257.0, 225.0], [747.0, 225.0], [747.0, 245.0], [257.0, 245.0]], "text": "我前天在路上意外地碰见了多年没见的老朋友。", "confidence": 0.8934303549203005, "needs_review": false}, {"bbox": [[257.0, 264.0], [869.0, 264.0], [869.0, 287.0], [257.0, 287.0]], "text": "我们下午在教室里都非常认真地对昨天的报告进行了讨论。", "confidence": 0.8835598362816705, "needs_review": false}, {"bbox": [[162.0, 326.0], [312.0, 326.0], [312.0, 350.0], [162.0, 350.0]], "text": "A.5.4.3补语", "confidence": 0.805134791135788, "needs_review": false}, {"bbox": [[160.0, 390.0], [373.0, 390.0], [373.0, 413.0], [160.0, 413.0]], "text": "【五34】趋向补语4", "confidence": 0.8570025671612133, "needs_review": false}, {"bbox": [[258.0, 432.0], [537.0, 432.0], [537.0, 452.0], [258.0, 452.0]], "text": "表示时间意义（引申用法）", "confidence": 0.8826189774733323, "needs_review": false}, {"bbox": [[206.0, 470.0], [662.0, 470.0], [662.0, 493.0], [206.0, 493.0]], "text": "（1）表示动作行为的开始：动词+上／起来", "confidence": 0.8979143074580601, "needs_review": false}, {"bbox": [[256.0, 510.0], [507.0, 510.0], [507.0, 533.0], [256.0, 533.0]], "text": "这孩子又玩儿上游戏了。", "confidence": 0.8617805788914362, "needs_review": false}, {"bbox": [[256.0, 548.0], [460.0, 548.0], [460.0, 574.0], [256.0, 574.0]], "text": "他大声地哭起来了。", "confidence": 0.8966928064823151, "needs_review": false}, {"bbox": [[256.0, 589.0], [555.0, 589.0], [555.0, 612.0], [256.0, 612.0]], "text": "这项工作上个月就干起来了。", "confidence": 0.858730456658772, "needs_review": false}, {"bbox": [[206.0, 628.0], [686.0, 628.0], [686.0, 651.0], [206.0, 651.0]], "text": "（2）表示动作行为的持续：动词+下去／下来", "confidence": 0.892678594047373, "needs_review": false}, {"bbox": [[256.0, 668.0], [459.0, 668.0], [459.0, 694.0], [256.0, 694.0]], "text": "别紧张，你说下去。", "confidence": 0.8776262819766998, "needs_review": false}, {"bbox": [[257.0, 708.0], [556.0, 708.0], [556.0, 733.0], [257.0, 733.0]], "text": "你这样坚持下去一定能成功。", "confidence": 0.9261798986366817, "needs_review": false}, {"bbox": [[256.0, 744.0], [700.0, 747.0], [700.0, 773.0], [256.0, 770.0]], "text": "你的中文说得不错，我建议你继续学下去。", "confidence": 0.8743943810462952, "needs_review": false}, {"bbox": [[256.0, 786.0], [845.0, 786.0], [845.0, 812.0], [256.0, 812.0]], "text": "在这三年里，我把每天锻炼一个小时的习惯保持下来了。", "confidence": 0.915780457166525, "needs_review": false}, {"bbox": [[162.0, 846.0], [561.0, 846.0], [561.0, 869.0], [162.0, 869.0]], "text": "【五35】可能补语2：动词+得／不得", "confidence": 0.850172514978208, "needs_review": false}, {"bbox": [[256.0, 887.0], [654.0, 887.0], [654.0, 910.0], [256.0, 910.0]], "text": "这种药吃得还是吃不得，得听医生的。", "confidence": 0.940487715933058, "needs_review": false}, {"bbox": [[256.0, 927.0], [602.0, 927.0], [602.0, 950.0], [256.0, 950.0]], "text": "这些东西你可拿不得，很危险的。", "confidence": 0.9033169746398926, "needs_review": false}, {"bbox": [[254.0, 964.0], [548.0, 966.0], [548.0, 991.0], [254.0, 990.0]], "text": "这种没有原则的话可说不得", "confidence": 0.91276871241056, "needs_review": false}, {"bbox": [[162.0, 1027.0], [374.0, 1027.0], [374.0, 1050.0], [162.0, 1050.0]], "text": "【五36】程度补语2", "confidence": 0.8390687487342141, "needs_review": false}, {"bbox": [[204.0, 1063.0], [703.0, 1064.0], [703.0, 1093.0], [204.0, 1092.0]], "text": "（1）形容词／心理动词+得+不得了／慌／厉害", "confidence": 0.8685029304545858, "needs_review": false}, {"bbox": [[254.0, 1144.0], [595.0, 1144.0], [595.0, 1173.0], [254.0, 1173.0]], "text": "我只是累得慌，休息休息就好了", "confidence": 0.9275326212247212, "needs_review": false}, {"bbox": [[256.0, 1185.0], [556.0, 1185.0], [556.0, 1211.0], [256.0, 1211.0]], "text": "听说要打针，她害怕得厉害。", "confidence": 0.9223474945340838, "needs_review": false}, {"bbox": [[204.0, 1218.0], [540.0, 1222.0], [539.0, 1251.0], [204.0, 1248.0]], "text": "（2）动词／形容词+坏／透＋了", "confidence": 0.8425210397690535, "needs_review": false}, {"bbox": [[254.0, 1262.0], [701.0, 1264.0], [701.0, 1291.0], [254.0, 1289.0]], "text": "这么晚了孩子还没回家，张老师担心坏了。", "confidence": 0.9055615782737731, "needs_review": false}, {"bbox": [[256.0, 1305.0], [723.0, 1305.0], [723.0, 1328.0], [256.0, 1328.0]], "text": "这件事已经伤透了她的心，大家不要再提起。", "confidence": 0.9289544991084507, "needs_review": false}, {"bbox": [[253.0, 1341.0], [624.0, 1344.0], [624.0, 1370.0], [253.0, 1367.0]], "text": "第一次被别人拒绝，我心情坏透了。", "confidence": 0.8872514051549575, "needs_review": false}, {"bbox": [[162.0, 1403.0], [659.0, 1403.0], [659.0, 1426.0], [162.0, 1426.0]], "text": "【五37】状态补语2：动词／形容词+得+短语", "confidence": 0.8774833083152771, "needs_review": false}, {"bbox": [[206.0, 1443.0], [567.0, 1443.0], [567.0, 1466.0], [206.0, 1466.0]], "text": "（1）动词／形容词+得+动词短语", "confidence": 0.8103633873602923, "needs_review": false}, {"bbox": [[255.0, 1479.0], [460.0, 1482.0], [460.0, 1507.0], [255.0, 1505.0]], "text": "他难过得吃不下饭。", "confidence": 0.8519332587718964, "needs_review": false}, {"bbox": [[257.0, 1522.0], [458.0, 1522.0], [458.0, 1545.0], [257.0, 1545.0]], "text": "她气得说不出话来。", "confidence": 0.8945903480052948, "needs_review": false}, {"bbox": [[255.0, 1559.0], [461.0, 1561.0], [461.0, 1587.0], [255.0, 1585.0]], "text": "她伤心得哭了起来。", "confidence": 0.8952305674552917, "needs_review": false}, {"bbox": [[207.0, 1602.0], [568.0, 1602.0], [568.0, 1624.0], [207.0, 1624.0]], "text": "（2）动词／形容词+得+主谓短语", "confidence": 0.803739467087914, "needs_review": false}, {"bbox": [[257.0, 1641.0], [555.0, 1641.0], [555.0, 1664.0], [257.0, 1664.0]], "text": "我早上没吃饭，饿得肚子疼。", "confidence": 0.8932793481009347, "needs_review": false}, {"bbox": [[257.0, 1680.0], [460.0, 1680.0], [460.0, 1706.0], [257.0, 1706.0]], "text": "房间里热得人头痛。", "confidence": 0.8524894893169404, "needs_review": false}, {"bbox": [[254.0, 1718.0], [674.0, 1719.0], [674.0, 1746.0], [254.0, 1744.0]], "text": "孩子得了冠军，父母乐得嘴都合不上了。", "confidence": 0.8657527220876593, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1215.0, 1786.0], [1215.0, 1809.0], [1179.0, 1809.0]], "text": "221", "confidence": 0.7448789924383163, "needs_review": false}]