[{"bbox": [[1069.0, 167.0], [1237.0, 167.0], [1237.0, 187.0], [1069.0, 187.0]], "text": "GF0025—2021", "confidence": 0.8654402866959572, "needs_review": false}, {"bbox": [[161.0, 222.0], [1238.0, 223.0], [1238.0, 247.0], [161.0, 246.0]], "text": "【三19】语气副词：白、并1、当然、到底、反正、根本、果然、简直、绝对、难道、其实、千万、确", "confidence": 0.9219411129647113, "needs_review": false}, {"bbox": [[256.0, 263.0], [427.0, 263.0], [427.0, 289.0], [256.0, 289.0]], "text": "实、只好、终于", "confidence": 0.779971718788147, "needs_review": false}, {"bbox": [[257.0, 305.0], [554.0, 305.0], [554.0, 327.0], [257.0, 327.0]], "text": "老师不在办公室，我白去了。", "confidence": 0.8329428774969918, "needs_review": false}, {"bbox": [[255.0, 343.0], [625.0, 343.0], [625.0, 366.0], [255.0, 366.0]], "text": "这次考试并没有他们说的那么简单。", "confidence": 0.9002431070103365, "needs_review": false}, {"bbox": [[256.0, 385.0], [483.0, 385.0], [483.0, 408.0], [256.0, 408.0]], "text": "学生当然应该做作业。", "confidence": 0.8783998001705516, "needs_review": false}, {"bbox": [[256.0, 424.0], [509.0, 425.0], [509.0, 449.0], [256.0, 448.0]], "text": "他到底是老师还是学生？", "confidence": 0.8513961285352707, "needs_review": false}, {"bbox": [[256.0, 465.0], [651.0, 465.0], [651.0, 488.0], [256.0, 488.0]], "text": "我不知道是谁做的，反正不是我做的。", "confidence": 0.9043506847487556, "needs_review": false}, {"bbox": [[255.0, 504.0], [435.0, 506.0], [435.0, 530.0], [255.0, 528.0]], "text": "她根本不相信我。", "confidence": 0.8504621651437547, "needs_review": false}, {"bbox": [[256.0, 546.0], [625.0, 546.0], [625.0, 569.0], [256.0, 569.0]], "text": "天气预报说要下雨，你看果然下了。", "confidence": 0.847935627488529, "needs_review": false}, {"bbox": [[256.0, 586.0], [625.0, 586.0], [625.0, 606.0], [256.0, 606.0]], "text": "这纸花太漂亮了，简直跟真花一样。", "confidence": 0.9066540283315322, "needs_review": false}, {"bbox": [[257.0, 626.0], [602.0, 626.0], [602.0, 649.0], [257.0, 649.0]], "text": "他绝对不会干这种事，我相信他。", "confidence": 0.8951744437217712, "needs_review": false}, {"bbox": [[258.0, 667.0], [628.0, 667.0], [628.0, 690.0], [258.0, 690.0]], "text": "别人都能学会，难道我就学不会吗？", "confidence": 0.8804808364194983, "needs_review": false}, {"bbox": [[255.0, 706.0], [699.0, 706.0], [699.0, 728.0], [255.0, 728.0]], "text": "大家以为他回国了，其实他去南方旅行了。", "confidence": 0.909041765332222, "needs_review": false}, {"bbox": [[257.0, 747.0], [531.0, 747.0], [531.0, 770.0], [257.0, 770.0]], "text": "你明天千万要早点儿回来。", "confidence": 0.8862269337360675, "needs_review": false}, {"bbox": [[256.0, 788.0], [508.0, 788.0], [508.0, 811.0], [256.0, 811.0]], "text": "这次情况确实非常紧急。", "confidence": 0.8951806028683981, "needs_review": false}, {"bbox": [[257.0, 828.0], [555.0, 828.0], [555.0, 850.0], [257.0, 850.0]], "text": "我生病了，只好跟老师请假。", "confidence": 0.8978682202952248, "needs_review": false}, {"bbox": [[255.0, 865.0], [821.0, 867.0], [821.0, 893.0], [255.0, 891.0]], "text": "他努力复习了一个月，终于顺利地通过了所有的考试。", "confidence": 0.9365153789520264, "needs_review": false}, {"bbox": [[161.0, 931.0], [244.0, 931.0], [244.0, 955.0], [161.0, 955.0]], "text": "A.3.2.5", "confidence": 0.8723664656281471, "needs_review": false}, {"bbox": [[252.0, 930.0], [312.0, 930.0], [312.0, 955.0], [252.0, 955.0]], "text": "介词", "confidence": 0.601658821105957, "needs_review": false}, {"bbox": [[160.0, 994.0], [263.0, 994.0], [263.0, 1017.0], [160.0, 1017.0]], "text": "A.3.2.5.1", "confidence": 0.8437146663665771, "needs_review": false}, {"bbox": [[282.0, 994.0], [450.0, 994.0], [450.0, 1017.0], [282.0, 1017.0]], "text": "引出时间、处所", "confidence": 0.8229130357503891, "needs_review": false}, {"bbox": [[157.0, 1054.0], [298.0, 1051.0], [299.0, 1081.0], [158.0, 1085.0]], "text": "【三20】由1", "confidence": 0.8551262393593788, "needs_review": false}, {"bbox": [[256.0, 1098.0], [547.0, 1098.0], [547.0, 1120.0], [256.0, 1120.0]], "text": "这路公交车由北京机场出发", "confidence": 0.8520909868753873, "needs_review": false}, {"bbox": [[256.0, 1136.0], [482.0, 1138.0], [482.0, 1161.0], [256.0, 1159.0]], "text": "我们由南门进入公园。", "confidence": 0.8728237260471691, "needs_review": false}, {"bbox": [[160.0, 1196.0], [303.0, 1196.0], [303.0, 1220.0], [160.0, 1220.0]], "text": "【三21】自从", "confidence": 0.7882629111409187, "needs_review": false}, {"bbox": [[258.0, 1237.0], [675.0, 1237.0], [675.0, 1263.0], [258.0, 1263.0]], "text": "自从修了公路，这儿的交通就方便多了。", "confidence": 0.9159899322610152, "needs_review": false}, {"bbox": [[259.0, 1280.0], [651.0, 1280.0], [651.0, 1303.0], [259.0, 1303.0]], "text": "自从来到中国，他就喜欢上了中国菜。", "confidence": 0.9152115748988258, "needs_review": false}, {"bbox": [[161.0, 1344.0], [289.0, 1344.0], [289.0, 1366.0], [161.0, 1366.0]], "text": "A.3.2.5.25", "confidence": 0.7861425172198903, "needs_review": false}, {"bbox": [[278.0, 1344.0], [449.0, 1344.0], [449.0, 1366.0], [278.0, 1366.0]], "text": "引出方向、路径", "confidence": 0.7885497510433197, "needs_review": false}, {"bbox": [[158.0, 1404.0], [282.0, 1404.0], [282.0, 1431.0], [158.0, 1431.0]], "text": "【三22】朝", "confidence": 0.8155512469155448, "needs_review": false}, {"bbox": [[255.0, 1444.0], [385.0, 1444.0], [385.0, 1468.0], [255.0, 1468.0]], "text": "大门朝南开。", "confidence": 0.8201723098754883, "needs_review": false}, {"bbox": [[256.0, 1481.0], [484.0, 1484.0], [484.0, 1509.0], [256.0, 1507.0]], "text": "他朝左边看了一下儿。", "confidence": 0.8716457865454934, "needs_review": false}, {"bbox": [[256.0, 1522.0], [490.0, 1520.0], [490.0, 1546.0], [256.0, 1548.0]], "text": "他朝我大喊：“小心！”", "confidence": 0.8691782653331757, "needs_review": false}, {"bbox": [[161.0, 1584.0], [379.0, 1584.0], [379.0, 1610.0], [161.0, 1610.0]], "text": "A.3.2.5.3引出对象", "confidence": 0.8306888299328941, "needs_review": false}, {"bbox": [[158.0, 1643.0], [298.0, 1641.0], [299.0, 1671.0], [159.0, 1673.0]], "text": "【三23】为²", "confidence": 0.8026294931769371, "needs_review": false}, {"bbox": [[257.0, 1687.0], [483.0, 1687.0], [483.0, 1710.0], [257.0, 1710.0]], "text": "妈妈每天为我们做饭。", "confidence": 0.8521255417303606, "needs_review": false}, {"bbox": [[257.0, 1726.0], [458.0, 1726.0], [458.0, 1748.0], [257.0, 1748.0]], "text": "他为我买了一束花。", "confidence": 0.8043509483337402, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1179.0, 1809.0]], "text": "195", "confidence": 0.7261613607406616, "needs_review": false}]