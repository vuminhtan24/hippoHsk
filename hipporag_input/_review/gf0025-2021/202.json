ce": 0.826865751009721, "needs_review": false}, {"bbox": [[223.0, 845.0], [546.0, 845.0], [546.0, 868.0], [223.0, 868.0]], "text": "我看见你把手机放在书包里了。", "confidence": 0.8397915323575338, "needs_review": false}, {"bbox": [[222.0, 886.0], [402.0, 886.0], [402.0, 912.0], [222.0, 912.0]], "text": "裙子被我弄脏了。", "confidence": 0.8225276470184326, "needs_review": false}, {"bbox": [[223.0, 929.0], [403.0, 929.0], [403.0, 955.0], [223.0, 955.0]], "text": "手机叫我弄坏了。", "confidence": 0.8778210944599576, "needs_review": false}, {"bbox": [[224.0, 974.0], [448.0, 974.0], [448.0, 994.0], [224.0, 994.0]], "text": "我的车让朋友借走了。", "confidence": 0.8516003381122242, "needs_review": false}, {"bbox": [[128.0, 1037.0], [347.0, 1037.0], [347.0, 1063.0], [128.0, 1063.0]], "text": "A.3.2.5.6表示排除", "confidence": 0.9250167480536869, "needs_review": false}, {"bbox": [[127.0, 1101.0], [271.0, 1101.0], [271.0, 1128.0], [127.0, 1128.0]], "text": "【三28】除了", "confidence": 0.7947410419583321, "needs_review": false}, {"bbox": [[222.0, 1144.0], [499.0, 1145.0], [499.0, 1171.0], [222.0, 1170.0]], "text": "除了英文，他还会说中文。", "confidence": 0.8852513019855206, "needs_review": false}, {"bbox": [[223.0, 1188.0], [499.0, 1189.0], [499.0, 1213.0], [223.0, 1212.0]], "text": "除了他，我们都是留学生。", "confidence": 0.7311758353159978, "needs_review": false}, {"bbox": [[128.0, 1253.0], [419.0, 1253.0], [419.0, 1279.0], [128.0, 1279.0]], "text": "A.3.2.5.7引出凭借、依据", "confidence": 0.921068366836099, "needs_review": false}, {"bbox": [[129.0, 1320.0], [320.0, 1320.0], [320.0, 1343.0], [129.0, 1343.0]], "text": "【三29】按、按照", "confidence": 0.8728762805461884, "needs_review": false}, {"bbox": [[225.0, 1360.0], [474.0, 1360.0], [474.0, 1383.0], [225.0, 1383.0]], "text": "房租按天或者按月计算。", "confidence": 0.8732129484415054, "needs_review": false}, {"bbox": [[224.0, 1403.0], [741.0, 1405.0], [741.0, 1428.0], [224.0, 1426.0]], "text": "他们按照地图找到了全部东西，顺利完成了任务。", "confidence": 0.9317778582158296, "needs_review": false}, {"bbox": [[127.0, 1469.0], [281.0, 1467.0], [281.0, 1493.0], [128.0, 1496.0]], "text": "A.3.2.6连词", "confidence": 0.8196409195661545, "needs_review": false}, {"bbox": [[127.0, 1533.0], [986.0, 1534.0], [986.0, 1560.0], [127.0, 1559.0]], "text": "【三30】连接分句或句子：并且、不光、不仅、另外、要是、因此、由于²、只有", "confidence": 0.8941109149079574, "needs_review": false}, {"bbox": [[223.0, 1578.0], [956.0, 1578.0], [956.0, 1601.0], [223.0, 1601.0]], "text": "这星期我很忙，要上课，要准备考试，另外，还要参加一些学校活动。", "confidence": 0.9340622834861279, "needs_review": false}, {"bbox": [[221.0, 1617.0], [910.0, 1618.0], [910.0, 1644.0], [221.0, 1643.0]], "text": "这次晚会他们准备了很多吃的、喝的，另外，还准备了不少礼物。", "confidence": 0.9214157223701477, "needs_review": false}, {"bbox": [[222.0, 1663.0], [963.0, 1663.0], [963.0, 1686.0], [222.0, 1686.0]], "text": "（“并且、不光、不仅、要是、因此、由于、只有”例句参见复句部分）", "confidence": 0.9062448125897031, "needs_review": false}, {"bbox": [[154.0, 1786.0], [191.0, 1786.0], [191.0, 1809.0], [154.0, 1809.0]], "text": "196", "confidence": 0.7433375716209412, "needs_review": false}]