[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.7845640274194571, "needs_review": false}, {"bbox": [[162.0, 223.0], [355.0, 223.0], [355.0, 246.0], [162.0, 246.0]], "text": "【六26】无A无B", "confidence": 0.8275237143039703, "needs_review": false}, {"bbox": [[256.0, 264.0], [701.0, 264.0], [701.0, 287.0], [256.0, 287.0]], "text": "妈妈无时无刻不在想念着国外留学的孩子。", "confidence": 0.9354413270950317, "needs_review": false}, {"bbox": [[257.0, 306.0], [576.0, 306.0], [576.0, 325.0], [257.0, 325.0]], "text": "这孩子再不管管就无法无天了。", "confidence": 0.8331664641698201, "needs_review": false}, {"bbox": [[161.0, 362.0], [356.0, 362.0], [356.0, 388.0], [161.0, 388.0]], "text": "【六27】A这A那", "confidence": 0.8044467806816101, "needs_review": false}, {"bbox": [[258.0, 404.0], [579.0, 404.0], [579.0, 427.0], [258.0, 427.0]], "text": "他总是很耐心地听她说这说那。", "confidence": 0.9271515568097433, "needs_review": false}, {"bbox": [[258.0, 445.0], [650.0, 445.0], [650.0, 467.0], [258.0, 467.0]], "text": "他这个人真是麻烦，总是嫌这嫌那的。", "confidence": 0.9253606994946798, "needs_review": false}, {"bbox": [[162.0, 504.0], [355.0, 504.0], [355.0, 527.0], [162.0, 527.0]], "text": "【六28】左A右B", "confidence": 0.8275728821754456, "needs_review": false}, {"bbox": [[257.0, 545.0], [626.0, 545.0], [626.0, 568.0], [257.0, 568.0]], "text": "他左躲右闪，终于把球踢进了球门。", "confidence": 0.8773743860861835, "needs_review": false}, {"bbox": [[257.0, 586.0], [795.0, 586.0], [795.0, 606.0], [257.0, 606.0]], "text": "第一次出门，他兴奋得左瞧右看，眼睛晴都不够用了。", "confidence": 0.8456700539588928, "needs_review": false}, {"bbox": [[258.0, 625.0], [699.0, 625.0], [699.0, 648.0], [258.0, 648.0]], "text": "他左思右想，觉得这件事不能这样就完了。", "confidence": 0.9099888205528259, "needs_review": false}, {"bbox": [[160.0, 685.0], [334.0, 685.0], [334.0, 714.0], [160.0, 714.0]], "text": "A.6.3.2.2其他", "confidence": 0.8776798993349075, "needs_review": false}, {"bbox": [[161.0, 751.0], [328.0, 751.0], [328.0, 774.0], [161.0, 774.0]], "text": "【六29】不怎么", "confidence": 0.8324774901072184, "needs_review": false}, {"bbox": [[256.0, 792.0], [601.0, 792.0], [601.0, 815.0], [256.0, 815.0]], "text": "这件衣服不怎么好看，换一件吧。", "confidence": 0.9039061330258846, "needs_review": false}, {"bbox": [[257.0, 832.0], [508.0, 832.0], [508.0, 854.0], [257.0, 854.0]], "text": "他不怎么在乎这些小事。", "confidence": 0.8327773412068685, "needs_review": false}, {"bbox": [[257.0, 872.0], [506.0, 872.0], [506.0, 895.0], [257.0, 895.0]], "text": "他今天好像不怎么舒服。", "confidence": 0.8725321690241495, "needs_review": false}, {"bbox": [[162.0, 932.0], [352.0, 932.0], [352.0, 955.0], [162.0, 955.0]], "text": "【六30】不怎么样", "confidence": 0.8099766790866851, "needs_review": false}, {"bbox": [[257.0, 972.0], [483.0, 972.0], [483.0, 995.0], [257.0, 995.0]], "text": "她跳舞跳得不怎么样。", "confidence": 0.86595895615491, "needs_review": false}, {"bbox": [[258.0, 1012.0], [485.0, 1012.0], [485.0, 1035.0], [258.0, 1035.0]], "text": "甲：这件衣服怎么样？", "confidence": 0.8551630973815918, "needs_review": false}, {"bbox": [[257.0, 1053.0], [410.0, 1053.0], [410.0, 1076.0], [257.0, 1076.0]], "text": "乙：不怎么样。", "confidence": 0.8528640866279602, "needs_review": false}, {"bbox": [[162.0, 1112.0], [399.0, 1112.0], [399.0, 1135.0], [162.0, 1135.0]], "text": "【六31】好（不）容易", "confidence": 0.8717550834019979, "needs_review": false}, {"bbox": [[256.0, 1151.0], [822.0, 1151.0], [822.0, 1177.0], [256.0, 1177.0]], "text": "我好不容易给你争取来这个机会，你怎么能不抓住呢？", "confidence": 0.9303372406959534, "needs_review": false}, {"bbox": [[258.0, 1193.0], [750.0, 1193.0], [750.0, 1216.0], [258.0, 1216.0]], "text": "你好容易走到这一步，怎么能说放弃就放弃呢？", "confidence": 0.9119233678687703, "needs_review": false}, {"bbox": [[257.0, 1233.0], [749.0, 1233.0], [749.0, 1256.0], [257.0, 1256.0]], "text": "我好不容易说服他来参加比赛，你不能让他走。", "confidence": 0.8855572424151681, "needs_review": false}, {"bbox": [[160.0, 1290.0], [399.0, 1290.0], [399.0, 1316.0], [160.0, 1316.0]], "text": "【六32】那倒（也）是", "confidence": 0.8560313731431961, "needs_review": false}, {"bbox": [[256.0, 1334.0], [603.0, 1334.0], [603.0, 1356.0], [256.0, 1356.0]], "text": "现在看来，那倒是个很好的办法。", "confidence": 0.8610042072832584, "needs_review": false}, {"bbox": [[256.0, 1373.0], [580.0, 1373.0], [580.0, 1396.0], [256.0, 1396.0]], "text": "实在没办法，那倒也是个办法。", "confidence": 0.8499125162760417, "needs_review": false}, {"bbox": [[258.0, 1413.0], [820.0, 1413.0], [820.0, 1436.0], [258.0, 1436.0]], "text": "甲：如果能找到失败的原因，那倒是件值得高兴的事。", "confidence": 0.9051982474327087, "needs_review": false}, {"bbox": [[256.0, 1453.0], [410.0, 1453.0], [410.0, 1477.0], [256.0, 1477.0]], "text": "乙：那倒也是。", "confidence": 0.8714406043291092, "needs_review": false}, {"bbox": [[160.0, 1511.0], [446.0, 1512.0], [446.0, 1538.0], [160.0, 1537.0]], "text": "【六33】就是说／这就是说", "confidence": 0.8710196741989681, "needs_review": false}, {"bbox": [[257.0, 1554.0], [578.0, 1554.0], [578.0, 1577.0], [257.0, 1577.0]], "text": "就是说，他是一个不诚实的人。", "confidence": 0.8861543973286946, "needs_review": false}, {"bbox": [[256.0, 1595.0], [722.0, 1595.0], [722.0, 1617.0], [256.0, 1617.0]], "text": "这就是说，责任不在你，你千万不要怪自已。", "confidence": 0.8594739664168585, "needs_review": false}, {"bbox": [[161.0, 1650.0], [304.0, 1652.0], [303.0, 1679.0], [160.0, 1677.0]], "text": "【六34】算了", "confidence": 0.8539729490876198, "needs_review": false}, {"bbox": [[256.0, 1695.0], [482.0, 1695.0], [482.0, 1718.0], [256.0, 1718.0]], "text": "这件事就这样算了吧。", "confidence": 0.8854234977201982, "needs_review": false}, {"bbox": [[256.0, 1735.0], [553.0, 1735.0], [553.0, 1757.0], [256.0, 1757.0]], "text": "他不去算了，不要为难他了。", "confidence": 0.8969658826078687, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1215.0, 1786.0], [1215.0, 1809.0], [1179.0, 1809.0]], "text": "231", "confidence": 0.7452539354562759, "needs_review": false}]