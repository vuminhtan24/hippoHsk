 1535.0]], "text": "上海我一次也没去过。", "confidence": 0.8079045740040866, "needs_review": false}, {"bbox": [[225.0, 1554.0], [595.0, 1554.0], [595.0, 1577.0], [225.0, 1577.0]], "text": "刚来中国时，他一句中文也听不懂。", "confidence": 0.8791117983705857, "needs_review": false}, {"bbox": [[128.0, 1613.0], [580.0, 1613.0], [580.0, 1638.0], [128.0, 1638.0]], "text": "【四66】用“连·也都….”表示强调", "confidence": 0.8105459793617851, "needs_review": false}, {"bbox": [[224.0, 1656.0], [571.0, 1656.0], [571.0, 1679.0], [224.0, 1679.0]], "text": "他连这个作家的名字也没听说过。", "confidence": 0.9300086759030819, "needs_review": false}, {"bbox": [[223.0, 1698.0], [547.0, 1698.0], [547.0, 1721.0], [223.0, 1721.0]], "text": "我连最简单的汉字都写不出来。", "confidence": 0.8481944878896077, "needs_review": false}, {"bbox": [[153.0, 1786.0], [192.0, 1786.0], [192.0, 1809.0], [153.0, 1809.0]], "text": "214", "confidence": 0.63391974568367, "needs_review": false}]