[{"bbox": [[130.0, 165.0], [300.0, 165.0], [300.0, 188.0], [130.0, 188.0]], "text": "GF0025—2021", "confidence": 0.8101998716592789, "needs_review": false}, {"bbox": [[126.0, 221.0], [450.0, 220.0], [450.0, 247.0], [127.0, 248.0]], "text": "【七一九097】…··，况且···", "confidence": 0.6439608501063453, "needs_review": false}, {"bbox": [[284.0, 264.0], [971.0, 264.0], [971.0, 287.0], [284.0, 287.0]], "text": "北京这么大，况且你又是第一次来，怎么能一下子就找到我家呢？", "confidence": 0.8909043888250987, "needs_review": false}, {"bbox": [[285.0, 306.0], [847.0, 306.0], [847.0, 325.0], [285.0, 325.0]], "text": "那时天已经黑了，况且人文坐在车上，肯定看不清楚。", "confidence": 0.8283437156677246, "needs_review": false}, {"bbox": [[126.0, 362.0], [521.0, 360.0], [521.0, 387.0], [127.0, 389.0]], "text": "【七一九098】连……·，更不用说…", "confidence": 0.7822223321387642, "needs_review": false}, {"bbox": [[286.0, 406.0], [583.0, 406.0], [583.0, 426.0], [286.0, 426.0]], "text": "连他都不会，更不用说我了。", "confidence": 0.8755840318543571, "needs_review": false}, {"bbox": [[285.0, 445.0], [775.0, 445.0], [775.0, 467.0], [285.0, 467.0]], "text": "我连上次的考试都没通过，更不用说这次的了。", "confidence": 0.8949489349668677, "needs_review": false}, {"bbox": [[284.0, 483.0], [776.0, 485.0], [776.0, 508.0], [284.0, 506.0]], "text": "他连这几个字都不会写，更不用说写篇作文了。", "confidence": 0.9009920006448572, "needs_review": false}, {"bbox": [[127.0, 543.0], [450.0, 541.0], [450.0, 568.0], [128.0, 570.0]], "text": "【七一九099】 ···，乃至··.", "confidence": 0.6668601208611539, "needs_review": false}, {"bbox": [[286.0, 584.0], [897.0, 584.0], [897.0, 607.0], [286.0, 607.0]], "text": "他的脸色、眼神，乃至一举一动，都被别人看得清清楚楚。", "confidence": 0.9342644082175361, "needs_review": false}, {"bbox": [[286.0, 625.0], [705.0, 625.0], [705.0, 648.0], [286.0, 648.0]], "text": "他熟悉北京，也熟悉巴黎，乃至全世界。", "confidence": 0.882675355986545, "needs_review": false}, {"bbox": [[127.0, 684.0], [425.0, 682.0], [425.0, 707.0], [128.0, 710.0]], "text": "【七一九100】..，且..·", "confidence": 0.6557579133659601, "needs_review": false}, {"bbox": [[284.0, 722.0], [865.0, 724.0], [865.0, 751.0], [284.0, 749.0]], "text": "他办事严谨而认真，且十分负责，获得了领导的信任。", "confidence": 0.9197228980064392, "needs_review": false}, {"bbox": [[283.0, 766.0], [989.0, 766.0], [989.0, 789.0], [283.0, 789.0]], "text": "这一条街又脏又乱，总是很潮湿，且一年四季总不免有种古怪气味。", "confidence": 0.9181529341205474, "needs_review": false}, {"bbox": [[126.0, 824.0], [472.0, 822.0], [472.0, 848.0], [127.0, 850.0]], "text": "【七一九101】·，甚至于...", "confidence": 0.6870074763017542, "needs_review": false}, {"bbox": [[282.0, 859.0], [780.0, 863.0], [779.0, 894.0], [282.0, 890.0]], "text": "她不能忍受这种想法，甚至于一秒钟也受不了。", "confidence": 0.8948143395510587, "needs_review": false}, {"bbox": [[280.0, 899.0], [879.0, 901.0], [879.0, 934.0], [280.0, 932.0]], "text": "这个小姑娘始终都是那副模样，甚至手一点儿也没长高。", "confidence": 0.9370172940767728, "needs_review": false}, {"bbox": [[129.0, 968.0], [347.0, 968.0], [347.0, 993.0], [129.0, 993.0]], "text": "A.7.5.2.4选择复句", "confidence": 0.8398692693029132, "needs_review": false}, {"bbox": [[127.0, 1031.0], [450.0, 1031.0], [450.0, 1057.0], [127.0, 1057.0]], "text": "【七一九102】或·..··，或...·", "confidence": 0.6339428495793116, "needs_review": false}, {"bbox": [[285.0, 1069.0], [971.0, 1072.0], [971.0, 1099.0], [285.0, 1095.0]], "text": "他把信藏在某个秘密的地方了，或一块石头下面，或一棵树后面。", "confidence": 0.8926335314909617, "needs_review": false}, {"bbox": [[283.0, 1109.0], [1041.0, 1110.0], [1041.0, 1137.0], [283.0, 1136.0]], "text": "阿姨每次来我家都带着一群朋友，或二三人，或三四人，大家说说笑笑。", "confidence": 0.9484858567064459, "needs_review": false}, {"bbox": [[129.0, 1172.0], [419.0, 1172.0], [419.0, 1195.0], [129.0, 1195.0]], "text": "【七一九103】宁可／宁愿…", "confidence": 0.8361558854579926, "needs_review": false}, {"bbox": [[475.0, 1176.0], [505.0, 1176.0], [505.0, 1191.0], [475.0, 1191.0]], "text": "也：", "confidence": 0.46398043632507324, "needs_review": true}, {"bbox": [[285.0, 1211.0], [776.0, 1211.0], [776.0, 1236.0], [285.0, 1236.0]], "text": "他宁可饿着肚子去上课，也不愿意吃垃圾食品。", "confidence": 0.9167068817398765, "needs_review": false}, {"bbox": [[285.0, 1250.0], [728.0, 1250.0], [728.0, 1276.0], [285.0, 1276.0]], "text": "他宁愿自已承担，也不肯把责任推给别人。", "confidence": 0.898038449883461, "needs_review": false}, {"bbox": [[128.0, 1311.0], [496.0, 1312.0], [496.0, 1338.0], [128.0, 1337.0]], "text": "【七一九104】与其…·，不如··", "confidence": 0.7528801510731379, "needs_review": false}, {"bbox": [[287.0, 1353.0], [631.0, 1353.0], [631.0, 1375.0], [287.0, 1375.0]], "text": "与其去爬山，还不如在家看电视。", "confidence": 0.8767170086503029, "needs_review": false}, {"bbox": [[287.0, 1393.0], [729.0, 1393.0], [729.0, 1416.0], [287.0, 1416.0]], "text": "与其在这里浪费时间，我们不如认真复习。", "confidence": 0.9187592476606369, "needs_review": false}, {"bbox": [[126.0, 1451.0], [565.0, 1450.0], [566.0, 1476.0], [126.0, 1477.0]], "text": "【七一九105】与其·，宁可／宁愿…", "confidence": 0.7546123893637406, "needs_review": false}, {"bbox": [[286.0, 1490.0], [752.0, 1491.0], [752.0, 1517.0], [286.0, 1516.0]], "text": "与其在这里洗半天的衣服，我宁可去买新的。", "confidence": 0.8832248676390875, "needs_review": false}, {"bbox": [[287.0, 1533.0], [729.0, 1533.0], [729.0, 1556.0], [287.0, 1556.0]], "text": "与其跟他一组，我宁愿一个人做这个项目。", "confidence": 0.945437416434288, "needs_review": false}, {"bbox": [[128.0, 1596.0], [347.0, 1596.0], [347.0, 1621.0], [128.0, 1621.0]], "text": "A.7.5.2.5转折复句", "confidence": 0.9156426872525897, "needs_review": false}, {"bbox": [[127.0, 1658.0], [544.0, 1658.0], [544.0, 1684.0], [127.0, 1684.0]], "text": "【七一九106】.··，而·.·（则）·.", "confidence": 0.6543912074782632, "needs_review": false}, {"bbox": [[285.0, 1700.0], [822.0, 1700.0], [822.0, 1723.0], [285.0, 1723.0]], "text": "绝大多数的人用感觉来思考，而我却用思考来感觉。", "confidence": 0.9086269102990627, "needs_review": false}, {"bbox": [[285.0, 1742.0], [872.0, 1742.0], [872.0, 1761.0], [285.0, 1761.0]], "text": "北方人过春节往往吃饺子，而南方人的习俗则是吃汤圆。", "confidence": 0.8852275655819819, "needs_review": false}, {"bbox": [[153.0, 1786.0], [191.0, 1786.0], [191.0, 1809.0], [153.0, 1809.0]], "text": "248", "confidence": 0.6554669886827469, "needs_review": false}]