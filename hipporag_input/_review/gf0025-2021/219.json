[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.7851609129172105, "needs_review": false}, {"bbox": [[160.0, 220.0], [482.0, 219.0], [482.0, 246.0], [160.0, 247.0]], "text": "【四52】万—·····，（就）····", "confidence": 0.6247800475075131, "needs_review": false}, {"bbox": [[256.0, 263.0], [579.0, 263.0], [579.0, 286.0], [256.0, 286.0]], "text": "万一我没来，你就自己先去吧。", "confidence": 0.8469427506128947, "needs_review": false}, {"bbox": [[257.0, 303.0], [818.0, 303.0], [818.0, 325.0], [257.0, 325.0]], "text": "一定要把你们的护照带上，万一需要，没带就麻烦了。", "confidence": 0.9129757046699524, "needs_review": false}, {"bbox": [[161.0, 363.0], [379.0, 363.0], [379.0, 389.0], [161.0, 389.0]], "text": "A.4.5.2.7条件复句", "confidence": 0.8845318981579372, "needs_review": false}, {"bbox": [[161.0, 426.0], [483.0, 426.0], [483.0, 452.0], [161.0, 452.0]], "text": "【四53】不管…··，都也", "confidence": 0.7222444734403065, "needs_review": false}, {"bbox": [[256.0, 465.0], [627.0, 466.0], [627.0, 490.0], [256.0, 489.0]], "text": "不管明天是否下雨，我都要去看他。", "confidence": 0.9205155547927407, "needs_review": false}, {"bbox": [[256.0, 506.0], [603.0, 506.0], [603.0, 529.0], [256.0, 529.0]], "text": "不管有多难，我也会坚持学下去。", "confidence": 0.9095089621841908, "needs_review": false}, {"bbox": [[160.0, 563.0], [489.0, 562.0], [489.0, 588.0], [160.0, 589.0]], "text": "【四54】无论···，都也··", "confidence": 0.7274521812796593, "needs_review": false}, {"bbox": [[257.0, 605.0], [771.0, 605.0], [771.0, 628.0], [257.0, 628.0]], "text": "无论学习多么紧张，我都坚持每天锻炼一个小时。", "confidence": 0.9184821844100952, "needs_review": false}, {"bbox": [[255.0, 644.0], [602.0, 644.0], [602.0, 667.0], [255.0, 667.0]], "text": "无论他怎么说，也没有人相信他。", "confidence": 0.8715193159878254, "needs_review": false}, {"bbox": [[161.0, 706.0], [380.0, 706.0], [380.0, 731.0], [161.0, 731.0]], "text": "A.4.5.2.8因果复句", "confidence": 0.9035727381706238, "needs_review": false}, {"bbox": [[160.0, 767.0], [445.0, 766.0], [445.0, 793.0], [160.0, 794.0]], "text": "【四55】既然··，就···", "confidence": 0.7255787789821625, "needs_review": false}, {"bbox": [[257.0, 809.0], [699.0, 809.0], [699.0, 832.0], [257.0, 832.0]], "text": "既然这事你已经决定了，我就不说什么了。", "confidence": 0.8922782152891159, "needs_review": false}, {"bbox": [[256.0, 848.0], [650.0, 848.0], [650.0, 871.0], [256.0, 871.0]], "text": "既然外面下雨了，我们就明天再去吧。", "confidence": 0.9054668611950345, "needs_review": false}, {"bbox": [[161.0, 906.0], [422.0, 906.0], [422.0, 932.0], [161.0, 932.0]], "text": "【四56】 ······，可见······", "confidence": 0.6152743114666506, "needs_review": false}, {"bbox": [[256.0, 946.0], [841.0, 947.0], [841.0, 970.0], [256.0, 969.0]], "text": "他的中文水平很高，可见他在留学期间学习是多么努力。", "confidence": 0.8973232599405142, "needs_review": false}, {"bbox": [[256.0, 983.0], [867.0, 984.0], [867.0, 1011.0], [256.0, 1010.0]], "text": "他在我困难的时候一直帮助我，可见他是我多么好的朋友。", "confidence": 0.928710107450132, "needs_review": false}, {"bbox": [[161.0, 1049.0], [378.0, 1047.0], [378.0, 1071.0], [161.0, 1073.0]], "text": "A.4.5.2.9让步复句", "confidence": 0.8649814852646419, "needs_review": false}, {"bbox": [[160.0, 1108.0], [486.0, 1108.0], [486.0, 1134.0], [160.0, 1134.0]], "text": "【四57】哪怕·，也／还···", "confidence": 0.7389790490269661, "needs_review": false}, {"bbox": [[256.0, 1149.0], [670.0, 1149.0], [670.0, 1175.0], [256.0, 1175.0]], "text": "哪怕明天下雨，足球比赛也要继续进行", "confidence": 0.917760411898295, "needs_review": false}, {"bbox": [[256.0, 1188.0], [580.0, 1190.0], [579.0, 1216.0], [256.0, 1214.0]], "text": "哪怕再难，我也要坚持学下去。", "confidence": 0.9156721234321594, "needs_review": false}, {"bbox": [[255.0, 1227.0], [627.0, 1229.0], [627.0, 1254.0], [255.0, 1253.0]], "text": "哪怕机会不天，我还是要去试一试。", "confidence": 0.9044874485801248, "needs_review": false}, {"bbox": [[161.0, 1291.0], [393.0, 1291.0], [393.0, 1317.0], [161.0, 1317.0]], "text": "A.4.5.2.10目的复句", "confidence": 0.8671685179074605, "needs_review": false}, {"bbox": [[161.0, 1354.0], [398.0, 1354.0], [398.0, 1379.0], [161.0, 1379.0]], "text": "【四58······，好·.·", "confidence": 0.5694883335381746, "needs_review": false}, {"bbox": [[257.0, 1394.0], [725.0, 1394.0], [725.0, 1417.0], [257.0, 1417.0]], "text": "老师布置了听写作业，好帮助学生练习汉字。", "confidence": 0.9000766305696397, "needs_review": false}, {"bbox": [[256.0, 1433.0], [748.0, 1434.0], [748.0, 1458.0], [256.0, 1457.0]], "text": "我们应该不断地引导他，好让他对自已有信心。", "confidence": 0.842006425965916, "needs_review": false}, {"bbox": [[255.0, 1472.0], [678.0, 1473.0], [678.0, 1498.0], [255.0, 1497.0]], "text": "她每天都给家里打电话，好让父母放心。", "confidence": 0.9148190272481818, "needs_review": false}, {"bbox": [[162.0, 1536.0], [292.0, 1536.0], [292.0, 1559.0], [162.0, 1559.0]], "text": "A.4.5.2.11", "confidence": 0.8559530756690286, "needs_review": false}, {"bbox": [[293.0, 1536.0], [391.0, 1536.0], [391.0, 1560.0], [293.0, 1560.0]], "text": "紧缩复句", "confidence": 0.7961910724639892, "needs_review": false}, {"bbox": [[160.0, 1596.0], [329.0, 1596.0], [329.0, 1622.0], [160.0, 1622.0]], "text": "【四59】无标记", "confidence": 0.8336964249610901, "needs_review": false}, {"bbox": [[257.0, 1637.0], [410.0, 1637.0], [410.0, 1661.0], [257.0, 1661.0]], "text": "你有事你先走。", "confidence": 0.8734205588698387, "needs_review": false}, {"bbox": [[257.0, 1677.0], [387.0, 1677.0], [387.0, 1701.0], [257.0, 1701.0]], "text": "你不怕我怕。", "confidence": 0.8547180805887494, "needs_review": false}, {"bbox": [[257.0, 1717.0], [386.0, 1717.0], [386.0, 1741.0], [257.0, 1741.0]], "text": "你想去你去。", "confidence": 0.8539633921214512, "needs_review": false}, {"bbox": [[1178.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1178.0, 1809.0]], "text": "213", "confidence": 0.6199493557214737, "needs_review": false}]