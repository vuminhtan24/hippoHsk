[{"bbox": [[130.0, 165.0], [300.0, 165.0], [300.0, 188.0], [130.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.7891537409562331, "needs_review": false}, {"bbox": [[128.0, 221.0], [577.0, 221.0], [577.0, 247.0], [128.0, 247.0]], "text": "【二20】语气副词：才1、都²、就²、正好", "confidence": 0.8512170233509757, "needs_review": false}, {"bbox": [[223.0, 265.0], [426.0, 265.0], [426.0, 288.0], [223.0, 288.0]], "text": "我今天八点才起床。", "confidence": 0.8209470570087433, "needs_review": false}, {"bbox": [[223.0, 307.0], [499.0, 307.0], [499.0, 329.0], [223.0, 329.0]], "text": "她一百块钱才买了两本书。", "confidence": 0.8316546678543091, "needs_review": false}, {"bbox": [[224.0, 347.0], [520.0, 347.0], [520.0, 370.0], [224.0, 370.0]], "text": "都十二点了，我们该睡觉了。", "confidence": 0.8554659783840179, "needs_review": false}, {"bbox": [[222.0, 388.0], [474.0, 389.0], [474.0, 413.0], [222.0, 412.0]], "text": "班长七点半就到教室了。", "confidence": 0.872532402475675, "needs_review": false}, {"bbox": [[224.0, 431.0], [570.0, 431.0], [570.0, 453.0], [224.0, 453.0]], "text": "他一遍就听懂了这个很长的句子。", "confidence": 0.8633293770253658, "needs_review": false}, {"bbox": [[225.0, 471.0], [522.0, 471.0], [522.0, 494.0], [225.0, 494.0]], "text": "今年我的生日正好是星期天。", "confidence": 0.9260467078004565, "needs_review": false}, {"bbox": [[126.0, 533.0], [282.0, 533.0], [282.0, 563.0], [126.0, 563.0]], "text": "A.2.1.7介词", "confidence": 0.890937739610672, "needs_review": false}, {"bbox": [[129.0, 600.0], [256.0, 600.0], [256.0, 624.0], [129.0, 624.0]], "text": "A.2.1.7.1", "confidence": 0.833829265832901, "needs_review": false}, {"bbox": [[247.0, 599.0], [346.0, 599.0], [346.0, 623.0], [247.0, 623.0]], "text": "引出时间", "confidence": 0.7992993354797363, "needs_review": false}, {"bbox": [[126.0, 663.0], [248.0, 663.0], [248.0, 690.0], [126.0, 690.0]], "text": "【二21】当", "confidence": 0.7217807940074376, "needs_review": false}, {"bbox": [[226.0, 706.0], [594.0, 706.0], [594.0, 728.0], [226.0, 728.0]], "text": "当他进来的时候，我们正在看电视。", "confidence": 0.8662798404693604, "needs_review": false}, {"bbox": [[225.0, 745.0], [667.0, 745.0], [667.0, 771.0], [225.0, 771.0]], "text": "当爸爸回来的时候，妈妈已经做好晚饭了。", "confidence": 0.9011021435260773, "needs_review": false}, {"bbox": [[129.0, 812.0], [418.0, 812.0], [418.0, 835.0], [129.0, 835.0]], "text": "A.2.1.7.2引出方向、路径", "confidence": 0.8455633170464459, "needs_review": false}, {"bbox": [[127.0, 871.0], [249.0, 871.0], [249.0, 898.0], [127.0, 898.0]], "text": "【二22】往", "confidence": 0.8489271998405457, "needs_review": false}, {"bbox": [[225.0, 914.0], [524.0, 914.0], [524.0, 937.0], [225.0, 937.0]], "text": "你往左走，就能看见洗手间。", "confidence": 0.9072635684694562, "needs_review": false}, {"bbox": [[224.0, 952.0], [473.0, 952.0], [473.0, 977.0], [224.0, 977.0]], "text": "你往前走一百米就到了。", "confidence": 0.8365592161814371, "needs_review": false}, {"bbox": [[125.0, 1008.0], [265.0, 1006.0], [265.0, 1036.0], [126.0, 1038.0]], "text": "【二23】向1", "confidence": 0.7972592860460281, "needs_review": false}, {"bbox": [[225.0, 1052.0], [527.0, 1052.0], [527.0, 1075.0], [225.0, 1075.0]], "text": "你向西边看，看见西山了吗？", "confidence": 0.8616363150732858, "needs_review": false}, {"bbox": [[225.0, 1092.0], [426.0, 1092.0], [426.0, 1114.0], [225.0, 1114.0]], "text": "他向图书馆走去了。", "confidence": 0.8515124678611755, "needs_review": false}, {"bbox": [[125.0, 1147.0], [265.0, 1145.0], [265.0, 1175.0], [126.0, 1177.0]], "text": "【二24】从²", "confidence": 0.7188698574900627, "needs_review": false}, {"bbox": [[224.0, 1189.0], [568.0, 1189.0], [568.0, 1215.0], [224.0, 1215.0]], "text": "你从这儿走，五分钟就到书店了。", "confidence": 0.9053256623446941, "needs_review": false}, {"bbox": [[221.0, 1226.0], [547.0, 1228.0], [547.0, 1254.0], [221.0, 1253.0]], "text": "这路公交车从我们学校门口过。", "confidence": 0.8564942320187886, "needs_review": false}, {"bbox": [[128.0, 1291.0], [347.0, 1291.0], [347.0, 1317.0], [128.0, 1317.0]], "text": "A.2.1.7.3引出对象", "confidence": 0.9189842428479876, "needs_review": false}, {"bbox": [[126.0, 1352.0], [248.0, 1352.0], [248.0, 1378.0], [126.0, 1378.0]], "text": "【二25】对", "confidence": 0.7876039487974984, "needs_review": false}, {"bbox": [[224.0, 1394.0], [426.0, 1394.0], [426.0, 1417.0], [224.0, 1417.0]], "text": "她对顾客非常热情。", "confidence": 0.8785101294517517, "needs_review": false}, {"bbox": [[223.0, 1434.0], [452.0, 1434.0], [452.0, 1457.0], [223.0, 1457.0]], "text": "这件事你对他说了吗？", "confidence": 0.8657098791816018, "needs_review": false}, {"bbox": [[126.0, 1488.0], [249.0, 1488.0], [249.0, 1518.0], [126.0, 1518.0]], "text": "【二26】给", "confidence": 0.7840379902294704, "needs_review": false}, {"bbox": [[224.0, 1534.0], [498.0, 1534.0], [498.0, 1557.0], [224.0, 1557.0]], "text": "我晚上要给女朋友打电话。", "confidence": 0.8874690853632413, "needs_review": false}, {"bbox": [[224.0, 1576.0], [644.0, 1576.0], [644.0, 1599.0], [224.0, 1599.0]], "text": "她后天过生日，我们给她送什么礼物呢？", "confidence": 0.8943168677781758, "needs_review": false}, {"bbox": [[127.0, 1634.0], [249.0, 1634.0], [249.0, 1661.0], [127.0, 1661.0]], "text": "【二27】离", "confidence": 0.8458752972739083, "needs_review": false}, {"bbox": [[223.0, 1678.0], [450.0, 1678.0], [450.0, 1701.0], [223.0, 1701.0]], "text": "这儿离车站有点儿远。", "confidence": 0.8897199413993142, "needs_review": false}, {"bbox": [[223.0, 1720.0], [547.0, 1720.0], [547.0, 1743.0], [223.0, 1743.0]], "text": "现在离放假有一个星期的时间。", "confidence": 0.8913156747817993, "needs_review": false}, {"bbox": [[154.0, 1786.0], [190.0, 1786.0], [190.0, 1809.0], [154.0, 1809.0]], "text": "182", "confidence": 0.7433447241783142, "needs_review": false}]