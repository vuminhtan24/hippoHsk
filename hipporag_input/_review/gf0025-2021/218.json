[{"bbox": [[130.0, 165.0], [300.0, 165.0], [300.0, 188.0], [130.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.8052527721111591, "needs_review": false}, {"bbox": [[128.0, 222.0], [346.0, 222.0], [346.0, 248.0], [128.0, 248.0]], "text": "A.4.5.2.2承接复句", "confidence": 0.9237387946673802, "needs_review": false}, {"bbox": [[126.0, 286.0], [437.0, 283.0], [437.0, 312.0], [127.0, 316.0]], "text": "【四45】首先，其次…·", "confidence": 0.8072722026934991, "needs_review": false}, {"bbox": [[226.0, 329.0], [836.0, 329.0], [836.0, 352.0], [226.0, 352.0]], "text": "首先我们要读一遍课文，其次我们要根据课文做一个练习。", "confidence": 0.9477190927222923, "needs_review": false}, {"bbox": [[225.0, 372.0], [909.0, 372.0], [909.0, 392.0], [225.0, 392.0]], "text": "我们球队问题很多，首先是队员不够团结，其次是训练时间很短。", "confidence": 0.9125846803188324, "needs_review": false}, {"bbox": [[225.0, 412.0], [665.0, 412.0], [665.0, 435.0], [225.0, 435.0]], "text": "评价一个学生，首先看品质，其次看成绩。", "confidence": 0.9042653113603591, "needs_review": false}, {"bbox": [[127.0, 470.0], [391.0, 467.0], [391.0, 497.0], [128.0, 500.0]], "text": "【四46 ，于是.", "confidence": 0.5708465144038201, "needs_review": false}, {"bbox": [[223.0, 513.0], [716.0, 513.0], [716.0, 539.0], [223.0, 539.0]], "text": "风停了，下起雨来，于是人们纷纷打起了雨伞。", "confidence": 0.9095193879170851, "needs_review": false}, {"bbox": [[225.0, 556.0], [668.0, 556.0], [668.0, 579.0], [225.0, 579.0]], "text": "他不喜欢这个工作，于是离开了这家公司。", "confidence": 0.8686225801706314, "needs_review": false}, {"bbox": [[224.0, 597.0], [692.0, 597.0], [692.0, 620.0], [224.0, 620.0]], "text": "离开会的时间还早，于是我们去逛了逛书店。", "confidence": 0.9241707495280674, "needs_review": false}, {"bbox": [[128.0, 660.0], [347.0, 660.0], [347.0, 686.0], [128.0, 686.0]], "text": "A.4.5.2.3递进复句", "confidence": 0.9244359944547925, "needs_review": false}, {"bbox": [[126.0, 723.0], [389.0, 719.0], [389.0, 749.0], [127.0, 752.0]], "text": "【四47】 ，甚至", "confidence": 0.7071690797805786, "needs_review": false}, {"bbox": [[224.0, 767.0], [716.0, 767.0], [716.0, 790.0], [224.0, 790.0]], "text": "他什么都不会，甚至连最简单的汉字也写不了。", "confidence": 0.9261937114325437, "needs_review": false}, {"bbox": [[225.0, 809.0], [546.0, 809.0], [546.0, 832.0], [225.0, 832.0]], "text": "她病得很严重，甚至要做手术。", "confidence": 0.8835751851399739, "needs_review": false}, {"bbox": [[224.0, 849.0], [621.0, 849.0], [621.0, 872.0], [224.0, 872.0]], "text": "妈妈真的很生气，甚至晚饭都没有吃。", "confidence": 0.834428694513109, "needs_review": false}, {"bbox": [[128.0, 913.0], [347.0, 913.0], [347.0, 939.0], [128.0, 939.0]], "text": "A.4.5.2.4选择复句", "confidence": 0.9217475269521985, "needs_review": false}, {"bbox": [[127.0, 975.0], [438.0, 974.0], [438.0, 1001.0], [127.0, 1002.0]], "text": "【四48】或者…··，或者……·", "confidence": 0.6691066009156844, "needs_review": false}, {"bbox": [[221.0, 1017.0], [614.0, 1019.0], [614.0, 1045.0], [221.0, 1043.0]], "text": "这件事或者赶快停止，或者重新开始。", "confidence": 0.8922278649277158, "needs_review": false}, {"bbox": [[223.0, 1059.0], [741.0, 1060.0], [741.0, 1086.0], [223.0, 1085.0]], "text": "暑假或者去上海，或者去杭州，反正得出去旅行。", "confidence": 0.9125314095745916, "needs_review": false}, {"bbox": [[224.0, 1100.0], [862.0, 1100.0], [862.0, 1126.0], [224.0, 1126.0]], "text": "咱们三个人，或者你去，或者我去，或者他去，谁去都可以。", "confidence": 0.9400260746479034, "needs_review": false}, {"bbox": [[128.0, 1165.0], [347.0, 1165.0], [347.0, 1191.0], [128.0, 1191.0]], "text": "A.4.5.2.5转折复句", "confidence": 0.921473571232387, "needs_review": false}, {"bbox": [[128.0, 1228.0], [374.0, 1230.0], [374.0, 1255.0], [127.0, 1254.0]], "text": "【四49】……，然而··…", "confidence": 0.6362855775015694, "needs_review": false}, {"bbox": [[224.0, 1272.0], [642.0, 1272.0], [642.0, 1295.0], [224.0, 1295.0]], "text": "我知道中文很有用，然而中文也太难了。", "confidence": 0.902324306337457, "needs_review": false}, {"bbox": [[225.0, 1313.0], [714.0, 1313.0], [714.0, 1336.0], [225.0, 1336.0]], "text": "他说他不喜欢这部电影，然而我觉得很有意思。", "confidence": 0.9335171959616921, "needs_review": false}, {"bbox": [[129.0, 1376.0], [346.0, 1376.0], [346.0, 1402.0], [129.0, 1402.0]], "text": "A.4.5.2.6假设复句", "confidence": 0.8620056637695858, "needs_review": false}, {"bbox": [[127.0, 1441.0], [388.0, 1439.0], [388.0, 1466.0], [128.0, 1468.0]], "text": "【四50】··，否则·", "confidence": 0.621302048365275, "needs_review": false}, {"bbox": [[223.0, 1484.0], [619.0, 1484.0], [619.0, 1506.0], [223.0, 1506.0]], "text": "我要认真复习，否则考试会不及格的。", "confidence": 0.9336885346306695, "needs_review": false}, {"bbox": [[225.0, 1525.0], [548.0, 1525.0], [548.0, 1548.0], [225.0, 1548.0]], "text": "记得带卡，否则进不了办公室。", "confidence": 0.8403995275497437, "needs_review": false}, {"bbox": [[226.0, 1568.0], [835.0, 1568.0], [835.0, 1588.0], [226.0, 1588.0]], "text": "上课前一定要预习好生词和课文，否则就听不懂老师讲的。", "confidence": 0.9209075216893796, "needs_review": false}, {"bbox": [[126.0, 1624.0], [452.0, 1619.0], [452.0, 1652.0], [127.0, 1656.0]], "text": "【四5·】假如，（就）.", "confidence": 0.7149274417987237, "needs_review": false}, {"bbox": [[224.0, 1669.0], [547.0, 1669.0], [547.0, 1692.0], [224.0, 1692.0]], "text": "假如有困难，你一定要告诉我。", "confidence": 0.892004378636678, "needs_review": false}, {"bbox": [[224.0, 1710.0], [787.0, 1711.0], [787.0, 1734.0], [224.0, 1733.0]], "text": "假如能通过这个考试，我就可以拿到学校的奖学金了。", "confidence": 0.8396860551834107, "needs_review": false}, {"bbox": [[153.0, 1786.0], [191.0, 1786.0], [191.0, 1809.0], [153.0, 1809.0]], "text": "212", "confidence": 0.6512943059206009, "needs_review": false}]