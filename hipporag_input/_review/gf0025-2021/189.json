[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.7920632499914902, "needs_review": false}, {"bbox": [[160.0, 222.0], [450.0, 222.0], [450.0, 248.0], [160.0, 248.0]], "text": "A.2.1.7.4引出目的、原因", "confidence": 0.8717517993029427, "needs_review": false}, {"bbox": [[158.0, 286.0], [297.0, 284.0], [298.0, 313.0], [159.0, 316.0]], "text": "【二28】为1", "confidence": 0.8572899401187897, "needs_review": false}, {"bbox": [[257.0, 331.0], [459.0, 331.0], [459.0, 354.0], [257.0, 354.0]], "text": "为大家的健康干杯！", "confidence": 0.8153215706348419, "needs_review": false}, {"bbox": [[257.0, 374.0], [531.0, 374.0], [531.0, 397.0], [257.0, 397.0]], "text": "我们都为你的好成绩高兴。", "confidence": 0.8502513903837937, "needs_review": false}, {"bbox": [[160.0, 438.0], [313.0, 438.0], [313.0, 464.0], [160.0, 464.0]], "text": "A.2.1.8连词", "confidence": 0.8754243135452271, "needs_review": false}, {"bbox": [[162.0, 505.0], [521.0, 505.0], [521.0, 528.0], [162.0, 528.0]], "text": "【二29】连接词或短语：或、或者", "confidence": 0.87021584370557, "needs_review": false}, {"bbox": [[257.0, 548.0], [603.0, 548.0], [603.0, 571.0], [257.0, 571.0]], "text": "星期天我想去看电影或听音乐会。", "confidence": 0.927227359265089, "needs_review": false}, {"bbox": [[258.0, 591.0], [530.0, 591.0], [530.0, 611.0], [258.0, 611.0]], "text": "我下午去打球或者去爬山。", "confidence": 0.8246741569959201, "needs_review": false}, {"bbox": [[161.0, 650.0], [957.0, 650.0], [957.0, 676.0], [161.0, 676.0]], "text": "【二30】连接分句或句子：不过、但、但是、而且、那、如果、虽然、只要", "confidence": 0.9286228265081133, "needs_review": false}, {"bbox": [[257.0, 695.0], [654.0, 695.0], [654.0, 717.0], [257.0, 717.0]], "text": "现在已经是冬天了，但北京还不太冷。", "confidence": 0.9179802305168576, "needs_review": false}, {"bbox": [[257.0, 737.0], [532.0, 737.0], [532.0, 760.0], [257.0, 760.0]], "text": "你不去，那我就一个人去。", "confidence": 0.9017602526224576, "needs_review": false}, {"bbox": [[253.0, 777.0], [930.0, 779.0], [930.0, 805.0], [253.0, 803.0]], "text": "（“不过、但是、而且、如果、虽然、只要”例句参见复句部分）", "confidence": 0.9242202401161194, "needs_review": false}, {"bbox": [[161.0, 843.0], [312.0, 843.0], [312.0, 870.0], [161.0, 870.0]], "text": "A.2.1.9助词", "confidence": 0.8330610930919647, "needs_review": false}, {"bbox": [[162.0, 911.0], [401.0, 911.0], [401.0, 934.0], [162.0, 934.0]], "text": "【二31】结构助词：得", "confidence": 0.8392299513022105, "needs_review": false}, {"bbox": [[256.0, 952.0], [435.0, 952.0], [435.0, 977.0], [256.0, 977.0]], "text": "他走得有点儿快。", "confidence": 0.8450610703892178, "needs_review": false}, {"bbox": [[256.0, 994.0], [460.0, 994.0], [460.0, 1020.0], [256.0, 1020.0]], "text": "她篮球打得很不错。", "confidence": 0.8619660913944245, "needs_review": false}, {"bbox": [[161.0, 1057.0], [400.0, 1057.0], [400.0, 1080.0], [161.0, 1080.0]], "text": "【二32】动态助词：过", "confidence": 0.8535695423682531, "needs_review": false}, {"bbox": [[257.0, 1100.0], [615.0, 1100.0], [615.0, 1123.0], [257.0, 1123.0]], "text": "我去过一次中国。／我没去过中国。", "confidence": 0.853350092382992, "needs_review": false}, {"bbox": [[256.0, 1139.0], [639.0, 1140.0], [639.0, 1169.0], [256.0, 1168.0]], "text": "他学过一点儿中文。／他没学过中文。", "confidence": 0.9048233727614085, "needs_review": false}, {"bbox": [[160.0, 1203.0], [402.0, 1203.0], [402.0, 1228.0], [160.0, 1228.0]], "text": "【二33】动态助词：着", "confidence": 0.8856559793154398, "needs_review": false}, {"bbox": [[255.0, 1245.0], [468.0, 1245.0], [468.0, 1271.0], [255.0, 1271.0]], "text": "门关着。／门没关着。", "confidence": 0.87198867039247, "needs_review": false}, {"bbox": [[254.0, 1289.0], [547.0, 1288.0], [547.0, 1314.0], [254.0, 1315.0]], "text": "电视开着呢。／电视没开着。", "confidence": 0.8201552267585482, "needs_review": false}, {"bbox": [[255.0, 1330.0], [459.0, 1332.0], [459.0, 1358.0], [255.0, 1355.0]], "text": "他穿着一件黑大衣。", "confidence": 0.8447539627552032, "needs_review": false}, {"bbox": [[255.0, 1375.0], [578.0, 1375.0], [578.0, 1398.0], [255.0, 1398.0]], "text": "孩子们在教室里高兴地唱着歌。", "confidence": 0.8648789326349894, "needs_review": false}, {"bbox": [[161.0, 1435.0], [542.0, 1435.0], [542.0, 1461.0], [161.0, 1461.0]], "text": "【二34】语气助词：啊1、吧？、的²", "confidence": 0.825911692882839, "needs_review": false}, {"bbox": [[257.0, 1480.0], [387.0, 1480.0], [387.0, 1503.0], [257.0, 1503.0]], "text": "今天真冷啊！", "confidence": 0.8350813473973956, "needs_review": false}, {"bbox": [[257.0, 1522.0], [388.0, 1522.0], [388.0, 1546.0], [257.0, 1546.0]], "text": "您是老师吧？", "confidence": 0.8509432332856315, "needs_review": false}, {"bbox": [[256.0, 1565.0], [411.0, 1565.0], [411.0, 1588.0], [256.0, 1588.0]], "text": "我是昨天来的。", "confidence": 0.7892841622233391, "needs_review": false}, {"bbox": [[162.0, 1625.0], [473.0, 1626.0], [473.0, 1650.0], [162.0, 1649.0]], "text": "【二35】其他助词：的话、等", "confidence": 0.9295234362284343, "needs_review": false}, {"bbox": [[258.0, 1670.0], [699.0, 1670.0], [699.0, 1693.0], [258.0, 1693.0]], "text": "你要来的话，就给我打个电话，我去接你。", "confidence": 0.885235607624054, "needs_review": false}, {"bbox": [[256.0, 1712.0], [747.0, 1712.0], [747.0, 1735.0], [256.0, 1735.0]], "text": "我去超市买了很多东西，有酒、水果、牛奶等。", "confidence": 0.9279912357980554, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1179.0, 1809.0]], "text": "183", "confidence": 0.7308354526758194, "needs_review": false}]