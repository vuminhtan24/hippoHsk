1381.0], [161.0, 1381.0]], "text": "【七一九130】（不过／但／可是）话又说回来，··", "confidence": 0.8480647045832413, "needs_review": false}, {"bbox": [[318.0, 1398.0], [736.0, 1398.0], [736.0, 1421.0], [318.0, 1421.0]], "text": "话又说回来，不能因为生病就失去希望。", "confidence": 0.9160818865424708, "needs_review": false}, {"bbox": [[317.0, 1436.0], [980.0, 1438.0], [980.0, 1461.0], [317.0, 1459.0]], "text": "但话又说回来，我们为什么不能把事情处理得对我们更有利呢？", "confidence": 0.9265092529099563, "needs_review": false}, {"bbox": [[160.0, 1495.0], [603.0, 1494.0], [603.0, 1520.0], [160.0, 1521.0]], "text": "【七一九131】×（也）不是，不×也不是", "confidence": 0.899748336701166, "needs_review": false}, {"bbox": [[318.0, 1536.0], [857.0, 1536.0], [857.0, 1559.0], [318.0, 1559.0]], "text": "走不是，不走也不是，弄得我们不知道怎么办才好。", "confidence": 0.8869915554920832, "needs_review": false}, {"bbox": [[318.0, 1576.0], [710.0, 1576.0], [710.0, 1599.0], [318.0, 1599.0]], "text": "笑也不是，不笑也不是，真让人尴尬。", "confidence": 0.9291298555003272, "needs_review": false}, {"bbox": [[161.0, 1633.0], [618.0, 1633.0], [618.0, 1659.0], [161.0, 1659.0]], "text": "【七一九132】X也好／也罢，Y也好／也罢", "confidence": 0.8715128383853219, "needs_review": false}, {"bbox": [[318.0, 1675.0], [810.0, 1675.0], [810.0, 1698.0], [318.0, 1698.0]], "text": "去也好，不去也好，反正不是什么大不了的事。", "confidence": 0.9008811387148771, "needs_review": false}, {"bbox": [[320.0, 1716.0], [782.0, 1716.0], [782.0, 1736.0], [320.0, 1736.0]], "text": "快乐也好，伤心也好，这个故事就要结束了。", "confidence": 0.910104479108538, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1215.0, 1786.0], [1215.0, 1809.0], [1179.0, 1809.0]], "text": "251", "confidence": 0.7470797151327133, "needs_review": false}]