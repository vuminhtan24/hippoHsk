[{"bbox": [[130.0, 165.0], [300.0, 165.0], [300.0, 188.0], [130.0, 188.0]], "text": "GF0025—2021", "confidence": 0.815093199412028, "needs_review": false}, {"bbox": [[127.0, 220.0], [301.0, 220.0], [301.0, 250.0], [127.0, 250.0]], "text": "A.7.2.2.2其他", "confidence": 0.9150684128204981, "needs_review": false}, {"bbox": [[128.0, 286.0], [354.0, 286.0], [354.0, 309.0], [128.0, 309.0]], "text": "【七一九068】巴不得", "confidence": 0.8622758537530899, "needs_review": false}, {"bbox": [[286.0, 325.0], [777.0, 325.0], [777.0, 348.0], [286.0, 348.0]], "text": "他一口气跑了半个多小时，巴不得一步就到家。", "confidence": 0.9029794199900194, "needs_review": false}, {"bbox": [[285.0, 365.0], [656.0, 365.0], [656.0, 388.0], [285.0, 388.0]], "text": "我恨这个行业，巴不得早点儿离开。", "confidence": 0.8673814009217655, "needs_review": false}, {"bbox": [[128.0, 423.0], [355.0, 423.0], [355.0, 449.0], [128.0, 449.0]], "text": "【七一九069】别提了", "confidence": 0.8652722239494324, "needs_review": false}, {"bbox": [[286.0, 465.0], [799.0, 465.0], [799.0, 485.0], [286.0, 485.0]], "text": "晚饭还没开始吃他就已经醉了，后来就更别提了。", "confidence": 0.9269546348115673, "needs_review": false}, {"bbox": [[287.0, 505.0], [873.0, 505.0], [873.0, 525.0], [287.0, 525.0]], "text": "别提了，我根本都不认识那个人，他硬拉着我不让我走。", "confidence": 0.909343435214116, "needs_review": false}, {"bbox": [[128.0, 563.0], [379.0, 563.0], [379.0, 585.0], [128.0, 585.0]], "text": "【七一九070】除此之外", "confidence": 0.8493645833088801, "needs_review": false}, {"bbox": [[285.0, 601.0], [701.0, 601.0], [701.0, 624.0], [285.0, 624.0]], "text": "他是个老师，除此之外，我不知道别的。", "confidence": 0.867102186930807, "needs_review": false}, {"bbox": [[285.0, 642.0], [728.0, 642.0], [728.0, 665.0], [285.0, 665.0]], "text": "我只带了一个书包，除此之外什么都没带。", "confidence": 0.9112061768770218, "needs_review": false}, {"bbox": [[129.0, 701.0], [379.0, 701.0], [379.0, 723.0], [129.0, 723.0]], "text": "【七一九071】归根到底", "confidence": 0.8672630557647119, "needs_review": false}, {"bbox": [[285.0, 740.0], [606.0, 740.0], [606.0, 763.0], [285.0, 763.0]], "text": "人生归根到底是一个人的旅行。", "confidence": 0.8843422770500183, "needs_review": false}, {"bbox": [[283.0, 780.0], [581.0, 780.0], [581.0, 803.0], [283.0, 803.0]], "text": "归根到底，成长是一种幸福。", "confidence": 0.8538348078727722, "needs_review": false}, {"bbox": [[128.0, 838.0], [356.0, 838.0], [356.0, 863.0], [128.0, 863.0]], "text": "【七一九072】可不是", "confidence": 0.7828793625036875, "needs_review": false}, {"bbox": [[286.0, 878.0], [561.0, 878.0], [561.0, 901.0], [286.0, 901.0]], "text": "甲：什么？我们家出事了？", "confidence": 0.8462755634234502, "needs_review": false}, {"bbox": [[286.0, 918.0], [610.0, 918.0], [610.0, 941.0], [286.0, 941.0]], "text": "乙：可不是，警察都已经来了。", "confidence": 0.9107098340988159, "needs_review": false}, {"bbox": [[286.0, 958.0], [536.0, 958.0], [536.0, 980.0], [286.0, 980.0]], "text": "甲：小孩子长得真快啊！", "confidence": 0.8143285562594732, "needs_review": false}, {"bbox": [[286.0, 997.0], [591.0, 997.0], [591.0, 1020.0], [286.0, 1020.0]], "text": "乙：可不是，已经要上小学了", "confidence": 0.8938147340502057, "needs_review": false}, {"bbox": [[127.0, 1055.0], [355.0, 1055.0], [355.0, 1081.0], [127.0, 1081.0]], "text": "【七一九073】没说的", "confidence": 0.8553108622630438, "needs_review": false}, {"bbox": [[283.0, 1095.0], [946.0, 1095.0], [946.0, 1120.0], [283.0, 1120.0]], "text": "我愿意做这件事，那是没说的，只是我不知道还能做多长时间。", "confidence": 0.9203927188084043, "needs_review": false}, {"bbox": [[285.0, 1135.0], [680.0, 1135.0], [680.0, 1158.0], [285.0, 1158.0]], "text": "新来的领导我都见过了，真是没说的！", "confidence": 0.8893857664532132, "needs_review": false}, {"bbox": [[129.0, 1195.0], [380.0, 1195.0], [380.0, 1218.0], [129.0, 1218.0]], "text": "【七一九074】无论如何", "confidence": 0.7868468440496005, "needs_review": false}, {"bbox": [[285.0, 1233.0], [582.0, 1233.0], [582.0, 1259.0], [285.0, 1259.0]], "text": "无论如何，他没有别的选择。", "confidence": 0.8801968480859484, "needs_review": false}, {"bbox": [[284.0, 1272.0], [631.0, 1273.0], [631.0, 1297.0], [284.0, 1296.0]], "text": "听到这里，他无论如何也不答应。", "confidence": 0.8940550088882446, "needs_review": false}, {"bbox": [[129.0, 1333.0], [379.0, 1333.0], [379.0, 1356.0], [129.0, 1356.0]], "text": "【七一九075】由此可见", "confidence": 0.8825049950526311, "needs_review": false}, {"bbox": [[285.0, 1372.0], [1018.0, 1372.0], [1018.0, 1395.0], [285.0, 1395.0]], "text": "很多中国孩子从小学习书法，由此可见书法在中国教育中的重要地位。", "confidence": 0.8864040356129408, "needs_review": false}, {"bbox": [[286.0, 1412.0], [1206.0, 1412.0], [1206.0, 1435.0], [286.0, 1435.0]], "text": "他幻想着将来住在爷爷家里以后要干些什么事，一遍遍说个没完，由此可见，他对母亲", "confidence": 0.9287847616733649, "needs_review": false}, {"bbox": [[285.0, 1452.0], [487.0, 1452.0], [487.0, 1475.0], [285.0, 1475.0]], "text": "并没有什么舍不得。", "confidence": 0.8716825842857361, "needs_review": false}, {"bbox": [[129.0, 1510.0], [379.0, 1510.0], [379.0, 1533.0], [129.0, 1533.0]], "text": "【七一九076】与此同时", "confidence": 0.8239807807482206, "needs_review": false}, {"bbox": [[286.0, 1550.0], [706.0, 1550.0], [706.0, 1573.0], [286.0, 1573.0]], "text": "太阳落山了，几乎与此同时下起了大雨。", "confidence": 0.88945682425248, "needs_review": false}, {"bbox": [[286.0, 1590.0], [1113.0, 1590.0], [1113.0, 1613.0], [286.0, 1613.0]], "text": "几个月之后，他的眼晴开始不停地流眼泪，与此同时他的视力也变得越来越差。", "confidence": 0.9316591951582167, "needs_review": false}, {"bbox": [[128.0, 1647.0], [381.0, 1647.0], [381.0, 1673.0], [128.0, 1673.0]], "text": "【七一九077】这样一来", "confidence": 0.8441206491910495, "needs_review": false}, {"bbox": [[285.0, 1690.0], [848.0, 1690.0], [848.0, 1710.0], [285.0, 1710.0]], "text": "这些小鸟总是在唱歌，这样一来，我家门前可热闹了。", "confidence": 0.8936113262176514, "needs_review": false}, {"bbox": [[287.0, 1730.0], [1016.0, 1730.0], [1016.0, 1749.0], [287.0, 1749.0]], "text": "他听了医生的话，每大都去外面散步，这样一来，他的病很快就好了。", "confidence": 0.9105464052408934, "needs_review": false}, {"bbox": [[153.0, 1786.0], [191.0, 1786.0], [191.0, 1809.0], [153.0, 1809.0]], "text": "244", "confidence": 0.661873921751976, "needs_review": false}]