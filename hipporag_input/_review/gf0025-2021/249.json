[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.7900269352472745, "needs_review": false}, {"bbox": [[161.0, 222.0], [229.0, 222.0], [229.0, 247.0], [161.0, 247.0]], "text": "A.7.2", "confidence": 0.700070858001709, "needs_review": false}, {"bbox": [[239.0, 222.0], [293.0, 222.0], [293.0, 248.0], [239.0, 248.0]], "text": "短语", "confidence": 0.6660580237706503, "needs_review": false}, {"bbox": [[159.0, 286.0], [360.0, 284.0], [361.0, 311.0], [159.0, 313.0]], "text": "A.7.2.1结构类型", "confidence": 0.8746642967065176, "needs_review": false}, {"bbox": [[162.0, 352.0], [560.0, 352.0], [560.0, 375.0], [162.0, 375.0]], "text": "【七一九059】数词+量词+抽象事物", "confidence": 0.8460907465533206, "needs_review": false}, {"bbox": [[318.0, 393.0], [591.0, 392.0], [591.0, 416.0], [318.0, 417.0]], "text": "他有一身本领，颇有才华。", "confidence": 0.8876089774645292, "needs_review": false}, {"bbox": [[317.0, 435.0], [832.0, 435.0], [832.0, 457.0], [317.0, 457.0]], "text": "这里虽然听不见什么争吵声，但并不是一团和气。", "confidence": 0.8714922899785249, "needs_review": false}, {"bbox": [[162.0, 500.0], [243.0, 500.0], [243.0, 521.0], [162.0, 521.0]], "text": "A.7.2.2", "confidence": 0.8340416774153709, "needs_review": false}, {"bbox": [[262.0, 498.0], [359.0, 498.0], [359.0, 522.0], [262.0, 522.0]], "text": "固定短语", "confidence": 0.7683919548988343, "needs_review": false}, {"bbox": [[162.0, 564.0], [284.0, 564.0], [284.0, 586.0], [162.0, 586.0]], "text": "A.7.2.2.1", "confidence": 0.8954314649105072, "needs_review": false}, {"bbox": [[278.0, 561.0], [355.0, 561.0], [355.0, 588.0], [278.0, 588.0]], "text": "四字格", "confidence": 0.7492116242647171, "needs_review": false}, {"bbox": [[161.0, 627.0], [415.0, 627.0], [415.0, 650.0], [161.0, 650.0]], "text": "【七一九060】爱A不A", "confidence": 0.8211576205033523, "needs_review": false}, {"bbox": [[319.0, 669.0], [783.0, 669.0], [783.0, 692.0], [319.0, 692.0]], "text": "他瞧不起她，对她总是一副爱理不理的样子。", "confidence": 0.9026178575697399, "needs_review": false}, {"bbox": [[317.0, 710.0], [615.0, 710.0], [615.0, 733.0], [317.0, 733.0]], "text": "这是我的想法，你爱听不听。", "confidence": 0.848483511379787, "needs_review": false}, {"bbox": [[161.0, 771.0], [415.0, 771.0], [415.0, 794.0], [161.0, 794.0]], "text": "【七一九061】半A半B", "confidence": 0.8199256750253531, "needs_review": false}, {"bbox": [[319.0, 813.0], [711.0, 813.0], [711.0, 836.0], [319.0, 836.0]], "text": "他说话半真半假，你不要完全相信他。", "confidence": 0.9079477985699972, "needs_review": false}, {"bbox": [[318.0, 853.0], [782.0, 853.0], [782.0, 876.0], [318.0, 876.0]], "text": "突然听到明天放假的消息，我一直半信半疑。", "confidence": 0.899927190371922, "needs_review": false}, {"bbox": [[160.0, 915.0], [414.0, 915.0], [414.0, 938.0], [160.0, 938.0]], "text": "【七一九062】东A西B", "confidence": 0.8868867479837858, "needs_review": false}, {"bbox": [[319.0, 958.0], [584.0, 958.0], [584.0, 977.0], [319.0, 977.0]], "text": "她买东西就喜欢东挑西选", "confidence": 0.8404254366954168, "needs_review": false}, {"bbox": [[318.0, 997.0], [824.0, 997.0], [824.0, 1020.0], [318.0, 1020.0]], "text": "为了买到一张火车票，我东奔西跑，累得一身汗", "confidence": 0.9256164567037062, "needs_review": false}, {"bbox": [[162.0, 1059.0], [415.0, 1059.0], [415.0, 1082.0], [162.0, 1082.0]], "text": "【七一九063】非A非B", "confidence": 0.8136323782113882, "needs_review": false}, {"bbox": [[315.0, 1099.0], [736.0, 1097.0], [736.0, 1123.0], [315.0, 1124.0]], "text": "这场悲剧的制造者非你非我，另有他人。", "confidence": 0.9032692375936007, "needs_review": false}, {"bbox": [[316.0, 1139.0], [736.0, 1140.0], [736.0, 1166.0], [316.0, 1165.0]], "text": "我们非敌非友，只是那天见过一面而已。", "confidence": 0.8796178384831077, "needs_review": false}, {"bbox": [[162.0, 1203.0], [418.0, 1203.0], [418.0, 1226.0], [162.0, 1226.0]], "text": "【七一九064】忽A忽B", "confidence": 0.7847664310381963, "needs_review": false}, {"bbox": [[318.0, 1243.0], [784.0, 1243.0], [784.0, 1266.0], [318.0, 1266.0]], "text": "叔叔书房的门关着，里边的说话声忽高忽低。", "confidence": 0.9282784320059276, "needs_review": false}, {"bbox": [[318.0, 1283.0], [640.0, 1283.0], [640.0, 1309.0], [318.0, 1309.0]], "text": "他十分紧张，心跳得忽快忽慢。", "confidence": 0.9072022199630737, "needs_review": false}, {"bbox": [[161.0, 1345.0], [415.0, 1344.0], [415.0, 1369.0], [161.0, 1370.0]], "text": "【七一九065】连A带B", "confidence": 0.8226348299246568, "needs_review": false}, {"bbox": [[318.0, 1387.0], [590.0, 1387.0], [590.0, 1410.0], [318.0, 1410.0]], "text": "几个小孩儿吓得连哭带叫。", "confidence": 0.8832024152462299, "needs_review": false}, {"bbox": [[318.0, 1428.0], [709.0, 1428.0], [709.0, 1451.0], [318.0, 1451.0]], "text": "信是男朋友写的，她高兴得连蹦带跳。", "confidence": 0.9132332503795624, "needs_review": false}, {"bbox": [[160.0, 1489.0], [415.0, 1486.0], [415.0, 1512.0], [160.0, 1514.0]], "text": "【七一九066】时A时B", "confidence": 0.8173500207754282, "needs_review": false}, {"bbox": [[318.0, 1531.0], [591.0, 1531.0], [591.0, 1554.0], [318.0, 1554.0]], "text": "小鸟发出的声音时长时短。", "confidence": 0.9187357700788058, "needs_review": false}, {"bbox": [[318.0, 1573.0], [734.0, 1573.0], [734.0, 1596.0], [318.0, 1596.0]], "text": "他的成绩时好时坏，老师也拿他没办法。", "confidence": 0.8787641493897689, "needs_review": false}, {"bbox": [[162.0, 1633.0], [415.0, 1633.0], [415.0, 1656.0], [162.0, 1656.0]], "text": "【七一九067】自A自B", "confidence": 0.8248363504042993, "needs_review": false}, {"bbox": [[314.0, 1675.0], [664.0, 1675.0], [664.0, 1698.0], [314.0, 1698.0]], "text": "一路上老板自说自话崂叻了半天。", "confidence": 0.8579979240894318, "needs_review": false}, {"bbox": [[318.0, 1717.0], [881.0, 1717.0], [881.0, 1740.0], [318.0, 1740.0]], "text": "想到你对我们工作的破坏，我应该让你自作自受才对。", "confidence": 0.953652777671814, "needs_review": false}, {"bbox": [[1178.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1178.0, 1809.0]], "text": "243", "confidence": 0.6276916414499283, "needs_review": false}]