[{"bbox": [[130.0, 165.0], [300.0, 165.0], [300.0, 188.0], [130.0, 188.0]], "text": "GF0025—2021", "confidence": 0.8121901055177053, "needs_review": false}, {"bbox": [[226.0, 223.0], [522.0, 223.0], [522.0, 246.0], [226.0, 246.0]], "text": "甲：不行，我得好好问问他。", "confidence": 0.9031645655632019, "needs_review": false}, {"bbox": [[226.0, 265.0], [498.0, 265.0], [498.0, 288.0], [226.0, 288.0]], "text": "乙：算了，你说不过他的。", "confidence": 0.8449414968490601, "needs_review": false}, {"bbox": [[127.0, 327.0], [309.0, 327.0], [309.0, 354.0], [127.0, 354.0]], "text": "A.6.4固定格式", "confidence": 0.8985389411449433, "needs_review": false}, {"bbox": [[127.0, 392.0], [491.0, 391.0], [491.0, 417.0], [127.0, 418.0]], "text": "【六35】A一+量词，B一+量词", "confidence": 0.8611348516800824, "needs_review": false}, {"bbox": [[225.0, 435.0], [618.0, 435.0], [618.0, 457.0], [225.0, 457.0]], "text": "他摔得很严重，身上青一块，紫一块。", "confidence": 0.9157214098506503, "needs_review": false}, {"bbox": [[224.0, 476.0], [689.0, 476.0], [689.0, 499.0], [224.0, 499.0]], "text": "大家你一句，我一句，搞得他反而没了主意。", "confidence": 0.895525248277755, "needs_review": false}, {"bbox": [[223.0, 516.0], [764.0, 517.0], [764.0, 541.0], [223.0, 540.0]], "text": "他俩说着话，突然你一下儿、我一下儿地打起来了。", "confidence": 0.8793095474441847, "needs_review": false}, {"bbox": [[128.0, 578.0], [388.0, 578.0], [388.0, 600.0], [128.0, 600.0]], "text": "（六36】东一A，西一A", "confidence": 0.7803957599859971, "needs_review": false}, {"bbox": [[224.0, 620.0], [690.0, 620.0], [690.0, 643.0], [224.0, 643.0]], "text": "天黑还下雨，他东一脚，西一脚地赶回来了。", "confidence": 0.8669288839612689, "needs_review": false}, {"bbox": [[225.0, 662.0], [642.0, 662.0], [642.0, 685.0], [225.0, 685.0]], "text": "他说话东一句，西一句，完全没有重点。", "confidence": 0.8996504764807852, "needs_review": false}, {"bbox": [[225.0, 703.0], [815.0, 703.0], [815.0, 725.0], [225.0, 725.0]], "text": "他做事情总是东一下儿，西一下儿，既无计划更无耐心。", "confidence": 0.8801755744677323, "needs_review": false}, {"bbox": [[128.0, 763.0], [390.0, 760.0], [390.0, 786.0], [129.0, 789.0]], "text": "【六37】为了.··而····", "confidence": 0.5977727696299553, "needs_review": false}, {"bbox": [[225.0, 806.0], [594.0, 806.0], [594.0, 829.0], [225.0, 829.0]], "text": "为了这么一件小事而生气，不值得。", "confidence": 0.8943299791392159, "needs_review": false}, {"bbox": [[224.0, 846.0], [547.0, 846.0], [547.0, 869.0], [224.0, 869.0]], "text": "他为了这次比赛而努力了很久。", "confidence": 0.877055577437083, "needs_review": false}, {"bbox": [[223.0, 888.0], [662.0, 888.0], [662.0, 911.0], [223.0, 911.0]], "text": "这是为了讨论改善环境问题而召开的会议。", "confidence": 0.8936275690793991, "needs_review": false}, {"bbox": [[128.0, 952.0], [193.0, 952.0], [193.0, 976.0], [128.0, 976.0]], "text": "A.6.5", "confidence": 0.7951570550600687, "needs_review": false}, {"bbox": [[206.0, 950.0], [307.0, 950.0], [307.0, 976.0], [206.0, 976.0]], "text": "句子成分", "confidence": 0.7977165579795837, "needs_review": false}, {"bbox": [[126.0, 1013.0], [282.0, 1013.0], [282.0, 1043.0], [126.0, 1043.0]], "text": "A.6.5.1宾语", "confidence": 0.8953769564628601, "needs_review": false}, {"bbox": [[128.0, 1080.0], [411.0, 1080.0], [411.0, 1102.0], [128.0, 1102.0]], "text": "（六38】宾语的语义类型2", "confidence": 0.8613657483032772, "needs_review": false}, {"bbox": [[174.0, 1122.0], [321.0, 1122.0], [321.0, 1145.0], [174.0, 1145.0]], "text": "（1）处所宾语", "confidence": 0.8352963924407959, "needs_review": false}, {"bbox": [[223.0, 1160.0], [546.0, 1161.0], [546.0, 1185.0], [223.0, 1184.0]], "text": "听见铃声，他马上就进教室了。", "confidence": 0.8793889840443929, "needs_review": false}, {"bbox": [[225.0, 1202.0], [462.0, 1202.0], [462.0, 1225.0], [225.0, 1225.0]], "text": "他把东西都放桌子上了", "confidence": 0.8945017782124606, "needs_review": false}, {"bbox": [[173.0, 1240.0], [320.0, 1240.0], [320.0, 1263.0], [173.0, 1263.0]], "text": "（2）结果宾语", "confidence": 0.8711730018258095, "needs_review": false}, {"bbox": [[221.0, 1277.0], [575.0, 1277.0], [575.0, 1306.0], [221.0, 1306.0]], "text": "在中国农村，盖房子是一件大事。", "confidence": 0.9305495508015156, "needs_review": false}, {"bbox": [[222.0, 1317.0], [714.0, 1318.0], [714.0, 1345.0], [222.0, 1344.0]], "text": "新学期的学生太多了，学校正在校园里建食堂。", "confidence": 0.8939917683601379, "needs_review": false}, {"bbox": [[128.0, 1380.0], [281.0, 1380.0], [281.0, 1407.0], [128.0, 1407.0]], "text": "A.6.5.2补语", "confidence": 0.8780988812446594, "needs_review": false}, {"bbox": [[129.0, 1447.0], [341.0, 1447.0], [341.0, 1470.0], [129.0, 1470.0]], "text": "【六39】趋向补语5", "confidence": 0.8333871852267872, "needs_review": false}, {"bbox": [[225.0, 1489.0], [945.0, 1489.0], [945.0, 1509.0], [225.0, 1509.0]], "text": "表示状态意义（引申用法）：动词/形容词+下来/下去/起来/过来", "confidence": 0.8767427690327168, "needs_review": false}, {"bbox": [[224.0, 1530.0], [642.0, 1530.0], [642.0, 1553.0], [224.0, 1553.0]], "text": "老师一进教室，同学们很快安静了下来。", "confidence": 0.8632623898355585, "needs_review": false}, {"bbox": [[223.0, 1569.0], [545.0, 1571.0], [545.0, 1597.0], [223.0, 1595.0]], "text": "他对工作的兴趣渐渐淡了下去。", "confidence": 0.8965791861216227, "needs_review": false}, {"bbox": [[224.0, 1613.0], [452.0, 1613.0], [452.0, 1635.0], [224.0, 1635.0]], "text": "我们先把礼物藏起来。", "confidence": 0.8850692348046736, "needs_review": false}, {"bbox": [[224.0, 1653.0], [591.0, 1653.0], [591.0, 1676.0], [224.0, 1676.0]], "text": "经过医生的抢救，他终于醒过来了。", "confidence": 0.9312168570125804, "needs_review": false}, {"bbox": [[153.0, 1786.0], [190.0, 1786.0], [190.0, 1809.0], [153.0, 1809.0]], "text": "232", "confidence": 0.652088463306427, "needs_review": false}]