[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.7817536913431608, "needs_review": false}, {"bbox": [[257.0, 225.0], [604.0, 225.0], [604.0, 245.0], [257.0, 245.0]], "text": "长大以后，我时常怀念我的故乡。", "confidence": 0.8934038169682026, "needs_review": false}, {"bbox": [[257.0, 265.0], [626.0, 265.0], [626.0, 288.0], [257.0, 288.0]], "text": "在国外，我时刻想念着国内的亲人。", "confidence": 0.8702441033195046, "needs_review": false}, {"bbox": [[258.0, 307.0], [579.0, 307.0], [579.0, 329.0], [258.0, 329.0]], "text": "十年过去了，他依旧住在那里。", "confidence": 0.919825037320455, "needs_review": false}, {"bbox": [[256.0, 346.0], [434.0, 346.0], [434.0, 372.0], [256.0, 372.0]], "text": "他一向不爱说话。", "confidence": 0.8486879997783237, "needs_review": false}, {"bbox": [[161.0, 409.0], [569.0, 409.0], [569.0, 432.0], [161.0, 432.0]], "text": "【五06】频率、重复副词：偶尔、再次", "confidence": 0.9160562251743517, "needs_review": false}, {"bbox": [[257.0, 451.0], [603.0, 451.0], [603.0, 473.0], [257.0, 473.0]], "text": "他不常请假，只是偶尔迟到一次。", "confidence": 0.8742040246725082, "needs_review": false}, {"bbox": [[257.0, 491.0], [602.0, 491.0], [602.0, 514.0], [257.0, 514.0]], "text": "我们决不让类似的事情再次发生。", "confidence": 0.8380351178348064, "needs_review": false}, {"bbox": [[161.0, 552.0], [423.0, 552.0], [423.0, 575.0], [161.0, 575.0]], "text": "【五07】方式副词：偷偷", "confidence": 0.8763081614787762, "needs_review": false}, {"bbox": [[256.0, 592.0], [509.0, 592.0], [509.0, 618.0], [256.0, 618.0]], "text": "我偷偷送给他一件礼物。", "confidence": 0.9018834879000982, "needs_review": false}, {"bbox": [[256.0, 634.0], [508.0, 634.0], [508.0, 660.0], [256.0, 660.0]], "text": "她偷偷地从窗户向外看。", "confidence": 0.8645849029223124, "needs_review": false}, {"bbox": [[160.0, 694.0], [1155.0, 695.0], [1155.0, 720.0], [160.0, 719.0]], "text": "【五08】语气副词：毕竟、不免、差（一）点儿、倒是、干脆、就4、居然、可2、明明、总算", "confidence": 0.9166988608512011, "needs_review": false}, {"bbox": [[969.0, 724.0], [1071.0, 733.0], [1065.0, 797.0], [963.0, 788.0]], "text": "", "confidence": 1e-50, "needs_review": true}, {"bbox": [[255.0, 736.0], [507.0, 736.0], [507.0, 759.0], [255.0, 759.0]], "text": "不要怪他，他毕竟还小。", "confidence": 0.8987692594528198, "needs_review": false}, {"bbox": [[256.0, 777.0], [602.0, 777.0], [602.0, 800.0], [256.0, 800.0]], "text": "第一次参加考试，不免有些紧张。", "confidence": 0.9230225421488285, "needs_review": false}, {"bbox": [[255.0, 817.0], [507.0, 817.0], [507.0, 839.0], [255.0, 839.0]], "text": "我今天上学差点儿迟到。", "confidence": 0.8774666090806326, "needs_review": false}, {"bbox": [[256.0, 857.0], [651.0, 857.0], [651.0, 880.0], [256.0, 880.0]], "text": "这种做法倒是怪新鲜的，从来没见过。", "confidence": 0.897373206085629, "needs_review": false}, {"bbox": [[255.0, 898.0], [690.0, 898.0], [690.0, 921.0], [255.0, 921.0]], "text": "这个人不讲道理，我们干脆不和他合作了", "confidence": 0.842997481948451, "needs_review": false}, {"bbox": [[255.0, 935.0], [459.0, 937.0], [459.0, 963.0], [255.0, 960.0]], "text": "别劝我，我就要去。", "confidence": 0.8776380717754364, "needs_review": false}, {"bbox": [[257.0, 978.0], [582.0, 978.0], [582.0, 1001.0], [257.0, 1001.0]], "text": "没想到，这件事居然是她干的。", "confidence": 0.8379917899767558, "needs_review": false}, {"bbox": [[257.0, 1020.0], [506.0, 1020.0], [506.0, 1040.0], [257.0, 1040.0]], "text": "我可记不住这么多生词。", "confidence": 0.9028892815113068, "needs_review": false}, {"bbox": [[255.0, 1056.0], [678.0, 1057.0], [678.0, 1084.0], [255.0, 1083.0]], "text": "明明是你做的，为什么要说是别人做的？", "confidence": 0.865901297644565, "needs_review": false}, {"bbox": [[255.0, 1098.0], [457.0, 1098.0], [457.0, 1121.0], [255.0, 1121.0]], "text": "这本书总算学完了。", "confidence": 0.787322461605072, "needs_review": false}, {"bbox": [[161.0, 1160.0], [313.0, 1160.0], [313.0, 1187.0], [161.0, 1187.0]], "text": "A.5.1.4介词", "confidence": 0.8236098706722259, "needs_review": false}, {"bbox": [[162.0, 1227.0], [287.0, 1227.0], [287.0, 1247.0], [162.0, 1247.0]], "text": "A.5.1.4.1", "confidence": 0.8411621451377869, "needs_review": false}, {"bbox": [[280.0, 1223.0], [455.0, 1223.0], [455.0, 1249.0], [280.0, 1249.0]], "text": "引出时间、处所", "confidence": 0.7883597314357758, "needs_review": false}, {"bbox": [[161.0, 1288.0], [304.0, 1288.0], [304.0, 1312.0], [161.0, 1312.0]], "text": "【五09】随着", "confidence": 0.8478696346282959, "needs_review": false}, {"bbox": [[258.0, 1329.0], [700.0, 1329.0], [700.0, 1352.0], [258.0, 1352.0]], "text": "随着时间的推进，我慢慢理解了他的做法。", "confidence": 0.8974861830472947, "needs_review": false}, {"bbox": [[256.0, 1367.0], [601.0, 1367.0], [601.0, 1390.0], [256.0, 1390.0]], "text": "随着冬天的到来，房间越来越冷。", "confidence": 0.8827862031757832, "needs_review": false}, {"bbox": [[162.0, 1432.0], [451.0, 1432.0], [451.0, 1455.0], [162.0, 1455.0]], "text": "A.5.1.4.2引出施事、受事", "confidence": 0.8252375756993013, "needs_review": false}, {"bbox": [[160.0, 1492.0], [282.0, 1492.0], [282.0, 1519.0], [160.0, 1519.0]], "text": "【五10】将", "confidence": 0.8148999639919826, "needs_review": false}, {"bbox": [[257.0, 1535.0], [506.0, 1535.0], [506.0, 1558.0], [257.0, 1558.0]], "text": "父母将他送到中国留学。", "confidence": 0.8517754077911377, "needs_review": false}, {"bbox": [[255.0, 1572.0], [485.0, 1574.0], [485.0, 1600.0], [255.0, 1598.0]], "text": "禁止将书带出阅览室。", "confidence": 0.8264545473185453, "needs_review": false}, {"bbox": [[157.0, 1633.0], [297.0, 1628.0], [298.0, 1659.0], [158.0, 1663.0]], "text": "【五11】由²", "confidence": 0.8115057945251465, "needs_review": false}, {"bbox": [[255.0, 1674.0], [483.0, 1675.0], [483.0, 1699.0], [255.0, 1698.0]], "text": "这道题由你来回答吧。", "confidence": 0.8929861946539446, "needs_review": false}, {"bbox": [[256.0, 1716.0], [483.0, 1716.0], [483.0, 1739.0], [256.0, 1739.0]], "text": "这件事情由班长负责。", "confidence": 0.840188058939847, "needs_review": false}, {"bbox": [[1178.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1178.0, 1809.0]], "text": "217", "confidence": 0.6162603348493576, "needs_review": false}]