[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.796912417962001, "needs_review": false}, {"bbox": [[207.0, 223.0], [692.0, 223.0], [692.0, 246.0], [207.0, 246.0]], "text": "（2）主语+把+宾语1+动词（+给）+宾语2", "confidence": 0.8207478600999584, "needs_review": false}, {"bbox": [[258.0, 267.0], [555.0, 267.0], [555.0, 290.0], [258.0, 290.0]], "text": "爸爸把新买的手机送妹妹了。", "confidence": 0.8684106171131134, "needs_review": false}, {"bbox": [[258.0, 309.0], [507.0, 309.0], [507.0, 331.0], [258.0, 331.0]], "text": "他们把作业交给老师了。", "confidence": 0.9117479622364044, "needs_review": false}, {"bbox": [[207.0, 351.0], [854.0, 351.0], [854.0, 374.0], [207.0, 374.0]], "text": "（3）主语+把+宾语+动词+结果补语／趋向补语／状态补语", "confidence": 0.8673370172237528, "needs_review": false}, {"bbox": [[258.0, 394.0], [508.0, 394.0], [508.0, 417.0], [258.0, 417.0]], "text": "你把书架上的书放整齐。", "confidence": 0.888343021273613, "needs_review": false}, {"bbox": [[258.0, 437.0], [530.0, 437.0], [530.0, 459.0], [258.0, 459.0]], "text": "他把洗好的衣服拿回来了。", "confidence": 0.8776570237599887, "needs_review": false}, {"bbox": [[256.0, 479.0], [555.0, 479.0], [555.0, 502.0], [256.0, 502.0]], "text": "孩子们把手洗得干干净净的。", "confidence": 0.8678966079439435, "needs_review": false}, {"bbox": [[161.0, 540.0], [825.0, 541.0], [825.0, 565.0], [161.0, 564.0]], "text": "【三55】被动句1：主语+被／叫／让+宾语+动词+其他成分", "confidence": 0.8884707669417063, "needs_review": false}, {"bbox": [[256.0, 583.0], [507.0, 583.0], [507.0, 606.0], [256.0, 606.0]], "text": "那个手机早被我用坏了。", "confidence": 0.8742098957300186, "needs_review": false}, {"bbox": [[254.0, 623.0], [507.0, 623.0], [507.0, 649.0], [254.0, 649.0]], "text": "我的词典叫弟弟弄脏了。", "confidence": 0.8594685246547064, "needs_review": false}, {"bbox": [[257.0, 668.0], [529.0, 668.0], [529.0, 691.0], [257.0, 691.0]], "text": "他完全让这位姑娘迷住了。", "confidence": 0.9040662737993094, "needs_review": false}, {"bbox": [[160.0, 729.0], [349.0, 729.0], [349.0, 755.0], [160.0, 755.0]], "text": "【三56】连动句2", "confidence": 0.8282714396715164, "needs_review": false}, {"bbox": [[207.0, 774.0], [546.0, 774.0], [546.0, 797.0], [207.0, 797.0]], "text": "（1）前一动作是后一动作的方式", "confidence": 0.8833068571984768, "needs_review": false}, {"bbox": [[254.0, 814.0], [476.0, 811.0], [476.0, 840.0], [254.0, 844.0]], "text": "他笑着说：“没事儿。”", "confidence": 0.890482634305954, "needs_review": false}, {"bbox": [[257.0, 858.0], [483.0, 858.0], [483.0, 881.0], [257.0, 881.0]], "text": "我明天坐飞机去北京。", "confidence": 0.8594954122196544, "needs_review": false}, {"bbox": [[208.0, 903.0], [545.0, 903.0], [545.0, 923.0], [208.0, 923.0]], "text": "（2）后一动作是前一动作的自的", "confidence": 0.8478195779025555, "needs_review": false}, {"bbox": [[257.0, 944.0], [435.0, 944.0], [435.0, 967.0], [257.0, 967.0]], "text": "他去超市买水果。", "confidence": 0.8444761236508688, "needs_review": false}, {"bbox": [[257.0, 986.0], [459.0, 986.0], [459.0, 1009.0], [257.0, 1009.0]], "text": "我来中国学习中文。", "confidence": 0.893371194601059, "needs_review": false}, {"bbox": [[594.0, 1005.0], [662.0, 1018.0], [650.0, 1080.0], [583.0, 1068.0]], "text": "", "confidence": 1e-50, "needs_review": true}, {"bbox": [[160.0, 1047.0], [348.0, 1047.0], [348.0, 1073.0], [160.0, 1073.0]], "text": "【三57】兼语句1", "confidence": 0.8722311139106751, "needs_review": false}, {"bbox": [[257.0, 1092.0], [885.0, 1092.0], [885.0, 1114.0], [257.0, 1114.0]], "text": "表使令：主语+叫/派/请/让.·+宾语1+动词+宾语2", "confidence": 0.8361921342355865, "needs_review": false}, {"bbox": [[254.0, 1129.0], [627.0, 1131.0], [627.0, 1160.0], [254.0, 1158.0]], "text": "经理叫他介绍一下儿中国市场情况。", "confidence": 0.9392507426878985, "needs_review": false}, {"bbox": [[255.0, 1174.0], [532.0, 1175.0], [532.0, 1201.0], [255.0, 1200.0]], "text": "公司派我来中国学习中文。", "confidence": 0.9102454873231741, "needs_review": false}, {"bbox": [[254.0, 1215.0], [459.0, 1217.0], [459.0, 1243.0], [254.0, 1241.0]], "text": "我请他去我家玩儿。", "confidence": 0.8619662582874298, "needs_review": false}, {"bbox": [[255.0, 1259.0], [482.0, 1260.0], [482.0, 1284.0], [255.0, 1283.0]], "text": "妈妈让我早点儿回国。", "confidence": 0.8004831021482294, "needs_review": false}, {"bbox": [[161.0, 1322.0], [349.0, 1322.0], [349.0, 1348.0], [161.0, 1348.0]], "text": "【三58】比较句4", "confidence": 0.8514821887016296, "needs_review": false}, {"bbox": [[206.0, 1365.0], [553.0, 1365.0], [553.0, 1388.0], [206.0, 1388.0]], "text": "（1）A比B+动词＋得＋形容词", "confidence": 0.8175513371825218, "needs_review": false}, {"bbox": [[255.0, 1407.0], [409.0, 1407.0], [409.0, 1431.0], [255.0, 1431.0]], "text": "我比他跑得快。", "confidence": 0.6966036781668663, "needs_review": false}, {"bbox": [[256.0, 1451.0], [531.0, 1451.0], [531.0, 1474.0], [256.0, 1474.0]], "text": "我说中文比妹妹说得流利。", "confidence": 0.9082314463762137, "needs_review": false}, {"bbox": [[206.0, 1493.0], [452.0, 1493.0], [452.0, 1516.0], [206.0, 1516.0]], "text": "（2）A不比B+形容词", "confidence": 0.8334756145874659, "needs_review": false}, {"bbox": [[256.0, 1536.0], [434.0, 1536.0], [434.0, 1559.0], [256.0, 1559.0]], "text": "我姐姐不比我高。", "confidence": 0.8748313387235006, "needs_review": false}, {"bbox": [[255.0, 1579.0], [506.0, 1579.0], [506.0, 1602.0], [255.0, 1602.0]], "text": "这个笔记本不比那个大。", "confidence": 0.8226007223129272, "needs_review": false}, {"bbox": [[206.0, 1620.0], [589.0, 1620.0], [589.0, 1643.0], [206.0, 1643.0]], "text": "（3）A+动词+得+比+B+形容词", "confidence": 0.8463364243507385, "needs_review": false}, {"bbox": [[256.0, 1663.0], [410.0, 1663.0], [410.0, 1687.0], [256.0, 1687.0]], "text": "我跑得比他快。", "confidence": 0.8361587449908257, "needs_review": false}, {"bbox": [[256.0, 1706.0], [507.0, 1706.0], [507.0, 1729.0], [256.0, 1729.0]], "text": "姐姐中文说得比我流利。", "confidence": 0.865173950791359, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1215.0, 1786.0], [1215.0, 1809.0], [1179.0, 1809.0]], "text": "201", "confidence": 0.7437281161546707, "needs_review": false}]