[{"bbox": [[130.0, 165.0], [300.0, 165.0], [300.0, 188.0], [130.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.8139417629975539, "needs_review": false}, {"bbox": [[126.0, 222.0], [331.0, 222.0], [331.0, 248.0], [126.0, 248.0]], "text": "【七一九030】不妨", "confidence": 0.8583289980888367, "needs_review": false}, {"bbox": [[285.0, 266.0], [677.0, 266.0], [677.0, 286.0], [285.0, 286.0]], "text": "据说这个药效果很好，你不妨试一试。", "confidence": 0.8927848305967119, "needs_review": false}, {"bbox": [[285.0, 307.0], [751.0, 307.0], [751.0, 329.0], [285.0, 329.0]], "text": "关于这个问题，咱们不妨听一听别人的建议。", "confidence": 0.9027985277630034, "needs_review": false}, {"bbox": [[127.0, 366.0], [331.0, 364.0], [332.0, 390.0], [128.0, 392.0]], "text": "【七一九031】何必", "confidence": 0.8429796208034862, "needs_review": false}, {"bbox": [[284.0, 409.0], [632.0, 409.0], [632.0, 432.0], [284.0, 432.0]], "text": "我只是和你开玩笑，何必当真呢？", "confidence": 0.8914556764066219, "needs_review": false}, {"bbox": [[284.0, 447.0], [608.0, 450.0], [608.0, 475.0], [284.0, 473.0]], "text": "咱们是老同学，何必这么客气。", "confidence": 0.8694100737571716, "needs_review": false}, {"bbox": [[129.0, 511.0], [332.0, 511.0], [332.0, 534.0], [129.0, 534.0]], "text": "【七一九032】莫非", "confidence": 0.8474899367852644, "needs_review": false}, {"bbox": [[285.0, 553.0], [659.0, 553.0], [659.0, 576.0], [285.0, 576.0]], "text": "她今天没来学校，莫非出了什么事？", "confidence": 0.9104330925380483, "needs_review": false}, {"bbox": [[285.0, 592.0], [898.0, 593.0], [898.0, 617.0], [285.0, 616.0]], "text": "你平时不认真学习，莫非要等到期末考试了才开始紧张吗？", "confidence": 0.917411967560097, "needs_review": false}, {"bbox": [[127.0, 653.0], [331.0, 651.0], [332.0, 678.0], [128.0, 680.0]], "text": "【七一九033】白白", "confidence": 0.8515214811671864, "needs_review": false}, {"bbox": [[286.0, 695.0], [679.0, 695.0], [679.0, 717.0], [286.0, 717.0]], "text": "她忘了关水龙头，白白浪费了很多水。", "confidence": 0.9121807681189643, "needs_review": false}, {"bbox": [[285.0, 735.0], [752.0, 735.0], [752.0, 755.0], [285.0, 755.0]], "text": 