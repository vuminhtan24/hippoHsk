eds_review": false}, {"bbox": [[283.0, 1304.0], [705.0, 1305.0], [705.0, 1331.0], [283.0, 1330.0]], "text": "好在他病得不重，应该马上就能上班了。", "confidence": 0.9026071397881759, "needs_review": false}, {"bbox": [[127.0, 1365.0], [307.0, 1365.0], [307.0, 1391.0], [127.0, 1391.0]], "text": "【七一九038】乃", "confidence": 0.7582704931497574, "needs_review": false}, {"bbox": [[286.0, 1409.0], [646.0, 1409.0], [646.0, 1432.0], [286.0, 1432.0]], "text": "《红楼梦》乃古代小说的杰出代表。", "confidence": 0.8651667132097132, "needs_review": false}, {"bbox": [[284.0, 1448.0], [464.0, 1450.0], [464.0, 1474.0], [284.0, 1472.0]], "text": "失败乃成功之母。", "confidence": 0.8491982950104607, "needs_review": false}, {"bbox": [[128.0, 1509.0], [333.0, 1509.0], [333.0, 1535.0], [128.0, 1535.0]], "text": "【七一九039】难怪", "confidence": 0.8631930242885243, "needs_review": false}, {"bbox": [[286.0, 1554.0], [678.0, 1554.0], [678.0, 1574.0], [286.0, 1574.0]], "text": "这道题非常难，难怪她一时答不出来。", "confidence": 0.8944393926196628, "needs_review": false}, {"bbox": [[286.0, 1594.0], [609.0, 1594.0], [609.0, 1616.0], [286.0, 1616.0]], "text": "他是个东北人，难怪他不怕冷。", "confidence": 0.9053107380867005, "needs_review": false}, {"bbox": [[128.0, 1653.0], [332.0, 1653.0], [332.0, 1679.0], [128.0, 1679.0]], "text": "【七一九040】偏偏", "confidence": 0.851359795440327, "needs_review": false}, {"bbox": [[286.0, 1696.0], [753.0, 1696.0], [753.0, 1719.0], [286.0, 1719.0]], "text": "周围这么多漂亮的女生，你怎么偏偏喜欢她？", "confidence": 0.917245002019973, "needs_review": false}, {"bbox": [[286.0, 1738.0], [824.0, 1738.0], [824.0, 1760.0], [286.0, 1760.0]], "text": "我们已经穿好衣服准备要走了，可孩子偏偏又醒了。", "confidence": 0.9436306034525236, "needs_review": false}, {"bbox": [[153.0, 1786.0], [190.0, 1786.0], [190.0, 1809.0], [153.0, 1809.0]], "text": "240", "confidence": 0.6505880951881409, "needs_review": false}]