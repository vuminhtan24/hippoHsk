[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.8008711154644306, "needs_review": false}, {"bbox": [[160.0, 222.0], [342.0, 222.0], [342.0, 248.0], [160.0, 248.0]], "text": "A.4.3固定格式", "confidence": 0.8711733758449555, "needs_review": false}, {"bbox": [[161.0, 286.0], [530.0, 286.0], [530.0, 312.0], [161.0, 312.0]], "text": "【四29】一+量词+比+一+量词", "confidence": 0.8112549957107095, "needs_review": false}, {"bbox": [[255.0, 329.0], [533.0, 329.0], [533.0, 352.0], [255.0, 352.0]], "text": "这些球鞋一双比一双好看。", "confidence": 0.756156875536992, "needs_review": false}, {"bbox": [[257.0, 371.0], [532.0, 371.0], [532.0, 394.0], [257.0, 394.0]], "text": "他的演出一次比一次精彩。", "confidence": 0.9085412804897015, "needs_review": false}, {"bbox": [[256.0, 412.0], [483.0, 412.0], [483.0, 435.0], [256.0, 435.0]], "text": "天气一天比一天暖和。", "confidence": 0.8232901854948564, "needs_review": false}, {"bbox": [[161.0, 471.0], [415.0, 471.0], [415.0, 497.0], [161.0, 497.0]], "text": "【四30】（自）…··以来", "confidence": 0.7734853156975338, "needs_review": false}, {"bbox": [[258.0, 513.0], [606.0, 513.0], [606.0, 539.0], [258.0, 539.0]], "text": "自去年以来，我一直生活在北京。", "confidence": 0.8456144593656063, "needs_review": false}, {"bbox": [[258.0, 556.0], [626.0, 556.0], [626.0, 579.0], [258.0, 579.0]], "text": "上大学以来，他一直坚持学习中文。", "confidence": 0.9169285858378691, "needs_review": false}, {"bbox": [[259.0, 597.0], [602.0, 597.0], [602.0, 620.0], [259.0, 620.0]], "text": "自有了孩子以来，她每天都很忙。", "confidence": 0.9156544283032417, "needs_review": false}, {"bbox": [[161.0, 656.0], [377.0, 656.0], [377.0, 682.0], [161.0, 682.0]], "text": "【四31】由···组成", "confidence": 0.7423948099215826, "needs_review": false}, {"bbox": [[257.0, 700.0], [650.0, 700.0], [650.0, 722.0], [257.0, 722.0]], "text": "我们班由两位老师和二十位学生组成。", "confidence": 0.8306301633516947, "needs_review": false}, {"bbox": [[256.0, 741.0], [531.0, 741.0], [531.0, 764.0], [256.0, 764.0]], "text": "这篇文章由三个部分组成。", "confidence": 0.8430019204433148, "needs_review": false}, {"bbox": [[255.0, 783.0], [749.0, 783.0], [749.0, 806.0], [255.0, 806.0]], "text": "这张试卷是由十道选择题和一道写作题组成的。", "confidence": 0.890450350262902, "needs_review": false}, {"bbox": [[160.0, 840.0], [376.0, 843.0], [376.0, 868.0], [160.0, 866.0]], "text": "【四32】在·方面", "confidence": 0.8159032702445984, "needs_review": false}, {"bbox": [[257.0, 885.0], [556.0, 885.0], [556.0, 908.0], [257.0, 908.0]], "text": "在这方面，我没有什么经验。", "confidence": 0.8950547065053668, "needs_review": false}, {"bbox": [[257.0, 926.0], [556.0, 926.0], [556.0, 949.0], [257.0, 949.0]], "text": "在历史方面，他知道得很多。", "confidence": 0.8879894273621696, "needs_review": false}, {"bbox": [[257.0, 968.0], [579.0, 968.0], [579.0, 990.0], [257.0, 990.0]], "text": "在修理电脑方面，她是个专家。", "confidence": 0.876784372329712, "needs_review": false}, {"bbox": [[162.0, 1028.0], [438.0, 1028.0], [438.0, 1051.0], [162.0, 1051.0]], "text": "【四33】在····上／下／中", "confidence": 0.7173929549753666, "needs_review": false}, {"bbox": [[256.0, 1068.0], [667.0, 1068.0], [667.0, 1094.0], [256.0, 1094.0]], "text": "在这件事情上，最好多听听父母的意见", "confidence": 0.8913116123941209, "needs_review": false}, {"bbox": [[256.0, 1107.0], [611.0, 1109.0], [611.0, 1136.0], [256.0, 1134.0]], "text": "在他的影响下，我喜欢上了中文。", "confidence": 0.8678572811186314, "needs_review": false}, {"bbox": [[256.0, 1151.0], [699.0, 1151.0], [699.0, 1177.0], [256.0, 1177.0]], "text": "在这篇课文中，我们一共学了三十个生词。", "confidence": 0.897126117348671, "needs_review": false}, {"bbox": [[161.0, 1217.0], [244.0, 1217.0], [244.0, 1240.0], [161.0, 1240.0]], "text": "A.4.4", "confidence": 0.829344242811203, "needs_review": false}, {"bbox": [[241.0, 1217.0], [341.0, 1217.0], [341.0, 1240.0], [241.0, 1240.0]], "text": "句子成分", "confidence": 0.7693325161933899, "needs_review": false}, {"bbox": [[161.0, 1281.0], [245.0, 1281.0], [245.0, 1305.0], [161.0, 1305.0]], "text": "A.4.4.1", "confidence": 0.8723080530762672, "needs_review": false}, {"bbox": [[257.0, 1280.0], [313.0, 1280.0], [313.0, 1305.0], [257.0, 1305.0]], "text": "主语", "confidence": 0.6508248448371887, "needs_review": false}, {"bbox": [[162.0, 1346.0], [424.0, 1346.0], [424.0, 1368.0], [162.0, 1368.0]], "text": "【四34】主谓短语作主语", "confidence": 0.8632746659792386, "needs_review": false}, {"bbox": [[257.0, 1385.0], [410.0, 1385.0], [410.0, 1409.0], [257.0, 1409.0]], "text": "他不去也可以。", "confidence": 0.863758809864521, "needs_review": false}, {"bbox": [[257.0, 1426.0], [435.0, 1426.0], [435.0, 1452.0], [257.0, 1452.0]], "text": "身体健康很重要。", "confidence": 0.8479948971006606, "needs_review": false}, {"bbox": [[256.0, 1469.0], [799.0, 1469.0], [799.0, 1494.0], [256.0, 1494.0]], "text": "我参加中文水平考试是为了获得奖学金去中国留学。", "confidence": 0.9474032272895178, "needs_review": false}, {"bbox": [[162.0, 1530.0], [352.0, 1530.0], [352.0, 1553.0], [162.0, 1553.0]], "text": "【四35】受事主语", "confidence": 0.8054413557052612, "needs_review": false}, {"bbox": [[255.0, 1569.0], [387.0, 1569.0], [387.0, 1596.0], [255.0, 1596.0]], "text": "饭都吃光了。", "confidence": 0.7663079329899379, "needs_review": false}, {"bbox": [[258.0, 1613.0], [411.0, 1613.0], [411.0, 1636.0], [258.0, 1636.0]], "text": "作业我做完了。", "confidence": 0.8079970180988312, "needs_review": false}, {"bbox": [[253.0, 1653.0], [531.0, 1650.0], [532.0, 1677.0], [253.0, 1680.0]], "text": "这本书我已经看过三遍了。", "confidence": 0.8784675781543438, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1215.0, 1786.0], [1215.0, 1809.0], [1179.0, 1809.0]], "text": "209", "confidence": 0.7429972589015961, "needs_review": false}]