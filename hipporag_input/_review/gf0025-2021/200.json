[{"bbox": [[131.0, 167.0], [299.0, 167.0], [299.0, 187.0], [131.0, 187.0]], "text": "GF0025—2021", "confidence": 0.8766308973232905, "needs_review": false}, {"bbox": [[224.0, 224.0], [498.0, 224.0], [498.0, 247.0], [224.0, 247.0]], "text": "我们班就他知道这个消息。", "confidence": 0.8915473406131451, "needs_review": false}, {"bbox": [[223.0, 265.0], [402.0, 265.0], [402.0, 288.0], [223.0, 288.0]], "text": "我就拿了一支笔。", "confidence": 0.8744660880830553, "needs_review": false}, {"bbox": [[224.0, 307.0], [472.0, 307.0], [472.0, 329.0], [224.0, 329.0]], "text": "教室里至少有五十个人。", "confidence": 0.8565361797809601, "needs_review": false}, {"bbox": [[129.0, 367.0], [1080.0, 367.0], [1080.0, 390.0], [129.0, 390.0]], "text": "【三14】时间副词：本来、才2、曾经、从来、赶紧、赶快、立刻、连忙、始终、已、早已", "confidence": 0.9077126809528896, "needs_review": false}, {"bbox": [[224.0, 407.0], [691.0, 408.0], [691.0, 434.0], [224.0, 433.0]], "text": "会议本来在星期一举行，但是现在改时间了。", "confidence": 0.8979595218385968, "needs_review": false}, {"bbox": [[225.0, 451.0], [521.0, 451.0], [521.0, 473.0], [225.0, 473.0]], "text": "他才起床，让我们等一下儿。", "confidence": 0.883275432246072, "needs_review": false}, {"bbox": [[225.0, 491.0], [428.0, 491.0], [428.0, 514.0], [225.0, 514.0]], "text": "你怎么才来就要走？", "confidence": 0.7970547616481781, "needs_review": false}, {"bbox": [[223.0, 534.0], [450.0, 534.0], [450.0, 557.0], [223.0, 557.0]], "text": "我曾经学过一年中文。", "confidence": 0.8368449698794972, "needs_review": false}, {"bbox": [[224.0, 575.0], [379.0, 575.0], [379.0, 597.0], [224.0, 597.0]], "text": "他从来不喝酒。", "confidence": 0.7932820692658424, "needs_review": false}, {"bbox": [[225.0, 616.0], [592.0, 616.0], [592.0, 636.0], [225.0, 636.0]], "text": "听到这个消息，他赶紧跑回家去了。", "confidence": 0.8360486942179063, "needs_review": false}, {"bbox": [[224.0, 657.0], [594.0, 657.0], [594.0, 680.0], [224.0, 680.0]], "text": "听到有人叫他的名字，他赶紧开门。", "confidence": 0.9294320415048039, "needs_review": false}, {"bbox": [[225.0, 699.0], [614.0, 699.0], [614.0, 721.0], [225.0, 721.0]], "text": "他很不舒服，我们要赶快送他去医院。", "confidence": 0.8907535009913974, "needs_review": false}, {"bbox": [[223.0, 740.0], [619.0, 740.0], [619.0, 763.0], [223.0, 763.0]], "text": "经理来电话，叫我立刻去她的办公室。", "confidence": 0.9150803254710304, "needs_review": false}, {"bbox": [[223.0, 782.0], [668.0, 782.0], [668.0, 805.0], [223.0, 805.0]], "text": "看到一位老人上车，我连忙站起来让他坐。", "confidence": 0.9138723880052566, "needs_review": false}, {"bbox": [[226.0, 825.0], [689.0, 825.0], [689.0, 844.0], [226.0, 844.0]], "text": "她在中国留学的时候，始终坚持每大说中文。", "confidence": 0.9127261922472999, "needs_review": false}, {"bbox": [[224.0, 864.0], [547.0, 864.0], [547.0, 887.0], [224.0, 887.0]], "text": "我们已做好下个月的工作计划。", "confidence": 0.8449654301007589, "needs_review": false}, {"bbox": [[222.0, 903.0], [427.0, 905.0], [427.0, 931.0], [222.0, 929.0]], "text": "他早已离开北京了。", "confidence": 0.8855071842670441, "needs_review": false}, {"bbox": [[128.0, 966.0], [657.0, 967.0], [657.0, 990.0], [128.0, 989.0]], "text": "【三15】频率、重复副词：通常、往往、总、总是", "confidence": 0.9304232820868492, "needs_review": false}, {"bbox": [[224.0, 1008.0], [520.0, 1008.0], [520.0, 1031.0], [224.0, 1031.0]], "text": "李经理通常很早就到公司。", "confidence": 0.8421706786522498, "needs_review": false}, {"bbox": [[224.0, 1050.0], [638.0, 1050.0], [638.0, 1073.0], [224.0, 1073.0]], "text": "为了记住一个汉字，他往往要写很多遍。", "confidence": 0.8610109969189292, "needs_review": false}, {"bbox": [[222.0, 1090.0], [787.0, 1090.0], [787.0, 1115.0], [222.0, 1115.0]], "text": "我总弄不明白什么时候用“把”字，常常一说就错。", "confidence": 0.8994026829799017, "needs_review": false}, {"bbox": [[224.0, 1132.0], [566.0, 1132.0], [566.0, 1155.0], [224.0, 1155.0]], "text": "他去机场总是提前两个小时出发。", "confidence": 0.8761992678046227, "needs_review": false}, {"bbox": [[126.0, 1192.0], [392.0, 1187.0], [392.0, 1216.0], [127.0, 1222.0]], "text": "【三16】关联副词：再", "confidence": 0.8348134259382883, "needs_review": false}, {"bbox": [[222.0, 1232.0], [500.0, 1235.0], [500.0, 1260.0], [222.0, 1258.0]], "text": "我们做完作业再玩儿游戏。", "confidence": 0.8846176725167495, "needs_review": false}, {"bbox": [[225.0, 1276.0], [427.0, 1276.0], [427.0, 1299.0], [225.0, 1299.0]], "text": "你洗了手再吃水果。", "confidence": 0.8313775837421418, "needs_review": false}, {"bbox": [[130.0, 1337.0], [609.0, 1337.0], [609.0, 1359.0], [130.0, 1359.0]], "text": "【三17】方式副词：互相、尽量、亲自、相互", "confidence": 0.9292986501346935, "needs_review": false}, {"bbox": [[223.0, 1376.0], [402.0, 1376.0], [402.0, 1399.0], [223.0, 1399.0]], "text": "大家要互相帮助。", "confidence": 0.8407841324806213, "needs_review": false}, {"bbox": [[224.0, 1418.0], [524.0, 1418.0], [524.0, 1441.0], [224.0, 1441.0]], "text": "志愿者要尽量自己克服困难。", "confidence": 0.893485460962568, "needs_review": false}, {"bbox": [[224.0, 1458.0], [547.0, 1458.0], [547.0, 1481.0], [224.0, 1481.0]], "text": "校长亲自联系学生实习的公司。", "confidence": 0.8836079875628153, "needs_review": false}, {"bbox": [[225.0, 1499.0], [521.0, 1499.0], [521.0, 1519.0], [225.0, 1519.0]], "text": "我们要相互关心，相互照顾。", "confidence": 0.8127371796539852, "needs_review": false}, {"bbox": [[130.0, 1558.0], [463.0, 1558.0], [463.0, 1581.0], [130.0, 1581.0]], "text": "【三18】情态副词：大概、恐怕", "confidence": 0.9117942452430725, "needs_review": false}, {"bbox": [[225.0, 1599.0], [570.0, 1599.0], [570.0, 1621.0], [225.0, 1621.0]], "text": "他病了，今天大概不会来上课了。", "confidence": 0.8387146256864071, "needs_review": false}, {"bbox": [[225.0, 1640.0], [473.0, 1640.0], [473.0, 1660.0], [225.0, 1660.0]], "text": "天这么阴，大概要下雨。", "confidence": 0.8684152662754059, "needs_review": false}, {"bbox": [[224.0, 1679.0], [547.0, 1679.0], [547.0, 1702.0], [224.0, 1702.0]], "text": "我头有点儿疼，恐怕是感冒了。", "confidence": 0.893761936823527, "needs_review": false}, {"bbox": [[224.0, 1719.0], [546.0, 1719.0], [546.0, 1742.0], [224.0, 1742.0]], "text": "他出国恐怕已经有三年多了吧。", "confidence": 0.8520911415417989, "needs_review": false}, {"bbox": [[154.0, 1786.0], [191.0, 1786.0], [191.0, 1809.0], [154.0, 1809.0]], "text": "194", "confidence": 0.7422454804182053, "needs_review": false}]