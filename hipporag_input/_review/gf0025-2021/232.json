[{"bbox": [[130.0, 165.0], [300.0, 165.0], [300.0, 188.0], [130.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.8001112433580252, "needs_review": false}, {"bbox": [[129.0, 221.0], [413.0, 222.0], [413.0, 248.0], [128.0, 247.0]], "text": "【五62】是它，Y也是它", "confidence": 0.8787223742558405, "needs_review": false}, {"bbox": [[223.0, 264.0], [618.0, 264.0], [618.0, 287.0], [223.0, 287.0]], "text": "好是它，坏也是它，你没有别的选择。", "confidence": 0.9168475535180833, "needs_review": false}, {"bbox": [[225.0, 306.0], [739.0, 306.0], [739.0, 328.0], [225.0, 328.0]], "text": "成功是它，失败也是它，这个选择我绝对不后悔。", "confidence": 0.9368722024171249, "needs_review": false}, {"bbox": [[223.0, 345.0], [885.0, 346.0], [885.0, 372.0], [223.0, 371.0]], "text": "等一个小时是它，等两个小时也是它，只能坐这一班车回家了。", "confidence": 0.9002886969467689, "needs_review": false}, {"bbox": [[129.0, 409.0], [371.0, 409.0], [371.0, 432.0], [129.0, 432.0]], "text": "【五63】X着也是X着", "confidence": 0.7669721494118372, "needs_review": false}, {"bbox": [[225.0, 451.0], [644.0, 451.0], [644.0, 473.0], [225.0, 473.0]], "text": "明天我去超市逛逛，反正闲着也是闲着。", "confidence": 0.8809146567394859, "needs_review": false}, {"bbox": [[223.0, 491.0], [763.0, 491.0], [763.0, 514.0], [223.0, 514.0]], "text": "那些衣服她不喜欢了，放着也是放着，不如送人吧。", "confidence": 0.8776328737537066, "needs_review": false}, {"bbox": [[225.0, 533.0], [665.0, 533.0], [665.0, 556.0], [225.0, 556.0]], "text": "反正等着也是等着，我们不如休息休息吧。", "confidence": 0.9447620183229446, "needs_review": false}, {"bbox": [[129.0, 593.0], [387.0, 593.0], [387.0, 616.0], [129.0, 616.0]], "text": "【五64】X归X，Y归Y", "confidence": 0.7210507392883301, "needs_review": false}, {"bbox": [[223.0, 635.0], [595.0, 635.0], [595.0, 658.0], [223.0, 658.0]], "text": "想归想，做归做，结果完全不一样。", "confidence": 0.8791490933474373, "needs_review": false}, {"bbox": [[224.0, 677.0], [596.0, 677.0], [596.0, 700.0], [224.0, 700.0]], "text": "吵归吵，闹归闹，大家还是好朋友。", "confidence": 0.9075041974292082, "needs_review": false}, {"bbox": [[224.0, 716.0], [618.0, 717.0], [618.0, 741.0], [224.0, 740.0]], "text": "朋友归朋友，生意归生意，不能免费。", "confidence": 0.9075066679053836, "needs_review": false}, {"bbox": [[129.0, 779.0], [343.0, 779.0], [343.0, 802.0], [129.0, 802.0]], "text": "【五65】不管怎样说", "confidence": 0.840276225046678, "needs_review": false}, {"bbox": [[224.0, 821.0], [594.0, 821.0], [594.0, 843.0], [224.0, 843.0]], "text": "不管怎样说，你这么做就是不对的。", "confidence": 0.8767854781711802, "needs_review": false}, {"bbox": [[223.0, 861.0], [546.0, 861.0], [546.0, 884.0], [223.0, 884.0]], "text": "不管怎样说，这事总算办成了。", "confidence": 0.8811593413352966, "needs_review": false}, {"bbox": [[130.0, 923.0], [442.0, 923.0], [442.0, 946.0], [130.0, 946.0]], "text": "【五66】看你×的／瞧他X的", "confidence": 0.8533699830373128, "needs_review": false}, {"bbox": [[223.0, 964.0], [524.0, 964.0], [524.0, 986.0], [223.0, 986.0]], "text": "看你说的，我哪有那么能干？", "confidence": 0.8886422898088183, "needs_review": false}, {"bbox": [[223.0, 1000.0], [499.0, 1002.0], [499.0, 1028.0], [223.0, 1026.0]], "text": "甲：他说他这次准考第一。", "confidence": 0.8665934205055237, "needs_review": false}, {"bbox": [[225.0, 1043.0], [377.0, 1043.0], [377.0, 1067.0], [225.0, 1067.0]], "text": "乙：瞧他吹的。", "confidence": 0.8226976245641708, "needs_review": false}, {"bbox": [[128.0, 1103.0], [404.0, 1103.0], [404.0, 1126.0], [128.0, 1126.0]], "text": "【五67】真有你／他／她的", "confidence": 0.8338550754955837, "needs_review": false}, {"bbox": [[222.0, 1141.0], [501.0, 1142.0], [501.0, 1169.0], [222.0, 1168.0]], "text": "真有你的！电脑你也会修？", "confidence": 0.8915852399972769, "needs_review": false}, {"bbox": [[221.0, 1183.0], [622.0, 1184.0], [622.0, 1208.0], [221.0, 1207.0]], "text": "这么难的事情他都有办法，真有他的！", "confidence": 0.9254951775074005, "needs_review": false}, {"bbox": [[127.0, 1242.0], [320.0, 1242.0], [320.0, 1268.0], [127.0, 1268.0]], "text": "【五68】X什么X", "confidence": 0.7503326803445816, "needs_review": false}, {"bbox": [[223.0, 1284.0], [499.0, 1284.0], [499.0, 1307.0], [223.0, 1307.0]], "text": "看什么看，再看就迟到了！", "confidence": 0.8615300701214716,