[{"bbox": [[1069.0, 167.0], [1237.0, 167.0], [1237.0, 187.0], [1069.0, 187.0]], "text": "GF0025—2021", "confidence": 0.8621201490362486, "needs_review": false}, {"bbox": [[161.0, 223.0], [463.0, 223.0], [463.0, 246.0], [161.0, 246.0]], "text": "【七一九143】无所谓×不×", "confidence": 0.8268561363220215, "needs_review": false}, {"bbox": [[318.0, 267.0], [663.0, 267.0], [663.0, 290.0], [318.0, 290.0]], "text": "无所谓好看不好看，我满意就行。", "confidence": 0.8798113539814949, "needs_review": false}, {"bbox": [[318.0, 309.0], [639.0, 309.0], [639.0, 331.0], [318.0, 331.0]], "text": "无所谓贵不贵，质量好就可以。", "confidence": 0.9008665839831035, "needs_review": false}, {"bbox": [[161.0, 371.0], [625.0, 371.0], [625.0, 394.0], [161.0, 394.0]], "text": "【七一九144】要×有／没×，要Y有／没Y", "confidence": 0.8378161571242593, "needs_review": false}, {"bbox": [[318.0, 414.0], [664.0, 414.0], [664.0, 437.0], [318.0, 437.0]], "text": "她要成绩有成绩，要形象有形象。", "confidence": 0.9006054773926735, "needs_review": false}, {"bbox": [[319.0, 456.0], [664.0, 456.0], [664.0, 479.0], [319.0, 479.0]], "text": "他要学历没学历，要胆子没胆子。", "confidence": 0.8967820070683956, "needs_review": false}, {"bbox": [[160.0, 520.0], [294.0, 520.0], [294.0, 547.0], [160.0, 547.0]], "text": "A.7.8句群", "confidence": 0.8701431751251221, "needs_review": false}, {"bbox": [[159.0, 586.0], [384.0, 583.0], [384.0, 610.0], [159.0, 612.0]], "text": "A.7.8.1按形式分类", "confidence": 0.843743636057927, "needs_review": false}, {"bbox": [[161.0, 652.0], [436.0, 652.0], [436.0, 675.0], [161.0, 675.0]], "text": "【七一九145】带关联词语", "confidence": 0.907792649098805, "needs_review": false}, {"bbox": [[364.0, 694.0], [1237.0, 692.0], [1237.0, 718.0], [364.0, 720.0]], "text": "除了记忆能力差之外，我还有其他的缺点，这些缺点在很大程度上使我变得无知。", "confidence": 0.9313004645141395, "needs_review": false}, {"bbox": [[318.0, 735.0], [1238.0, 735.0], [1238.0, 761.0], [318.0, 761.0]], "text": "因为我脑子慢、糊涂，周围环境稍有变化就会看不清楚。因此，即使是十分容易解开的", "confidence": 0.9305572249950507, "needs_review": false}, {"bbox": [[317.0, 780.0], [616.0, 780.0], [616.0, 803.0], [317.0, 803.0]], "text": "谜，我也从不要求自己去解。", "confidence": 0.8553857803344727, "needs_review": false}, {"bbox": [[365.0, 823.0], [1235.0, 823.0], [1235.0, 845.0], [365.0, 845.0]], "text": "您花上几天时间，到处寻找，也可能没有一点儿收获。假如一个上午能找到两三片", "confidence": 0.9355662287892522, "needs_review": false}, {"bbox": [[316.0, 862.0], [1240.0, 862.0], [1240.0, 891.0], [316.0, 891.0]], "text": "化石，那么这个上午就可以说是终生难忘的时刻了。然而，上个月我们竟然有过三次", "confidence": 0.930726192499462, "needs_review": false}, {"bbox": [[320.0, 906.0], [522.0, 906.0], [522.0, 932.0], [320.0, 932.0]], "text": "“终生难忘的时刻”。", "confidence": 0.8482126972892068, "needs_review": false}, {"bbox": [[162.0, 969.0], [460.0, 969.0], [460.0, 992.0], [162.0, 992.0]], "text": "【七一九146】不带关联词语", "confidence": 0.8484547853469848, "needs_review": false}, {"bbox": [[364.0, 1010.0], [955.0, 1011.0], [955.0, 1037.0], [364.0, 1036.0]], "text": "风，更猛了。雪，更大了。我们每前进一步，更艰难了。", "confidence": 0.9190609180010282, "needs_review": false}, {"bbox": [[363.0, 1053.0], [1240.0, 1051.0], [1240.0, 1078.0], [363.0, 1080.0]], "text": "盼望着，东风来了，春天的脚步近了。一切事物都像刚出生的孩子，柔柔的，嫩嫩", "confidence": 0.9198675671139279, "needs_review": false}, {"bbox": [[318.0, 1098.0], [857.0, 1098.0], [857.0, 1120.0], [318.0, 1120.0]], "text": "的。草绿了，花开了，河面上的冰雪也开始融化了。", "confidence": 0.9228154495358467, "needs_review": false}, {"bbox": [[162.0, 1163.0], [383.0, 1163.0], [383.0, 1186.0], [162.0, 1186.0]], "text": "A.7.8.2按意义分类", "confidence": 0.8635654724561251, "needs_review": false}, {"bbox": [[161.0, 1228.0], [1137.0, 1228.0], [1137.0, 1251.0], [161.0, 1251.0]], "text": "【七一九147】联合关系：并列句群、承接句群、递进句群、选择句群、解说句群、总括句群", "confidence": 0.9253561108611351, "needs_review": false}, {"bbox": [[364.0, 1269.0], [1239.0, 1269.0], [1239.0, 1295.0], [364.0, 1295.0]], "text": "在一起一年多了。时间虽然不长，但是哥哥再也没有胃疼得起不来了，那是因为我", "confidence": 0.9164340931016046, "needs_review": false}, {"bbox": [[316.0, 1311.0], [1238.0, 1312.0], [1238.0, 1338.0], [316.0, 1337.0]], "text": "每天早上硬拉他起来吃早饭。我呢，更是体会到了被人悉心照料的感觉。从此我们的生", "confidence": 0.9258115719526242, "needs_review": false}, {"bbox": [[317.0, 1355.0], [753.0, 1355.0], [753.0, 1377.0], [317.0, 1377.0]], "text": "活就多了一份彼此间的牵挂。（承接句群）", "confidence": 0.9020718842744827, "needs_review": false}, {"bbox": [[366.0, 1398.0], [1239.0, 1398.0], [1239.0, 1421.0], [366.0, 1421.0]], "text": "运动场聚集了很多人。来长跑的有大学的音乐系教授、中文系教授，有跳高运动", "confidence": 0.8984551992681291, "needs_review": false}, {"bbox": [[318.0, 1441.0], [1238.0, 1441.0], [1238.0, 1464.0], [318.0, 1464.0]], "text": "员、跳远运动员、游泳运动员、长跑运动员，有那个写了一部小说的作家，还有各个大", "confidence": 0.9426776415262467, "needs_review": false}, {"bbox": [[318.0, 1484.0], [1238.0, 1484.0], [1238.0, 1506.0], [318.0, 1506.0]], "text": "学的大学生。总而言之吧，那时候小小的农场真可谓人才聚集，全省的本事人基本上都", "confidence": 0.916216376500252, "needs_review": false}, {"bbox": [[318.0, 1526.0], [585.0, 1526.0], [585.0, 1549.0], [318.0, 1549.0]], "text": "到这里来了。（总括句群）", "confidence": 0.9092152256232041, "needs_review": false}, {"bbox": [[162.0, 1588.0], [1137.0, 1588.0], [1137.0, 1611.0], [162.0, 1611.0]], "text": "【七一九148】偏正关系：条件句群、因果句群、目的句群、转折句群、假设句群、让步句群", "confidence": 0.9257865284764489, "needs_review": false}, {"bbox": [[366.0, 1630.0], [1236.0, 1630.0], [1236.0, 1653.0], [366.0, 1653.0]], "text": "他们俩正是这样有思想的一对青年。在当时新思想的影响下，他们走上了革命之", "confidence": 0.9013607104619344, "needs_review": false}, {"bbox": [[316.0, 1673.0], [1237.0, 1672.0], [1237.0, 1696.0], [316.0, 1697.0]], "text": "路。不少人热情地歌颂了他们的反抗和爱情，但是鲁迅先生以敏锐的目光看到了这种反", "confidence": 0.9086583822201459, "needs_review": false}, {"bbox": [[317.0, 1715.0], [778.0, 1716.0], [778.0, 1739.0], [317.0, 1738.0]], "text": "抗和爱情中所包含的悲剧因素。（转折句群）", "confidence": 0.9312623427027747, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1215.0, 1786.0], [1215.0, 1809.0], [1179.0, 1809.0]], "text": "253", "confidence": 0.7462643086910248, "needs_review": false}]