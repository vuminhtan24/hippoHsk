[{"bbox": [[1069.0, 167.0], [1237.0, 167.0], [1237.0, 187.0], [1069.0, 187.0]], "text": "GF0025—2021", "confidence": 0.8677482704321543, "needs_review": false}, {"bbox": [[160.0, 222.0], [398.0, 220.0], [398.0, 247.0], [160.0, 249.0]], "text": "【五55】再···也··", "confidence": 0.6682463173682873, "needs_review": false}, {"bbox": [[255.0, 265.0], [531.0, 266.0], [531.0, 289.0], [255.0, 288.0]], "text": "这件事再难也要坚持下去。", "confidence": 0.8546100717324477, "needs_review": false}, {"bbox": [[256.0, 306.0], [531.0, 306.0], [531.0, 328.0], [256.0, 328.0]], "text": "雨下得再大我也要去上班。", "confidence": 0.8789156446090112, "needs_review": false}, {"bbox": [[258.0, 349.0], [502.0, 349.0], [502.0, 369.0], [258.0, 369.0]], "text": "这篇课文再长也要读完。", "confidence": 0.9084226737419764, "needs_review": false}, {"bbox": [[161.0, 411.0], [380.0, 411.0], [380.0, 437.0], [161.0, 437.0]], "text": "A.5.5.2.9多重复句", "confidence": 0.8552236897604806, "needs_review": false}, {"bbox": [[160.0, 476.0], [664.0, 476.0], [664.0, 499.0], [160.0, 499.0]], "text": "【五56】二重复句1：单句+复句；复句+单句", "confidence": 0.9150774245676787, "needs_review": false}, {"bbox": [[256.0, 517.0], [748.0, 517.0], [748.0, 540.0], [256.0, 540.0]], "text": "我决定去中国留学，即使中文再难我也要去学。", "confidence": 0.8872626992789182, "needs_review": false}, {"bbox": [[257.0, 560.0], [917.0, 560.0], [917.0, 582.0], [257.0, 582.0]], "text": "因为生病所以我没去上课，没想到的是老师一下课就来看我了。", "confidence": 0.9410107033006077, "needs_review": false}, {"bbox": [[257.0, 600.0], [1038.0, 600.0], [1038.0, 623.0], [257.0, 623.0]], "text": "她一直不愿意说出真相，虽然我不知道她的真实想法，但我尊重她的选择。", "confidence": 0.936346478321973, "needs_review": false}, {"bbox": [[160.0, 664.0], [364.0, 664.0], [364.0, 690.0], [160.0, 690.0]], "text": "A.5.6强调的方法", "confidence": 0.8260837197303772, "needs_review": false}, {"bbox": [[162.0, 728.0], [540.0, 728.0], [540.0, 751.0], [162.0, 751.0]], "text": "【五57】用“再也不／没”表示强调", "confidence": 0.8905222250355614, "needs_review": false}, {"bbox": [[256.0, 770.0], [652.0, 771.0], [652.0, 794.0], [256.0, 793.0]], "text": "从今天开始，我再也不会出这种错了。", "confidence": 0.879962103234397, "needs_review": false}, {"bbox": [[257.0, 812.0], [482.0, 812.0], [482.0, 835.0], [257.0, 835.0]], "text": "他再也没跟我联系过。", "confidence": 0.8506230115890503, "needs_review": false}, {"bbox": [[256.0, 853.0], [434.0, 853.0], [434.0, 876.0], [256.0, 876.0]], "text": "我再也没见过她。", "confidence": 0.8241638806131151, "needs_review": false}, {"bbox": [[161.0, 914.0], [497.0, 914.0], [497.0, 937.0], [161.0, 937.0]], "text": "【五58】用副词“可”表示强调", "confidence": 0.9275702759623528, "needs_review": false}, {"bbox": [[257.0, 955.0], [486.0, 955.0], [486.0, 980.0], [257.0, 980.0]], "text": "你可来了，急死我了！", "confidence": 0.8044332536784086, "needs_review": false}, {"bbox": [[258.0, 996.0], [701.0, 996.0], [701.0, 1019.0], [258.0, 1019.0]], "text": "你可得注意身体呀，天天睡眠不足可不行！", "confidence": 0.9275945812463761, "needs_review": false}, {"bbox": [[258.0, 1038.0], [486.0, 1038.0], [486.0, 1061.0], [258.0, 1061.0]], "text": "你可不能让大家失望！", "confidence": 0.8069867383350026, "needs_review": false}, {"bbox": [[162.0, 1099.0], [635.0, 1099.0], [635.0, 1122.0], [162.0, 1122.0]], "text": "【五59】用“怎么都/也+不/没”表示强调", "confidence": 0.8339493504979394, "needs_review": false}, {"bbox": [[257.0, 1141.0], [554.0, 1141.0], [554.0, 1164.0], [257.0, 1164.0]], "text": "她怎么都没想到自己会失败。", "confidence": 0.887436466557639, "needs_review": false}, {"bbox": [[256.0, 1180.0], [599.0, 1181.0], [599.0, 1207.0], [256.0, 1206.0]], "text": "他怎么也不会猜到谁要来看望他。", "confidence": 0.930019348859787, "needs_review": false}, {"bbox": [[255.0, 1219.0], [500.0, 1222.0], [500.0, 1248.0], [255.0, 1246.0]], "text": "他的话我怎么都听不懂", "confidence": 0.8285219831900164, "needs_review": false}, {"bbox": [[256.0, 1263.0], [528.0, 1265.0], [528.0, 1289.0], [256.0, 1287.0]], "text": "昨天晚上我怎么也睡不着。", "confidence": 0.8851056144787715, "needs_review": false}, {"bbox": [[159.0, 1328.0], [341.0, 1326.0], [342.0, 1352.0], [160.0, 1355.0]], "text": "A.5.7口语格式", "confidence": 0.7735169470310211, "needs_review": false}, {"bbox": [[162.0, 1393.0], [468.0, 1393.0], [468.0, 1416.0], [162.0, 1416.0]], "text": "【五60】×也不是，Y也不是", "confidence": 0.8376436789830526, "needs_review": false}, {"bbox": [[257.0, 1435.0], [724.0, 1435.0], [724.0, 1458.0], [257.0, 1458.0]], "text": "他这样开玩笑，气得我哭也不是，笑也不是。", "confidence": 0.9162513642084031, "needs_review": false}, {"bbox": [[255.0, 1475.0], [795.0, 1476.0], [794.0, 1498.0], [255.0, 1497.0]], "text": "一看来了这么多人，他紧张得坐也不是，站也不是。", "confidence": 0.9152099167307218, "needs_review": false}, {"bbox": [[254.0, 1516.0], [699.0, 1516.0], [699.0, 1539.0], [254.0, 1539.0]], "text": "走也不是，留也不是，真不知道怎么办好。", "confidence": 0.8856007277965545, "needs_review": false}, {"bbox": [[162.0, 1579.0], [527.0, 1579.0], [527.0, 1602.0], [162.0, 1602.0]], "text": "【五61】X也×不得，Y也Y不得", "confidence": 0.8289547878153184, "needs_review": false}, {"bbox": [[257.0, 1619.0], [724.0, 1619.0], [724.0, 1642.0], [257.0, 1642.0]], "text": "他腰疼起来的时候站也站不得，坐也坐不得。", "confidence": 0.9053160690125965, "needs_review": false}, {"bbox": [[255.0, 1661.0], [653.0, 1661.0], [653.0, 1684.0], [255.0, 1684.0]], "text": "孩子大了，骂也骂不得，打也打不得。", "confidence": 0.8957512246237861, "needs_review": false}, {"bbox": [[256.0, 1703.0], [675.0, 1703.0], [675.0, 1726.0], [256.0, 1726.0]], "text": "这件事愁得他吃也吃不得，睡也睡不得。", "confidence": 0.9210856180442007, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1179.0, 1809.0]], "text": "225", "confidence": 0.7453928589820862, "needs_review": false}]