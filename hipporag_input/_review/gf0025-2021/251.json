[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.7801675338011521, "needs_review": false}, {"bbox": [[162.0, 223.0], [411.0, 223.0], [411.0, 246.0], [162.0, 246.0]], "text": "【七一九078】综上所述", "confidence": 0.8491999461100652, "needs_review": false}, {"bbox": [[317.0, 265.0], [929.0, 265.0], [929.0, 288.0], [317.0, 288.0]], "text": "综上所述，如果希望交流顺利地进行，需要大家共同努力。", "confidence": 0.917972535998733, "needs_review": false}, {"bbox": [[317.0, 307.0], [857.0, 307.0], [857.0, 329.0], [317.0, 329.0]], "text": "综上所述，随着科技的发展，人们越来越依赖手机。", "confidence": 0.8814928109447161, "needs_review": false}, {"bbox": [[162.0, 367.0], [526.0, 367.0], [526.0, 390.0], [162.0, 390.0]], "text": "【七一九079】总的来说／总而言之", "confidence": 0.8661759926213158, "needs_review": false}, {"bbox": [[319.0, 409.0], [688.0, 409.0], [688.0, 432.0], [319.0, 432.0]], "text": "总的来说，他的身体状态还算不错。", "confidence": 0.9088719837805804, "needs_review": false}, {"bbox": [[317.0, 450.0], [1099.0, 451.0], [1099.0, 473.0], [317.0, 472.0]], "text": "她的专业能力很不错，工作态度总的来说也很端正，是个很好的合作伙伴。", "confidence": 0.9143605302361881, "needs_review": false}, {"bbox": [[318.0, 491.0], [808.0, 491.0], [808.0, 514.0], [318.0, 514.0]], "text": "总而言之，最重要的应该是过程，而不是结果。", "confidence": 0.8935797431252219, "needs_review": false}, {"bbox": [[320.0, 535.0], [640.0, 535.0], [640.0, 555.0], [320.0, 555.0]], "text": "总而言之一句话，我不喜欢他。", "confidence": 0.9217469056447347, "needs_review": false}, {"bbox": [[159.0, 595.0], [341.0, 595.0], [341.0, 621.0], [159.0, 621.0]], "text": "A.7.3固定格式", "confidence": 0.7786026418209075, "needs_review": false}, {"bbox": [[160.0, 660.0], [438.0, 659.0], [438.0, 685.0], [160.0, 686.0]], "text": "【七一九080】不知·好", "confidence": 0.8283613599263705, "needs_review": false}, {"bbox": [[318.0, 705.0], [688.0, 705.0], [688.0, 724.0], [318.0, 724.0]], "text": "这件事很复杂，不知如何解决才好。", "confidence": 0.8864253373707042, "needs_review": false}, {"bbox": [[318.0, 744.0], [786.0, 744.0], [786.0, 767.0], [318.0, 767.0]], "text": "看他紧张得手心都是汗，我也不知说什么好。", "confidence": 0.898527375289372, "needs_review": false}, {"bbox": [[160.0, 804.0], [505.0, 801.0], [505.0, 828.0], [160.0, 831.0]], "text": "【七一九081】所谓·就是", "confidence": 0.816391857607024, "needs_review": false}, {"bbox": [[317.0, 845.0], [879.0, 843.0], [879.0, 869.0], [317.0, 871.0]], "text": "房内没有一样值钱的东西，所谓家具就是这几把椅子。", "confidence": 0.9066312503814697, "needs_review": false}, {"bbox": [[318.0, 886.0], [974.0, 886.0], [974.0, 912.0], [318.0, 912.0]], "text": "他所谓的好家庭就是住在一栋大房子里，妻子穿着漂亮的衣服。", "confidence": 0.9226779752764208, "needs_review": false}, {"bbox": [[161.0, 948.0], [753.0, 949.0], [753.0, 972.0], [161.0, 971.0]], "text": "【七一九082】无非／不过／只不过／只是··.而已／罢了", "confidence": 0.8053818047046661, "needs_review": false}, {"bbox": [[317.0, 989.0], [731.0, 988.0], [731.0, 1012.0], [317.0, 1013.0]], "text": "不要相信他，这无非是他的借口罢了。", "confidence": 0.8408560521072812, "needs_review": false}, {"bbox": [[315.0, 1028.0], [799.0, 1028.0], [799.0, 1057.0], [315.0, 1057.0]], "text": "我这么说没有其他意思，不过是想鼓励他而已", "confidence": 0.9499273129871914, "needs_review": false}, {"bbox": [[317.0, 1072.0], [706.0, 1073.0], [706.0, 1097.0], [317.0, 1095.0]], "text": "她会做这道题，只不过假装不会而已", "confidence": 0.8779755690518547, "needs_review": false}, {"bbox": [[318.0, 1114.0], [857.0, 1114.0], [857.0, 1137.0], [318.0, 1137.0]], "text": "大家都说爱情很快就会过去，剩下的只是习惯罢了。", "confidence": 0.9150582129756609, "needs_review": false}, {"bbox": [[160.0, 1174.0], [440.0, 1172.0], [440.0, 1198.0], [160.0, 1200.0]], "text": "【七一九083】以···为·", "confidence": 0.7113734980424246, "needs_review": false}, {"bbox": [[318.0, 1216.0], [785.0, 1216.0], [785.0, 1241.0], [318.0, 1241.0]], "text": "我们不能以自已为中心，要考虑别人的感受。", "confidence": 0.8886909697737012, "needs_review": false}, {"bbox": [[317.0, 1256.0], [688.0, 1256.0], [688.0, 1282.0], [317.0, 1282.0]], "text": "她以和平为主题，创作了一部小说。", "confidence": 0.8526440069955938, "needs_review": false}, {"bbox": [[160.0, 1318.0], [437.0, 1318.0], [437.0, 1341.0], [160.0, 1341.0]], "text": "七一九084因·····而.·", "confidence": 0.704127224162221, "needs_review": false}, {"bbox": [[318.0, 1360.0], [737.0, 1360.0], [737.0, 1383.0], [318.0, 1383.0]], "text": "我经常看到他因一件小事而快乐的场景。", "confidence": 0.8868595706789117, "needs_review": false}, {"bbox": [[318.0, 1402.0], [785.0, 1402.0], [785.0, 1425.0], [318.0, 1425.0]], "text": "她胆子很大，不会因一些奇怪的声音而害怕。", "confidence": 0.899088652361007, "needs_review": false}, {"bbox": [[161.0, 1466.0], [234.0, 1466.0], [234.0, 1489.0], [161.0, 1489.0]], "text": "A.7.4", "confidence": 0.8205264806747437, "needs_review": false}, {"bbox": [[237.0, 1466.0], [339.0, 1466.0], [339.0, 1489.0], [237.0, 1489.0]], "text": "句子成分", "confidence": 0.73981271982193, "needs_review": false}, {"bbox": [[161.0, 1530.0], [262.0, 1530.0], [262.0, 1554.0], [161.0, 1554.0]], "text": "A.7.4.1", "confidence": 0.8516719043254852, "needs_review": false}, {"bbox": [[251.0, 1527.0], [314.0, 1527.0], [314.0, 1555.0], [251.0, 1555.0]], "text": "宾语", "confidence": 0.5806734164555868, "needs_review": false}, {"bbox": [[161.0, 1595.0], [506.0, 1595.0], [506.0, 1617.0], [161.0, 1617.0]], "text": "【七一九085】宾语的语义类型3", "confidence": 0.9007360479410957, "needs_review": false}, {"bbox": [[266.0, 1635.0], [412.0, 1635.0], [412.0, 1659.0], [266.0, 1659.0]], "text": "（1）方式宾语", "confidence": 0.8645926937460899, "needs_review": false}, {"bbox": [[317.0, 1676.0], [710.0, 1676.0], [710.0, 1699.0], [317.0, 1699.0]], "text": "为了方便取出来，他把钱存了个活期。", "confidence": 0.896710024939643, "needs_review": false}, {"bbox": [[317.0, 1716.0], [702.0, 1714.0], [702.0, 1737.0], [317.0, 1739.0]], "text": "为了节省时间，这封信还是寄航空吧", "confidence": 0.8944156836060917, "needs_review": false}, {"bbox": [[1178.0, 1786.0], [1216.0, 1786.0], [1216.0, 1809.0], [1178.0, 1809.0]], "text": "245", "confidence": 0.6380736529827118, "needs_review": false}]