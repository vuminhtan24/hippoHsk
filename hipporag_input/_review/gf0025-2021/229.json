[{"bbox": [[1068.0, 165.0], [1238.0, 165.0], [1238.0, 188.0], [1068.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.8195252693616427, "needs_review": false}, {"bbox": [[161.0, 223.0], [348.0, 223.0], [348.0, 246.0], [161.0, 246.0]], "text": "【五42】兼语句3", "confidence": 0.8793517529964447, "needs_review": false}, {"bbox": [[257.0, 263.0], [825.0, 263.0], [825.0, 286.0], [257.0, 286.0]], "text": "表致使：主语+叫/令／使/让+人称代词+动词短语", "confidence": 0.8582943248748779, "needs_review": false}, {"bbox": [[256.0, 302.0], [483.0, 302.0], [483.0, 324.0], [256.0, 324.0]], "text": "老师叫她早点儿回去。", "confidence": 0.8801796165379611, "needs_review": false}, {"bbox": [[256.0, 342.0], [484.0, 342.0], [484.0, 365.0], [256.0, 365.0]], "text": "这件事令她吃不下饭。", "confidence": 0.867044985294342, "needs_review": false}, {"bbox": [[257.0, 382.0], [625.0, 382.0], [625.0, 405.0], [257.0, 405.0]], "text": "他的做法使大家再也不敢相信他了。", "confidence": 0.9315511444035698, "needs_review": false}, {"bbox": [[256.0, 420.0], [531.0, 421.0], [531.0, 445.0], [256.0, 444.0]], "text": "明天的考试让我睡不着觉。", "confidence": 0.8193365931510925, "needs_review": false}, {"bbox": [[162.0, 480.0], [348.0, 480.0], [348.0, 503.0], [162.0, 503.0]], "text": "【五43】比较句5", "confidence": 0.8320955455303192, "needs_review": false}, {"bbox": [[206.0, 520.0], [377.0, 520.0], [377.0, 543.0], [206.0, 543.0]], "text": "（1）跟···相比", "confidence": 0.7551301211118698, "needs_review": false}, {"bbox": [[256.0, 560.0], [627.0, 560.0], [627.0, 582.0], [256.0, 582.0]], "text": "跟上次考试相比，这次没有那么难。", "confidence": 0.8838334714665133, "needs_review": false}, {"bbox": [[256.0, 599.0], [602.0, 599.0], [602.0, 622.0], [256.0, 622.0]], "text": "跟别人相比，我的想法太简单了。", "confidence": 0.8383605293929577, "needs_review": false}, {"bbox": [[255.0, 639.0], [677.0, 639.0], [677.0, 662.0], [255.0, 662.0]], "text": "跟语法知识相比，我觉得语音知识更难。", "confidence": 0.906363822911915, "needs_review": false}, {"bbox": [[208.0, 680.0], [538.0, 680.0], [538.0, 700.0], [208.0, 700.0]], "text": "（2）A+形容词+B+数量补语", "confidence": 0.8386065885424614, "needs_review": false}, {"bbox": [[257.0, 717.0], [411.0, 717.0], [411.0, 741.0], [257.0, 741.0]], "text": "她高我五厘米。", "confidence": 0.8717367723584175, "needs_review": false}, {"bbox": [[257.0, 757.0], [411.0, 757.0], [411.0, 781.0], [257.0, 781.0]], "text": "他早我十分钟。", "confidence": 0.8732162937521935, "needs_review": false}, {"bbox": [[256.0, 797.0], [411.0, 797.0], [411.0, 820.0], [256.0, 820.0]], "text": "姐姐大我十岁。", "confidence": 0.8357710912823677, "needs_review": false}, {"bbox": [[160.0, 857.0], [314.0, 857.0], [314.0, 884.0], [160.0, 884.0]], "text": "A.5.5.2复句", "confidence": 0.8899793744087219, "needs_review": false}, {"bbox": [[160.0, 921.0], [380.0, 921.0], [380.0, 947.0], [160.0, 947.0]], "text": "A.5.5.2.1选择复句", "confidence": 0.8999809537615094, "needs_review": false}, {"bbox": [[160.0, 982.0], [468.0, 982.0], [468.0, 1008.0], [160.0, 1008.0]], "text": "【五44】或是·，或是…··", "confidence": 0.7354602833588918, "needs_review": false}, {"bbox": [[254.0, 1021.0], [647.0, 1022.0], [647.0, 1048.0], [254.0, 1047.0]], "text": "这件事或是哥哥做的，或是弟弟做的。", "confidence": 0.8959060311317444, "needs_review": false}, {"bbox": [[256.0, 1061.0], [771.0, 1062.0], [771.0, 1088.0], [256.0, 1087.0]], "text": "你或是参加这次考试，或是明年再学一遍这门课。", "confidence": 0.8921999309373938, "needs_review": false}, {"bbox": [[160.0, 1124.0], [380.0, 1124.0], [380.0, 1150.0], [160.0, 1150.0]], "text": "A.5.5.2.2转折复句", "confidence": 0.9085125241960798, "needs_review": false}, {"bbox": [[160.0, 1187.0], [522.0, 1187.0], [522.0, 1213.0], [160.0, 1213.0]], "text": "【五45】尽管·，但是／可是·", "confidence": 0.7607033681124449, "needs_review": false}, {"bbox": [[256.0, 1225.0], [702.0, 1228.0], [702.0, 1252.0], [256.0, 1250.0]], "text": "尽管这次考试很难，但是很多人都通过了。", "confidence": 0.9178922981023788, "needs_review": false}, {"bbox": [[258.0, 1267.0], [749.0, 1267.0], [749.0, 1290.0], [258.0, 1290.0]], "text": "尽管外面在下雨，可是他一定要去超市买东西。", "confidence": 0.9068298448215831, "needs_review": false}, {"bbox": [[255.0, 1304.0], [821.0, 1305.0], [821.0, 1331.0], [255.0, 1330.0]], "text": "尽管他不接受我的意见，可是我有意见还是要向他提。", "confidence": 0.9331674432754516, "needs_review": false}, {"bbox": [[161.0, 1367.0], [379.0, 1367.0], [379.0, 1393.0], [161.0, 1393.0]], "text": "A.5.5.2.3假设复句", "confidence": 0.8781154411179679, "needs_review": false}, {"bbox": [[159.0, 1429.0], [448.0, 1426.0], [448.0, 1456.0], [160.0, 1459.0]], "text": "【五46】一旦·，就..", "confidence": 0.628123572239509, "needs_review": false}, {"bbox": [[259.0, 1470.0], [651.0, 1471.0], [651.0, 1494.0], [259.0, 1493.0]], "text": "一旦考试不及格，我就要延期毕业了。", "confidence": 0.9024811387062073, "needs_review": false}, {"bbox": [[258.0, 1507.0], [700.0, 1509.0], [700.0, 1535.0], [258.0, 1533.0]], "text": "一旦地铁建成，堵车的情况就可大大缓解。", "confidence": 0.9229977279901505, "needs_review": false}, {"bbox": [[258.0, 1550.0], [625.0, 1550.0], [625.0, 1573.0], [258.0, 1573.0]], "text": "中文一旦学起来，就再也放不下了。", "confidence": 0.8428844388793496, "needs_review": false}, {"bbox": [[159.0, 1606.0], [603.0, 1606.0], [603.0, 1634.0], [159.0, 1634.0]], "text": "【五47】要是·，（就）····，否则…··", "confidence": 0.6979101209536843, "needs_review": false}, {"bbox": [[258.0, 1650.0], [818.0, 1650.0], [818.0, 1670.0], [258.0, 1670.0]], "text": "要是他不去，我也不去了，否则我一个人去太危险了。", "confidence": 0.8918458342552185, "needs_review": false}, {"bbox": [[257.0, 1688.0], [821.0, 1688.0], [821.0, 1711.0], [257.0, 1711.0]], "text": "要是明天下雨，我们就不去爬山了，否则会冻感冒的。", "confidence": 0.9096439218521118, "needs_review": false}, {"bbox": [[257.0, 1728.0], [820.0, 1728.0], [820.0, 1750.0], [257.0, 1750.0]], "text": "要是你不带包，我就带一个，否则买的东西没地方放。", "confidence": 0.9044191932678223, "needs_review": false}, {"bbox": [[1179.0, 1786.0], [1215.0, 1786.0], [1215.0, 1809.0], [1179.0, 1809.0]], "text": "223", "confidence": 0.7446580827236176, "needs_review": false}]