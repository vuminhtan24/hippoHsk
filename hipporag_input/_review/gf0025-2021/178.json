[{"bbox": [[130.0, 165.0], [300.0, 165.0], [300.0, 188.0], [130.0, 188.0]], "text": "GF 0025—2021", "confidence": 0.8171546138249911, "needs_review": false}, {"bbox": [[127.0, 221.0], [622.0, 221.0], [622.0, 247.0], [127.0, 247.0]], "text": "【一10】范围、协同副词：都1、一块儿、一起", "confidence": 0.9166114511697189, "needs_review": false}, {"bbox": [[224.0, 262.0], [403.0, 262.0], [403.0, 288.0], [224.0, 288.0]], "text": "同学们都很认真。", "confidence": 0.8789844314257304, "needs_review": false}, {"bbox": [[223.0, 302.0], [424.0, 302.0], [424.0, 324.0], [223.0, 324.0]], "text": "我们常一块儿玩儿。", "confidence": 0.883591604232788, "needs_review": false}, {"bbox": [[223.0, 337.0], [475.0, 338.0], [475.0, 364.0], [223.0, 363.0]], "text": "明天他们一起去图书馆。", "confidence": 0.8519912908474604, "needs_review": false}, {"bbox": [[129.0, 399.0], [682.0, 399.0], [682.0, 422.0], [129.0, 422.0]], "text": "【一11】时间副词：马上、先、有时、在、正、正在", "confidence": 0.8928825354576111, "needs_review": false}, {"bbox": [[224.0, 437.0], [355.0, 437.0], [355.0, 460.0], [224.0, 460.0]], "text": "医生马上来。", "confidence": 0.8235898954527718, "needs_review": false}, {"bbox": [[222.0, 474.0], [401.0, 472.0], [401.0, 499.0], [222.0, 501.0]], "text": "老师，我先说吧。", "confidence": 0.8528922001520792, "needs_review": false}, {"bbox": [[223.0, 513.0], [403.0, 513.0], [403.0, 539.0], [223.0, 539.0]], "text": "他有时晚上上课。", "confidence": 0.8870424694485135, "needs_review": false}, {"bbox": [[223.0, 553.0], [376.0, 553.0], [376.0, 577.0], [223.0, 577.0]], "text": "我在看电视呢。", "confidence": 0.8540792912244797, "needs_review": false}, {"bbox": [[224.0, 591.0], [498.0, 591.0], [498.0, 614.0], [224.0, 614.0]], "text": "你等一下儿，他正吃饭呢。", "confidence": 0.8599497217398423, "needs_review": false}, {"bbox": [[224.0, 630.0], [378.0, 630.0], [378.0, 654.0], [224.0, 654.0]], "text": "他们正在唱歌。", "confidence": 0.8678163141012192, "needs_review": false}, {"bbox": [[127.0, 688.0], [576.0, 686.0], [577.0, 711.0], [128.0, 714.0]], "text": "【一12】频率、重复副词：常、常常、再1", "confidence": 0.9384230063075111, "needs_review": false}, {"bbox": [[223.0, 725.0], [403.0, 725.0], [403.0, 751.0], [223.0, 751.0]], "text": "他常去饭店吃饭。", "confidence": 0.8734955522749159, "needs_review": false}, {"bbox": [[222.0, 764.0], [403.0, 764.0], [403.0, 790.0], [222.0, 790.0]], "text": "她常常不吃早饭。", "confidence": 0.8155659039815267, "needs_review": false}, {"bbox": [[223.0, 803.0], [662.0, 804.0], [662.0, 828.0], [223.0, 827.0]], "text": "今天的电影太好看了，我们明天再去看吧。", "confidence": 0.8910237073898315, "needs_review": false}, {"bbox": [[129.0, 862.0], [429.0, 862.0], [429.0, 885.0], [129.0, 885.0]], "text": "【一13】关联副词：还1、也", "confidence": 0.88332124153773, "needs_review": false}, {"bbox": [[222.0, 899.0], [500.0, 900.0], [500.0, 926.0], [222.0, 925.0]], "text": "他要去上海，还要去北京。", "confidence": 0.848274840758397, "needs_review": false}, {"bbox": [[225.0, 940.0], [474.0, 940.0], [474.0, 963.0], [225.0, 963.0]], "text": "他是学生，我也是学生。", "confidence": 0.8286422441403071, "needs_review": false}, {"bbox": [[127.0, 995.0], [540.0, 997.0], [540.0, 1023.0], [126.0, 1021.0]], "text": "【一14】否定副词：别、不、没、没有", "confidence": 0.9009723192767093, "needs_review": false}, {"bbox": [[222.0, 1035.0], [333.0, 1035.0], [333.0, 1062.0], [222.0, 1062.0]], "text": "你别进来。", "confidence": 0.751647929350535, "needs_review": false}, {"bbox": [[222.0, 1074.0], [331.0, 1074.0], [331.0, 1100.0], [222.0, 1100.0]], "text": "今天不热。", "confidence": 0.6773210267225901, "needs_review": false}, {"bbox": [[224.0, 1113.0], [376.0, 1113.0], [376.0, 1137.0], [224.0, 1137.0]], "text": "他昨天没上课。", "confidence": 0.8301159366965294, "needs_review": false}, {"bbox": [[221.0, 1151.0], [424.0, 1149.0], [424.0, 1176.0], [221.0, 1178.0]], "text": "我今天没有吃早饭。", "confidence": 0.8626321911811828, "needs_review": false}, {"bbox": [[127.0, 1214.0], [210.0, 1211.0], [210.0, 1236.0], [128.0, 1239.0]], "text": "A.1.1.7", "confidence": 0.8509213775396347, "needs_review": false}, {"bbox": [[227.0, 1213.0], [280.0, 1213.0], [280.0, 1238.0], [227.0, 1238.0]], "